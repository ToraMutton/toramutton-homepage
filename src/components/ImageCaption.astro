---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ARTICLE_IMAGE_WIDTHS, ARTICLE_IMAGE_SIZES } from '../utils/rehype-responsive-images.mjs';

interface Props {
  src: ImageMetadata | Promise<{ default: ImageMetadata }>;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
const resolvedSrc = await src;
const image = 'default' in resolvedSrc ? resolvedSrc.default : resolvedSrc;
---

<figure class="image-caption-container">
  <Image
    src={image}
    alt={alt}
    width={Math.min(720, image.width)}
    widths={ARTICLE_IMAGE_WIDTHS}
    sizes={ARTICLE_IMAGE_SIZES}
  />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .image-caption-container {
    margin: 2rem 0;
    text-align: center;
  }
  /* 本文の画像と同じ: 影なし・1px 枠・4px 角丸 */
  img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border-color);
  }
  figcaption {
    margin-top: 0.6rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
