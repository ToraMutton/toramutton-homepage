---
// 記事ページ内のサムネイル(16:10)。画像のない記事は、共通の格子タイル(ui/SourceTile.astro)。
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SourceTile from "../ui/SourceTile.astro";

interface Props {
    image?: ImageMetadata;
}
const { image } = Astro.props;
---

<span class="thumb" aria-hidden="true">
    {
        image ? (
            <Image src={image} alt="" width={320} height={200} fit="cover" loading="lazy" />
        ) : (
            <SourceTile source="local" />
        )
    }
</span>

<style>
    .thumb {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg-deep);
    }

    .thumb :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 0;
        object-fit: cover;
    }
</style>
