---
// おすすめ記事(目次の下。狭い画面では本文の後)。
// PC では目次と一緒に画面に張り付くので、画面の高さに入りきらない分は下から隠す(BlogPost.astro のスクリプト)。
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../FormattedDate.astro";
import PostThumb from "./PostThumb.astro";

interface Props {
    posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props;
---

{
    posts.length > 0 && (
        <section class="recommend" data-recommend>
            <h2>おすすめ記事</h2>
            <ul>
                {posts.map((post) => (
                    <li data-recommend-item>
                        <a href={`/blog/${post.id}/`}>
                            <PostThumb image={post.data.heroImage} />
                            <span class="text">
                                <span class="title">{post.data.title}</span>
                                <span class="date">
                                    <FormattedDate date={post.data.pubDate} />
                                </span>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </section>
    )
}

<style>
    .recommend {
        padding: 0.9rem 1rem 0.4rem;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--card);
    }

    .recommend[hidden],
    li[hidden] {
        display: none;
    }

    h2 {
        margin: 0 0 0.25rem;
        color: var(--text-muted);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
    }

    ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li + li {
        border-top: 1px solid var(--border);
    }

    a {
        display: grid;
        grid-template-columns: 5.25rem minmax(0, 1fr);
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0;
        color: var(--text);
        text-decoration: none;
    }

    .text {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .title {
        display: -webkit-box;
        overflow: hidden;
        font-size: 0.8rem;
        font-weight: 600;
        line-height: 1.5;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        transition: color 0.2s ease;
    }

    .date {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.66rem;
    }

    @media (hover: hover) {
        a:hover .title {
            color: var(--accent);
        }
    }
</style>
