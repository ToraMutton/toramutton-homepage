---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowUpRight, BookOpen, Lock } from "lucide-astro";
import { adventCalendar, type AdventSource } from "../data/advent2026";

interface Props {
    status: "locked" | "open";
    url?: string;
    title?: string;
    image?: ImageMetadata | string;
    source?: AdventSource;
    sublabel?: string;
    label: string | number;
    special?: boolean;
}

const {
    status,
    url,
    title,
    image,
    source,
    sublabel,
    label,
    special = false,
} = Astro.props;
const clickable = status === "open" && Boolean(url);
const isExternal =
    clickable && (source ? source !== "local" : /^https?:\/\//.test(url ?? ""));
const Tag = clickable ? "a" : "div";
const sourceLabels: Record<AdventSource, string> = {
    local: "Blog",
    zenn: "Zenn",
    note: "note",
    qiita: "Qiita",
};
const displayTitle = clickable
    ? title || "記事を読む"
    : "公開待ち";
const displayLabel =
    typeof label === "number" ? String(label).padStart(2, "0") : label;
const dateLabel =
    typeof label === "number"
        ? `12月${label}日`
        : label === "Begin"
          ? "はじまり"
          : "おわり";
---

<Tag
    href={clickable ? url : undefined}
    class:list={[
        "day-card",
        clickable ? "open" : "locked",
        { special, clickable },
    ]}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    role={clickable ? undefined : "group"}
    aria-label={`${dateLabel}：${displayTitle}${isExternal ? "（新しいタブで開く）" : ""}`}
>
    <div class="day-top">
        <div class="day-date">
            <span class="day-label">{sublabel}</span>
            {
                typeof label === "number" ? (
                    <time
                        class="day-number"
                        datetime={`${adventCalendar.year}-12-${displayLabel}`}
                    >
                        {displayLabel}
                    </time>
                ) : (
                    <span class="day-number">{displayLabel}</span>
                )
            }
        </div>
        <span class="day-status" aria-hidden="true"
            >{
                clickable ? <BookOpen size={15} /> : <Lock size={13} />
            }</span
        >
    </div>
    {
        clickable && (
            <div class="day-thumbnail" aria-hidden="true">
                {typeof image === "object" && image ? (
                    <Image
                        src={image}
                        alt=""
                        width={240}
                        height={135}
                        loading="lazy"
                    />
                ) : typeof image === "string" && image ? (
                    <img
                        src={image}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        width="240"
                        height="135"
                    />
                ) : (
                    <BookOpen size={22} />
                )}
            </div>
        )
    }
    <div class="day-body">
        {
            (special || clickable) && (
                <span class="day-title">
                    {special && !clickable ? dateLabel : displayTitle}
                </span>
            )
        }
        <span class="day-meta">
            {
                clickable ? (
                    <>
                        <>
                            <span>
                                {source ? sourceLabels[source] : "記事を読む"}
                            </span>
                            <ArrowUpRight size={12} aria-hidden="true" />
                        </>
                    </>
                ) : (
                    <span>COMING SOON</span>
                )
            }
        </span>
    </div>
    <span class="accent-sweep" aria-hidden="true"></span>
</Tag>

<style>
    .day-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        height: 100%;
        min-height: 158px;
        padding: 0.8rem;
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        background: var(--surface);
        color: var(--text-main);
        text-decoration: none;
        overflow: hidden;
        isolation: isolate;
        transition:
            border-color 0.25s ease,
            background 0.25s ease,
            transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .day-card > :not(.accent-sweep) {
        position: relative;
        z-index: 1;
    }

    .day-card.locked {
        background: var(--background);
    }

    .day-top {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 0.3rem;
    }

    .day-date {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font-family: var(--font-mono);
    }

    .day-label {
        font-size: 0.55rem;
        letter-spacing: 0.1em;
        color: var(--text-muted);
    }

    .day-number {
        font-size: 1.8rem;
        line-height: 1;
        font-weight: 500;
        letter-spacing: -0.06em;
        font-variant-numeric: tabular-nums;
    }

    .locked .day-number {
        color: var(--text-muted);
    }

    .day-status {
        display: flex;
        margin-top: 0.15rem;
        color: var(--text-muted);
    }

    .open .day-status,
    .clickable .day-number {
        color: var(--accent-blue);
    }

    .day-body {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        flex: 1;
    }

    .day-title {
        display: block;
        font-size: 0.72rem;
        line-height: 1.65;
        overflow-wrap: anywhere;
    }

    .locked .day-title {
        font-size: 0.65rem;
        color: var(--text-muted);
    }

    .day-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.25rem;
        margin-top: auto;
        padding-top: 0.45rem;
        border-top: 1px solid var(--border-color);
        font-family: var(--font-mono);
        font-size: 0.55rem;
        letter-spacing: 0.035em;
        color: var(--text-muted);
    }

    .clickable .day-meta {
        color: var(--accent-blue);
    }

    .day-thumbnail {
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 16 / 9;
        margin: -0.15rem 0;
        overflow: hidden;
        border-radius: 2px;
        color: var(--accent-blue);
        background: var(--elevated);
    }

    .day-thumbnail :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 0;
        box-shadow: none;
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .accent-sweep {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: linear-gradient(
            110deg,
            transparent 20%,
            color-mix(in srgb, var(--accent-blue) 8%, transparent) 50%,
            transparent 80%
        );
        transform: translateX(-110%);
        transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .clickable:focus-visible {
        outline: 2px solid var(--accent-blue);
        outline-offset: 3px;
        border-color: var(--accent-blue);
    }

    .clickable:focus-visible .accent-sweep {
        transform: translateX(0);
    }

    .special {
        flex-direction: row;
        align-items: center;
        gap: 1.4rem;
        padding: 1rem 1.2rem;
        min-height: 0;
    }

    .special .day-top {
        align-items: center;
        gap: 1.3rem;
        min-width: 130px;
    }

    .special .day-date {
        gap: 0.35rem;
    }

    .special .day-number {
        font-size: 1.05rem;
        letter-spacing: -0.02em;
    }

    .special .day-body {
        flex-direction: row;
        align-items: center;
        gap: 1rem;
    }

    .special .day-title {
        font-size: 0.75rem;
    }

    .special .day-meta {
        flex-shrink: 0;
        margin-top: 0;
        margin-left: auto;
        border-top: 0;
        padding-top: 0;
        gap: 0.6rem;
        font-size: 0.56rem;
    }

    .special .day-thumbnail {
        width: 90px;
        flex-shrink: 0;
    }

    @media (hover: hover) {
        .clickable:hover {
            transform: translateY(-3px);
            border-color: var(--accent-blue);
        }

        .clickable:hover .accent-sweep {
            transform: translateX(0);
        }

        .clickable:hover .day-thumbnail :global(img) {
            transform: scale(1.06);
        }
    }

    @media (max-width: 720px) {
        .day-card:not(.special) {
            flex-direction: row;
            align-items: center;
            gap: 1rem;
            min-height: 86px;
            padding: 0.95rem 0.25rem;
            border: 0;
            border-bottom: 1px solid var(--border-color);
            border-radius: 0;
            background: transparent;
        }

        .day-top {
            align-items: center;
            flex-shrink: 0;
            gap: 0.85rem;
        }

        .day-date {
            min-width: 35px;
        }

        .day-number {
            font-size: 1.65rem;
        }

        .day-label {
            font-size: 0.52rem;
        }

        .day-body {
            gap: 0.3rem;
        }

        .day-title,
        .locked .day-title {
            font-size: 0.78rem;
        }

        .day-meta {
            border-top: 0;
            padding-top: 0;
            font-size: 0.55rem;
        }

        .day-thumbnail {
            flex-shrink: 0;
            width: 80px;
        }

        .special {
            padding: 0.9rem;
            gap: 1rem;
        }

        .special .day-top {
            min-width: 0;
            gap: 0.8rem;
        }

        .special .day-body {
            flex-direction: column;
            align-items: start;
            gap: 0.3rem;
        }

        .special .day-meta {
            margin-left: 0;
        }

        .special .day-title {
            font-size: 0.72rem;
        }
    }

    @media (max-width: 380px) {
        .day-card:not(.special) {
            gap: 0.65rem;
        }

        .day-top {
            gap: 0.5rem;
        }

        .day-thumbnail {
            width: 60px;
        }

        .special .day-thumbnail {
            width: 50px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .day-card,
        .accent-sweep,
        .day-thumbnail :global(img) {
            transition: none;
        }

        .clickable:hover,
        .clickable:hover .day-thumbnail :global(img) {
            transform: none;
        }
    }
</style>
