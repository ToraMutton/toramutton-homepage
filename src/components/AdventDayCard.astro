---
// src/components/AdventDayCard.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Lock, Unlock } from "lucide-astro";
import type { AdventSource } from "../data/advent2026";

interface Props {
    /** "locked" なら見た目もロック状態。"open" なら見た目はアンロック */
    status: "locked" | "open";
    /** リンク先。無ければ open でもクリック不可(バナー扱い) */
    url?: string;
    /** 公開用タイトル。clickableなときのみ表示 */
    title?: string;
    /** ImageMetadata(ローカル画像) か 文字列URL(OGP画像) */
    image?: ImageMetadata | string;
    source?: AdventSource;
    /** カード上部に出す小さいラベル。通常日は "Dec"、番外編は "EXTRA" */
    sublabel?: string;
    /** メインラベル。通常日は日付の数字、番外編は "Begin" / "Finish" */
    label: string | number;
    /** PC 7列グリッドでの配置列(1〜7)。番外編では指定しない */
    gridColumn?: number;
    /** 番外編(Begin・Finish)かどうか。true だとカレンダーとは別枠の横長バー表示になる */
    special?: boolean;
    /** open時のアイコンを差し替えたい場合(番外編用。例: Rocket, Milestone) */
    openIcon?: any;
}

const {
    status,
    url,
    title,
    image,
    source,
    sublabel,
    label,
    gridColumn,
    special = false,
    openIcon,
} = Astro.props as Props;

// クリック可能なのは「open かつ リンク先がある」ときだけ
const clickable = status === "open" && Boolean(url);
const isExternal = clickable && source && source !== "local";

const OpenIcon = openIcon ?? Unlock;
const iconSize = special ? 26 : 20;
---

<a
    href={clickable ? url : undefined}
    class={`day-card ${status} ${special ? "special" : ""} ${
        status === "open" && !clickable ? "no-link" : ""
    }`}
    style={gridColumn ? `grid-column: ${gridColumn};` : undefined}
    tabindex={clickable ? 0 : -1}
    aria-disabled={clickable ? "false" : "true"}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
>
    <!-- === PC表示: 最小限のカード === -->
    <div class="day-card-inner">
        <div class="day-number">
            {sublabel && <span class="day-label">{sublabel}</span>}
            <span class="day-val">{label}</span>
        </div>
        <div class="day-content">
            {
                status === "locked" ? (
                    <Lock size={iconSize} class="icon-locked" />
                ) : (
                    <OpenIcon size={iconSize} class="icon-open" />
                )
            }
        </div>
        <div class="accent-sweep"></div>
    </div>

    <!-- === PC表示: ホバー/フォーカスで出るサムネポップアップ(clickableのときだけ) === -->
    {
        clickable && (
            <div class="day-popup">
                <div class="day-popup-thumb">
                    {typeof image === "object" && image ? (
                        <Image src={image} alt="" width={320} height={180} />
                    ) : typeof image === "string" && image ? (
                        <img src={image} alt="" loading="lazy" />
                    ) : (
                        <div class="day-popup-noimg">No Image</div>
                    )}
                </div>
                {title && <p class="day-popup-title">{title}</p>}
            </div>
        )
    }

    <!-- === スマホ表示: サムネ埋め込みの1行リスト === -->
    <div class={`day-row-mobile ${special ? "special" : ""}`}>
        <div class="day-row-thumb">
            {
                status === "locked" ? (
                    <Lock size={18} class="icon-locked" />
                ) : typeof image === "object" && image ? (
                    <Image src={image} alt="" width={160} height={90} />
                ) : typeof image === "string" && image ? (
                    <img src={image} alt="" loading="lazy" />
                ) : (
                    <OpenIcon size={18} class="icon-open" />
                )
            }
        </div>
        <div class="day-row-main">
            <span class="day-row-date">
                {sublabel ? `${sublabel} ${label}` : label}
            </span>
            <span class="day-row-title">
                {clickable ? title : "Coming soon..."}
            </span>
        </div>
        {
            status === "locked" ? (
                <Lock size={16} class="icon-locked" />
            ) : (
                <OpenIcon size={16} class="icon-open" />
            )
        }
    </div>
</a>

<style>
    /* =========================================
       共通: カード外枠(リンク領域 = ポップアップ表示の基準位置)
       ========================================= */
    .day-card {
        display: block;
        position: relative;
        text-decoration: none;
        outline: none;
        /* ポップアップがはみ出せるよう overflow は visible のまま */
    }

    .day-card.locked,
    .day-card.no-link {
        cursor: not-allowed;
    }

    .day-card.open:not(.no-link) {
        cursor: pointer;
    }

    /* =========================================
       PC表示: カード本体
       ========================================= */
    .day-card-inner {
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--border-color);
        border-radius: 4px;
        padding: 1.2rem 1rem;
        position: relative;
        overflow: hidden;
        height: 100%;
        transition:
            border-color 0.3s ease,
            opacity 0.3s ease;
    }

    .accent-sweep {
        content: "";
        position: absolute;
        inset: -2px -45%;
        background: color-mix(in srgb, var(--accent-blue) 18%, transparent);
        transform: translateX(-135%) skewX(-14deg);
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        z-index: 0;
        pointer-events: none;
    }

    /* --- locked --- */
    .day-card.locked .day-card-inner {
        opacity: 0.6;
        background: repeating-linear-gradient(
            45deg,
            transparent,
            transparent 10px,
            rgba(0, 0, 0, 0.03) 10px,
            rgba(0, 0, 0, 0.03) 20px
        );
    }

    :global(html.dark) .day-card.locked .day-card-inner {
        background: repeating-linear-gradient(
            45deg,
            transparent,
            transparent 10px,
            rgba(255, 255, 255, 0.02) 10px,
            rgba(255, 255, 255, 0.02) 20px
        );
    }

    /* --- open --- */
    .day-card.open:not(.no-link):focus-visible .day-card-inner {
        border-color: var(--accent-blue);
    }
    .day-card.open:not(.no-link):focus-visible .accent-sweep {
        transform: translateX(0) skewX(-14deg);
    }

    @media (hover: hover) {
        .day-card.open:not(.no-link):hover .day-card-inner {
            border-color: var(--accent-blue);
        }
        .day-card.open:not(.no-link):hover .accent-sweep {
            transform: translateX(0) skewX(-14deg);
        }
        .day-card.open:hover .icon-open {
            transform: scale(1.1);
        }
    }

    /* open だがリンク先が無い(番外編の開始バナーなど) */
    .day-card.no-link .day-card-inner {
        border-style: dashed;
        border-color: var(--accent-blue);
    }

    /* === カード内コンテンツ === */
    .day-number,
    .day-content {
        position: relative;
        z-index: 1;
    }

    .day-number {
        display: flex;
        align-items: baseline;
        gap: 0.3rem;
        margin-bottom: 1.2rem;
        font-family: var(--font-mono, "JetBrains Mono", monospace);
        color: var(--text-muted);
        border-bottom: 1px dashed var(--border-color);
        padding-bottom: 0.4rem;
        transition: color 0.3s ease;
    }

    .day-card.open .day-number {
        color: var(--accent-blue);
        border-bottom-color: var(--accent-blue);
    }

    .day-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .day-val {
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1;
    }

    .day-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex-grow: 1;
        padding: 0.5rem 0;
    }

    .icon-locked {
        color: var(--border-color);
    }

    .icon-open {
        color: var(--accent-blue);
        transition: transform 0.2s ease;
    }

    /* === Begin / Finish は横長バー表示(カレンダーの上下に独立配置) === */
    .day-card.special {
        display: block;
        width: 100%;
    }
    .day-card.special .day-card-inner {
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        gap: 1.2rem;
        padding: 1.2rem 1.5rem;
    }
    .day-card.special .day-number {
        margin-bottom: 0;
        border-bottom: none;
        padding-bottom: 0;
        flex-direction: row;
        align-items: baseline;
        gap: 0.6rem;
    }
    .day-card.special .day-label {
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        opacity: 0.7;
    }
    .day-card.special .day-val {
        font-size: 1.3rem;
        letter-spacing: 0.08em;
        font-family: var(--font-mono, "JetBrains Mono", monospace);
        text-transform: uppercase;
    }
    .day-card.special .day-content {
        flex-grow: 0;
        padding: 0;
        margin-left: auto;
    }

    /* =========================================
       PC表示: ホバー/フォーカス時のサムネポップアップ
       ========================================= */
    .day-popup {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 10px);
        transform: translate(-50%, 6px);
        width: 220px;
        background: var(--elevated);
        border: 1px solid var(--border-color);
        border-radius: 4px;
        padding: 0.5rem;
        opacity: 0;
        pointer-events: none;
        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
        z-index: 20;
    }

    .day-popup-thumb {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 2px;
        background: var(--surface);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .day-popup-thumb :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 0;
        box-shadow: none;
    }

    .day-popup-noimg {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-family: var(--font-mono, "JetBrains Mono", monospace);
    }

    .day-popup-title {
        margin: 0.5rem 0 0;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-main);
        line-height: 1.4;
    }

    @media (hover: hover) {
        .day-card.open:not(.no-link):hover .day-popup {
            opacity: 1;
            transform: translate(-50%, 0);
        }
    }
    .day-card.open:not(.no-link):focus-visible .day-popup {
        opacity: 1;
        transform: translate(-50%, 0);
    }

    /* =========================================
       スマホ表示: サムネ埋め込みの1行リスト
       ========================================= */
    .day-row-mobile {
        display: none;
    }

    @media (max-width: 720px) {
        .day-card-inner,
        .day-popup {
            display: none;
        }

        .day-row-mobile {
            display: flex;
            align-items: center;
            gap: 0.9rem;
            padding: 0.8rem 0.2rem;
            border-bottom: 1px solid var(--border-color);
            transition: background-color 0.2s ease;
        }

        .day-card:active .day-row-mobile {
            background-color: color-mix(
                in srgb,
                var(--accent-blue) 8%,
                transparent
            );
        }

        .day-row-mobile.special {
            border: 1px dashed var(--accent-blue);
            border-radius: 4px;
            padding: 0.9rem 0.8rem;
            margin: 0.5rem 0;
        }

        .day-row-thumb {
            flex-shrink: 0;
            width: 96px;
            aspect-ratio: 16 / 9;
            background: var(--surface);
            border: 1px solid var(--border-color);
            border-radius: 2px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .day-card.locked .day-row-thumb {
            background: repeating-linear-gradient(
                45deg,
                transparent,
                transparent 8px,
                rgba(0, 0, 0, 0.03) 8px,
                rgba(0, 0, 0, 0.03) 16px
            );
        }
        :global(html.dark) .day-card.locked .day-row-thumb {
            background: repeating-linear-gradient(
                45deg,
                transparent,
                transparent 8px,
                rgba(255, 255, 255, 0.02) 8px,
                rgba(255, 255, 255, 0.02) 16px
            );
        }

        .day-row-thumb :global(img) {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 0;
            box-shadow: none;
        }

        .day-row-main {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
            min-width: 0;
            flex-grow: 1;
        }

        .day-row-date {
            font-family: var(--font-mono, "JetBrains Mono", monospace);
            font-size: 0.72rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .day-row-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .day-card.locked .day-row-title {
            color: var(--text-muted);
            font-family: var(--font-mono, "JetBrains Mono", monospace);
            font-weight: 400;
        }

        .day-row-mobile > :global(svg) {
            flex-shrink: 0;
        }
    }
</style>
