---
// 環境カード。上に Desktop / Laptop / Mobile / Setup の 4 つのタブ(1 本の大きなピルの中を、白い台がすべって移る。
// Blog の掲載先トグルと同じ見た目)、下に選んだ環境のパーツ構成・スペックを出す。
//   しくみ: 4 つぶんの詳細(パネル)を同じマスに重ねて置き、選ばれたものだけを見せる(opacity のフェード)。
//           重ねておくので、どのタブでもカードの高さは一番長いパネルに揃い、切り替えで高さが跳ねない。
//   操作:   クリック(タップ)で切り替え。ホバーでは何も起きない(誤爆の防止)。
//           キーボードは ← → / Home / End で移動(タブの標準的な操作)。
// 中身は src/data/about.ts の ENV_BLOCKS。
import { Computer, Laptop, Smartphone, SquareTerminal } from "lucide-astro";
import { ENV_BLOCKS } from "../../../data/about";
import BentoCard from "./BentoCard.astro";

const KIND = {
    desktop: { icon: Computer, label: "Desktop" },
    laptop: { icon: Laptop, label: "Laptop" },
    mobile: { icon: Smartphone, label: "Mobile" },
    setup: { icon: SquareTerminal, label: "Setup" },
} as const;

const tabs = ENV_BLOCKS.map((b) => ({ ...b, ...KIND[b.section as keyof typeof KIND] }));
---

<BentoCard label="Environment" class="env" order={0}>
    <div class="env-root" data-env>
        <div class="seg" role="tablist" aria-label="環境" data-env-seg>
            <span class="seg-thumb" aria-hidden="true" data-env-thumb></span>
            {
                tabs.map((t, i) => (
                    <button
                        type="button"
                        class="seg-btn"
                        role="tab"
                        id={`env-tab-${t.section}`}
                        aria-controls={`env-${t.section}`}
                        aria-selected={i === 0 ? "true" : "false"}
                        tabindex={i === 0 ? 0 : -1}
                        data-env-tab
                    >
                        <t.icon size={15} strokeWidth={1.75} aria-hidden="true" />
                        <span class="seg-label">{t.label}</span>
                    </button>
                ))
            }
        </div>

        <div class="panels">
            {
                tabs.map((t, i) => (
                    <div
                        class:list={["panel", { "is-active": i === 0 }]}
                        id={`env-${t.section}`}
                        role="tabpanel"
                        aria-labelledby={`env-tab-${t.section}`}
                        tabindex="0"
                        data-env-panel
                    >
                        {t.meta && <p class="meta">{t.meta.replace(" : ", " · ").replace(/\//g, ".")}</p>}
                        <dl class="specs">
                            {t.rows.map((r) => (
                                <div class="spec">
                                    <dt>{r.k}</dt>
                                    <dd>{r.v}</dd>
                                </div>
                            ))}
                        </dl>
                        {t.link && (
                            <a class="more" href={t.link.href}>
                                {t.link.tag} →
                            </a>
                        )}
                    </div>
                ))
            }
        </div>
    </div>
</BentoCard>

<script>
    function bindEnv() {
        document.querySelectorAll<HTMLElement>("[data-env]").forEach((root) => {
            if (root.dataset.bound) return;
            root.dataset.bound = "1";

            const seg = root.querySelector<HTMLElement>("[data-env-seg]")!;
            const thumb = root.querySelector<HTMLElement>("[data-env-thumb]")!;
            const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-env-tab]"));
            const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-env-panel]"));

            // 台を、選ばれたタブの位置・幅へ移す(CSS の transition ですべって見える)
            const moveThumb = (animate: boolean) => {
                const active = tabs.find((t) => t.getAttribute("aria-selected") === "true");
                if (!active || active.offsetWidth === 0) return;
                if (!animate) thumb.style.transition = "none";
                thumb.style.setProperty("--x", `${active.offsetLeft}px`);
                thumb.style.setProperty("--w", `${active.offsetWidth}px`);
                seg.classList.add("has-thumb");
                if (!animate) {
                    void thumb.offsetWidth;
                    thumb.style.transition = "";
                }
            };

            const select = (index: number, focus = false) => {
                tabs.forEach((t, i) => {
                    const on = i === index;
                    t.setAttribute("aria-selected", String(on));
                    t.tabIndex = on ? 0 : -1;
                    panels[i].classList.toggle("is-active", on);
                });
                moveThumb(true);
                if (focus) tabs[index].focus();
            };

            tabs.forEach((t, i) => t.addEventListener("click", () => select(i)));
            seg.addEventListener("keydown", (e) => {
                const cur = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
                const last = tabs.length - 1;
                const next =
                    e.key === "ArrowRight" ? (cur >= last ? 0 : cur + 1)
                    : e.key === "ArrowLeft" ? (cur <= 0 ? last : cur - 1)
                    : e.key === "Home" ? 0
                    : e.key === "End" ? last
                    : -1;
                if (next < 0) return;
                e.preventDefault();
                select(next, true);
            });

            // フォントの読み込みやカード幅の変化でタブの幅が変わるので、台を合わせ直す
            const ro = new ResizeObserver(() => moveThumb(false));
            ro.observe(seg);
            moveThumb(false);
        });
    }

    document.addEventListener("astro:page-load", bindEnv);
</script>

<style>
    .env-root {
        flex: 1;
        min-height: 0;
        /* タブの幅に応じて、ラベルを出す・隠す(下の @container) */
        container-type: inline-size;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    /* ---- タブ(Blog の掲載先トグルと同じ作り) ----
       枠の中を、白(ライトでは黒)の台が選ばれた項目へすべって移る。台の位置・幅は JS が --x / --w に書く。
       JS が動く前は、選ばれたボタン自身を塗っておく */
    .seg {
        position: relative;
        display: flex;
        padding: 3px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
    }

    .seg-thumb {
        position: absolute;
        top: 3px;
        bottom: 3px;
        left: 0;
        width: var(--w, 0);
        border-radius: 999px;
        background: var(--text);
        transform: translateX(var(--x, 0));
        opacity: 0;
        /* 少しだけ行き過ぎて戻る、弾むような動き */
        transition:
            transform 0.5s cubic-bezier(0.34, 1.35, 0.5, 1),
            width 0.5s cubic-bezier(0.34, 1.35, 0.5, 1),
            opacity 0.2s ease;
    }

    .seg.has-thumb .seg-thumb {
        opacity: 1;
    }

    .seg-btn {
        position: relative;
        z-index: 1;
        flex: 1 1 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
        min-width: 0;
        padding: 0.42rem 0.3rem;
        border: 0;
        border-radius: 999px;
        background: none;
        font-family: var(--font-mono);
        font-size: 0.56rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--text-muted);
        cursor: pointer;
        transition: color 0.35s ease;
        -webkit-tap-highlight-color: transparent;
    }

    .seg-btn :global(svg) {
        flex: none;
    }

    /* 選ばれた項目の文字は、台の色と反転させる(ダーク: 黒字 / ライト: 白字) */
    .seg-btn[aria-selected="true"] {
        color: var(--bg-deep);
    }

    .seg:not(.has-thumb) .seg-btn[aria-selected="true"] {
        background: var(--text);
    }

    @media (hover: hover) {
        .seg-btn[aria-selected="false"]:hover {
            color: var(--text);
        }
    }

    .seg-btn:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 2px;
    }

    /* 狭いカードでは、アイコンだけにして 4 つを収める(ラベルは読み上げ用に残す) */
    @container (max-width: 14.5rem) {
        .seg-label {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip: rect(0 0 0 0);
        }
    }

    /* ---- パネル: 同じマスに重ねて置き、選ばれたものだけ見せる ---- */
    .panels {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    }

    .panel {
        grid-area: 1 / 1;
        min-height: 0;
        padding: 0.1rem 0.15rem 0 0.1rem;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--text) 25%, transparent) transparent;
        opacity: 0;
        visibility: hidden;
        transform: translateY(4px);
        transition:
            opacity 0.22s ease,
            transform 0.22s ease,
            visibility 0s linear 0.22s;
    }

    .panel.is-active {
        opacity: 1;
        visibility: visible;
        transform: none;
        transition:
            opacity 0.3s ease 0.1s,
            transform 0.3s var(--ease-out) 0.1s,
            visibility 0s;
    }

    .panel:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 2px;
        border-radius: 6px;
    }

    .meta {
        margin: 0 0 0.45rem;
        font-family: var(--font-mono);
        font-size: 0.62rem;
        line-height: 1.5;
        letter-spacing: 0.03em;
        color: var(--text-muted);
    }

    /* 項目名(左)と値(右)の 2 列。9 項目でも縦に収まるよう、1 行ずつ詰める。
       項目名の列の幅は、そのパネルでいちばん長い項目名に合わせる(subgrid で全行が同じ列を共有する) */
    .specs {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        column-gap: 0.7rem;
        margin: 0;
    }

    .spec {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
        align-items: baseline;
        padding: 0.19rem 0;
        border-top: 1px solid color-mix(in srgb, var(--text) 7%, transparent);
    }

    .spec:first-child {
        border-top: 0;
    }

    .spec dt {
        font-family: var(--font-mono);
        font-size: 0.56rem;
        line-height: 1.3;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
        overflow-wrap: anywhere;
    }

    .spec dd {
        margin: 0;
        font-size: 0.72rem;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .more {
        display: inline-block;
        margin-top: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.62rem;
        letter-spacing: 0.04em;
        color: var(--accent);
        text-decoration: none;
    }

    .more:hover,
    .more:focus-visible {
        text-decoration: underline;
    }

    /* 12 カラムのいちばん狭い幅(1200〜1290px)では、カードが細くて 2 項目が折り返すので、行間を詰めて収める */
    @media (min-width: 1200px) and (max-width: 1290px) {
        .spec {
            padding: 0.1rem 0;
        }
        .more {
            margin-top: 0.35rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .seg-thumb,
        .panel,
        .panel.is-active {
            transition: none;
            transform: none;
        }
    }
</style>
