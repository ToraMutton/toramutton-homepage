---
// 環境カード。上に Desktop / Laptop / Setup の 3 つのタブ(1 本の大きなピルの中を、白い台がすべって移る。
// Blog の掲載先トグルと同じ見た目)、下に選んだ環境のパーツ構成・スペックを出す。
//   Setup は、Mobile(スマホ・タブレット)と、作業環境(モニター・エディタ・WM など)をひとまとめにしたタブ。
//   しくみ: 3 つぶんの詳細(パネル)を同じマスに重ねて置き、選ばれたものだけを見せる(opacity のフェード)。
//           重ねておくので、どのタブでもカードの高さは一番長いパネルに揃い、切り替えで高さが跳ねない。
//   操作:   クリック(タップ)で切り替え。ホバーでは何も起きない(誤爆の防止)。
//           キーボードは ← → / Home / End で移動(タブの標準的な操作)。
//   幅:     タブのラベルが入りきらない細さ(--tabs-min 未満)のときは、アイコンだけにする(@container)。
//   高さ:   PC 幅ではカードが縦に長い(Bento の行 1〜2 をまるごと使う)ので、スクロールなしで収まる。
//           万一あふれたときのためだけに、パネルは overflow-y: auto にしてある。
// 中身は src/data/about.ts の ENV_BLOCKS。
import { Boxes, Computer, Laptop } from "lucide-astro";
import { ENV_BLOCKS } from "../../../data/about";
import BentoCard from "./BentoCard.astro";

const block = (section: string) => ENV_BLOCKS.find((b) => b.section === section)!;
const desktop = block("desktop");
const laptop = block("laptop");
const mobile = block("mobile");
const setup = block("setup");

const tabs = [
    { id: "desktop", icon: Computer, label: "Desktop", meta: desktop.meta, link: desktop.link, groups: [{ rows: desktop.rows }] },
    { id: "laptop", icon: Laptop, label: "Laptop", meta: laptop.meta, link: laptop.link, groups: [{ rows: laptop.rows }] },
    {
        id: "setup",
        icon: Boxes,
        label: "Setup",
        meta: undefined,
        link: undefined,
        groups: [
            { title: "Mobile", rows: mobile.rows },
            { title: "Workspace", rows: setup.rows },
        ],
    },
];

const metaText = (m?: string) => m?.replace(" : ", " · ").replace(/\//g, ".");
---

<BentoCard label="Environment" class="env" order={0}>
    <div class="env-root" data-env>
        <div class="seg" role="tablist" aria-label="環境" data-env-seg>
            <span class="seg-thumb" aria-hidden="true" data-env-thumb></span>
            {
                tabs.map((t, i) => (
                    <button
                        type="button"
                        class="seg-btn"
                        role="tab"
                        id={`env-tab-${t.id}`}
                        aria-controls={`env-${t.id}`}
                        aria-selected={i === 0 ? "true" : "false"}
                        aria-label={t.label}
                        title={t.label}
                        tabindex={i === 0 ? 0 : -1}
                        data-env-tab
                    >
                        <t.icon size={17} strokeWidth={1.75} aria-hidden="true" />
                        <span class="seg-label" aria-hidden="true">
                            {t.label}
                        </span>
                    </button>
                ))
            }
        </div>

        <div class="panels">
            {
                tabs.map((t, i) => (
                    <div
                        class:list={["panel", { "is-active": i === 0 }]}
                        id={`env-${t.id}`}
                        role="tabpanel"
                        aria-labelledby={`env-tab-${t.id}`}
                        tabindex="0"
                        data-env-panel
                    >
                        {t.meta && <p class="meta">{metaText(t.meta)}</p>}
                        <div class="groups">
                            {t.groups.map((g) => (
                                <section class="group">
                                    {"title" in g && <h4 class="group-title">{g.title}</h4>}
                                    <dl class="specs">
                                        {g.rows.map((r) => (
                                            <div class="spec">
                                                <dt>{r.k}</dt>
                                                <dd>{r.v}</dd>
                                            </div>
                                        ))}
                                    </dl>
                                </section>
                            ))}
                        </div>
                        {t.link && (
                            <a class="more" href={t.link.href}>
                                {t.link.tag} →
                            </a>
                        )}
                    </div>
                ))
            }
        </div>
    </div>
</BentoCard>

<script>
    function bindEnv() {
        document.querySelectorAll<HTMLElement>("[data-env]").forEach((root) => {
            if (root.dataset.bound) return;
            root.dataset.bound = "1";

            const seg = root.querySelector<HTMLElement>("[data-env-seg]")!;
            const thumb = root.querySelector<HTMLElement>("[data-env-thumb]")!;
            const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-env-tab]"));
            const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-env-panel]"));

            // 台を、選ばれたタブの位置・幅へ移す(CSS の transition ですべって見える)
            const moveThumb = (animate: boolean) => {
                const active = tabs.find((t) => t.getAttribute("aria-selected") === "true");
                if (!active || active.offsetWidth === 0) return;
                if (!animate) thumb.style.transition = "none";
                thumb.style.setProperty("--x", `${active.offsetLeft}px`);
                thumb.style.setProperty("--w", `${active.offsetWidth}px`);
                seg.classList.add("has-thumb");
                if (!animate) {
                    void thumb.offsetWidth;
                    thumb.style.transition = "";
                }
            };

            const select = (index: number, focus = false) => {
                tabs.forEach((t, i) => {
                    const on = i === index;
                    t.setAttribute("aria-selected", String(on));
                    t.tabIndex = on ? 0 : -1;
                    panels[i].classList.toggle("is-active", on);
                });
                moveThumb(true);
                if (focus) tabs[index].focus();
            };

            tabs.forEach((t, i) => t.addEventListener("click", () => select(i)));
            seg.addEventListener("keydown", (e) => {
                const cur = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
                const last = tabs.length - 1;
                const next =
                    e.key === "ArrowRight" ? (cur >= last ? 0 : cur + 1)
                    : e.key === "ArrowLeft" ? (cur <= 0 ? last : cur - 1)
                    : e.key === "Home" ? 0
                    : e.key === "End" ? last
                    : -1;
                if (next < 0) return;
                e.preventDefault();
                select(next, true);
            });

            // フォントの読み込み・カード幅の変化・ラベルの出し入れでタブの幅が変わるので、台を合わせ直す
            const ro = new ResizeObserver(() => moveThumb(false));
            ro.observe(seg);
            tabs.forEach((t) => ro.observe(t));
            moveThumb(false);
        });
    }

    document.addEventListener("astro:page-load", bindEnv);
</script>

<style>
    .env-root {
        flex: 1;
        min-height: 0;
        /* タブの幅に応じて、ラベルを出す・隠す(下の @container) */
        container-type: inline-size;
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }

    /* ---- タブ(Blog の掲載先トグルと同じ作り) ----
       枠の中を、白(ライトでは黒)の台が選ばれた項目へすべって移る。台の位置・幅は JS が --x / --w に書く。
       JS が動く前は、選ばれたボタン自身を塗っておく */
    .seg {
        position: relative;
        display: flex;
        padding: 3px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
    }

    .seg-thumb {
        position: absolute;
        top: 3px;
        bottom: 3px;
        left: 0;
        width: var(--w, 0);
        border-radius: 999px;
        background: var(--text);
        transform: translateX(var(--x, 0));
        opacity: 0;
        /* 少しだけ行き過ぎて戻る、弾むような動き */
        transition:
            transform 0.5s cubic-bezier(0.34, 1.35, 0.5, 1),
            width 0.5s cubic-bezier(0.34, 1.35, 0.5, 1),
            opacity 0.2s ease;
    }

    .seg.has-thumb .seg-thumb {
        opacity: 1;
    }

    .seg-btn {
        position: relative;
        z-index: 1;
        flex: 1 1 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        min-width: 0;
        padding: 0.58rem 0.4rem;
        border: 0;
        border-radius: 999px;
        background: none;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--text-muted);
        cursor: pointer;
        transition: color 0.35s ease;
        -webkit-tap-highlight-color: transparent;
    }

    .seg-btn :global(svg) {
        flex: none;
    }

    /* 選ばれた項目の文字は、台の色と反転させる(ダーク: 黒字 / ライト: 白字) */
    .seg-btn[aria-selected="true"] {
        color: var(--bg-deep);
    }

    .seg:not(.has-thumb) .seg-btn[aria-selected="true"] {
        background: var(--text);
    }

    @media (hover: hover) {
        .seg-btn[aria-selected="false"]:hover {
            color: var(--text);
        }
    }

    .seg-btn:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 2px;
    }

    /* ラベルが入りきらない細さ(3 つぶんのラベルつきタブがおさまる幅 ≈ 15.2rem 未満)では、アイコンだけにする。
       文字を小さくして詰め込むのではなく、情報を減らして読みやすさを守る。名前は title / aria-label で残してある */
    @container (max-width: 15.2rem) {
        .seg-label {
            display: none;
        }
        .seg-btn {
            padding-block: 0.7rem;
        }
    }

    /* ---- パネル: 同じマスに重ねて置き、選ばれたものだけ見せる ---- */
    .panels {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    }

    .panel {
        grid-area: 1 / 1;
        min-height: 0;
        padding: 0.1rem 0.2rem 0 0.1rem;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--text) 25%, transparent) transparent;
        opacity: 0;
        visibility: hidden;
        transform: translateY(4px);
        transition:
            opacity 0.22s ease,
            transform 0.22s ease,
            visibility 0s linear 0.22s;
    }

    .panel.is-active {
        opacity: 1;
        visibility: visible;
        transform: none;
        transition:
            opacity 0.3s ease 0.1s,
            transform 0.3s var(--ease-out) 0.1s,
            visibility 0s;
    }

    .panel:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 2px;
        border-radius: 6px;
    }

    .meta {
        margin: 0 0 0.9rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        line-height: 1.5;
        letter-spacing: 0.03em;
        color: var(--text-muted);
    }

    /* 項目名(左)と値(右)の 2 列。項目名の列の幅は、そのパネルでいちばん長い項目名に合わせる
       (グループが分かれていても、subgrid で全行が同じ列を共有する) */
    .groups {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        column-gap: 0.9rem;
    }

    .group {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
    }
    .group + .group {
        margin-top: 1.2rem;
    }

    .group-title {
        grid-column: 1 / -1;
        margin: 0 0 0.15rem;
        font-family: var(--font-mono);
        font-size: 0.64rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .specs {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
        margin: 0;
    }

    .spec {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
        align-items: baseline;
        padding: 0.5rem 0;
        border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    }

    .spec:first-child {
        border-top: 0;
    }
    .group-title + .specs .spec:first-child {
        border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    }

    .spec dt {
        font-family: var(--font-mono);
        font-size: 0.64rem;
        line-height: 1.3;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
        overflow-wrap: anywhere;
    }

    .spec dd {
        margin: 0;
        font-size: 0.86rem;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .more {
        display: inline-block;
        margin-top: 1rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        color: var(--accent);
        text-decoration: none;
    }

    .more:hover,
    .more:focus-visible {
        text-decoration: underline;
    }

    @media (prefers-reduced-motion: reduce) {
        .seg-thumb,
        .panel,
        .panel.is-active {
            transition: none;
            transform: none;
        }
    }
</style>
