---
// 趣味カード。トップの About セクションの趣味と同じ(中身は src/data/about.ts の INTERESTS)。
import { INTERESTS } from "../../../data/about";
import BentoCard from "./BentoCard.astro";
---

<BentoCard label="Hobbies" class="hobby" order={3}>
    <dl class="hobbies">
        {
            INTERESTS.map((g) => (
                <div>
                    <dt>{g.section}</dt>
                    <dd>
                        {g.items.map((it, i) => (
                            <>
                                {i > 0 && (
                                    <span class="sep" aria-hidden="true">
                                        /
                                    </span>
                                )}
                                <span>{it}</span>
                            </>
                        ))}
                    </dd>
                </div>
            ))
        }
    </dl>
</BentoCard>

<style>
    .hobbies {
        display: grid;
        align-content: center;
        flex: 1;
        margin: 0;
    }

    .hobbies > div {
        display: grid;
        grid-template-columns: 3.4rem minmax(0, 1fr);
        align-items: baseline;
        gap: 0.6rem;
        padding: 0.5rem 0;
        border-top: 1px solid var(--border);
    }

    .hobbies > div:last-child {
        border-bottom: 1px solid var(--border);
    }

    .hobbies dt {
        font-family: var(--font-mono);
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .hobbies dd {
        margin: 0;
        font-size: 0.86rem;
        line-height: 1.55;
    }

    .sep {
        margin: 0 0.4em;
        font-family: var(--font-mono);
        color: var(--accent);
        opacity: 0.7;
    }
</style>
