---
// /about の Bento Grid(ヒーローの下)。角丸のカードを敷き詰める。ヒーローの三角形が覆い切った --bg-deep が、そのまま地になる。
//
// PC 幅(1200px 以上): 12 カラム × 3 行
//          1–3          4–6      7–9      10–12
//   行 1   環境(上 64%)  Uptime   趣味     資格 +
//   行 2   Countdown     CRT モニター(4–9)  タイムライン(縦 3 行ぶん。内側でスクロール)
//   行 3   技術スタック(1–5)      GitHub(6–9)
//   左(環境 + Countdown。行 1〜2 ぶん)と右(資格 + タイムライン)は、列全体を 1 つの入れ物にして中でカードを積む。
//   行の高さは 17rem / 21rem / 15rem。
// 1200px 未満: 2 カラム(CRT・技術スタック・GitHub・資格は全幅)  /  720px 以下: 1 カラム縦積み
//   どちらも、左右の入れ物は display: contents で外して、カードを並べ替えなしに順に敷く。
//
// 真ん中の CRT モニター(bento/BentoCrt.astro)は、カードの枠より上へ突き出す(canvas はカードの外に置いてある)。
// 突き出した先の Uptime・趣味のカードをクリックできるよう、canvas 自体はポインターを素通しする。
import BentoEnv from "./bento/BentoEnv.astro";
import BentoCountdown from "./bento/BentoCountdown.astro";
import BentoUptime from "./bento/BentoUptime.astro";
import BentoHobby from "./bento/BentoHobby.astro";
import BentoSkills from "./bento/BentoSkills.astro";
import BentoGithub from "./bento/BentoGithub.astro";
import BentoProfile from "./bento/BentoProfile.astro";
import BentoCrt from "./bento/BentoCrt.astro";
---

<section class="bento" id="bento" aria-labelledby="bento-title">
    <h2 id="bento-title" class="sr-only">プロフィールの詳細</h2>
    <div class="inner">
        <div class="grid">
            <div class="left">
                <BentoEnv />
                <BentoCountdown />
            </div>
            <div class="cell c-uptime"><BentoUptime /></div>
            <div class="cell c-hobby"><BentoHobby /></div>
            <div class="cell c-crt"><BentoCrt /></div>
            <div class="cell c-skills"><BentoSkills /></div>
            <div class="cell c-github"><BentoGithub /></div>
            <div class="right"><BentoProfile /></div>
        </div>
    </div>
</section>

<style>
    .bento {
        background: var(--bg-deep);
        /* ヘッダー(固定 72px)の裏から始まるので、その分も含めて余白をとる */
        padding: clamp(5rem, 11vh, 7.5rem) 0 clamp(4rem, 9vh, 7rem);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }

    .inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .grid {
        --gap: 14px;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        grid-template-rows: 17rem 21rem 15rem;
        gap: var(--gap);
    }

    /* カードを 1 枚ずつ入れる入れ物。カードは入れ物いっぱいに伸びる */
    .cell,
    .left,
    .right {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
    }
    .cell > :global(.card),
    .right > :global(.card) {
        flex: 1;
    }

    .left {
        grid-column: 1 / 4;
        grid-row: 1 / 3;
        gap: var(--gap);
    }
    /* 環境が上の 64%、Countdown が下の 36%(環境は開いたピルにスペックを詰めるので、縦を多めに取る) */
    .left > :global(.env) {
        flex: 64 1 0;
    }
    .left > :global(.countdown) {
        flex: 36 1 0;
    }

    .c-uptime {
        grid-column: 4 / 7;
        grid-row: 1;
    }
    .c-hobby {
        grid-column: 7 / 10;
        grid-row: 1;
    }
    .c-crt {
        grid-column: 4 / 10;
        grid-row: 2;
    }
    .c-skills {
        grid-column: 1 / 6;
        grid-row: 3;
    }
    .c-github {
        grid-column: 6 / 10;
        grid-row: 3;
    }
    .right {
        grid-column: 10 / 13;
        grid-row: 1 / 4;
    }

    /* ---- 2 カラム(タブレット・小さめのノート PC) ---- */
    @media (max-width: 1199px) {
        .grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            grid-template-rows: none;
        }

        /* 左右の入れ物は外して、中のカードを直接グリッドに並べる */
        .left,
        .right {
            display: contents;
        }
        .left > :global(.env),
        .left > :global(.countdown) {
            flex: none;
        }

        .cell,
        .c-uptime,
        .c-hobby {
            grid-column: auto;
            grid-row: auto;
        }
        .c-crt,
        .c-skills,
        .c-github {
            grid-column: 1 / -1;
            grid-row: auto;
        }
        .right > :global(.card) {
            grid-column: 1 / -1;
        }

        .c-uptime,
        .c-hobby {
            min-height: 14rem;
        }
        .c-crt {
            min-height: 20rem;
        }
    }

    /* ---- 1 カラム(スマホ) ---- */
    @media (max-width: 720px) {
        .grid {
            grid-template-columns: minmax(0, 1fr);
        }
        .c-uptime,
        .c-hobby {
            grid-column: 1 / -1;
        }
        .c-crt {
            min-height: 17rem;
        }
    }
</style>
