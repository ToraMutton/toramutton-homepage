---
// /links の本体。見出し(件数と Random Jump)と、相手サイトの索引。
//
// 引き算のデザイン: カードも面も持たず、細い線と文字だけ。全員を同じ大きさで扱う。
// 味付けはネットワークの語彙で 1 種類だけ:
//   ・行の下の線 = 回線。ホバーすると光の粒が往復する(相互リンク = 双方向)
//   ・件数は peers(対等な接続相手)
// 相手のサイトが動いているかはここでは分からないので、ping や ONLINE のような表示は出さない。
//
// アイコンの用意は `npm run favicons`(scripts/fetch-favicons.mjs)。ページ描画時にネットへは出ない。
import { ArrowLeftRight, Dices } from "lucide-astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { LINKS_SUMMARY } from "../../data/home";
import friendLinks from "../../data/links.json";
import faviconMapJson from "../../data/favicon-map.json";

const getDomain = (url: string) => {
    try {
        return new URL(url).hostname.replace(/^www\./, "");
    } catch {
        return url;
    }
};

// icon が null のサイトは、自動取得した対応表のほうを使う
const faviconMap: Record<string, string> = faviconMapJson;
const peers = friendLinks.map((link) => ({
    name: link.name,
    url: link.url,
    domain: getDomain(link.url),
    icon: link.icon ?? faviconMap[link.url] ?? null,
}));
---

<div data-peers>
    <div class="head">
        <SectionTitle as="h1" title="Links" caption={LINKS_SUMMARY} />
        <div class="aside">
            <span class="count">{peers.length} peers</span>
            <button type="button" class="jump" data-peer-jump>
                <Dices size={16} strokeWidth={1.5} aria-hidden="true" />
                <span>Random Jump</span>
            </button>
            {/* 演出中の経過表示。毎ホップ読み上げると騒がしいので、読み上げは下の sr-only で結果だけ */}
            <p class="status" aria-hidden="true" data-peer-status></p>
        </div>
    </div>
    <p class="sr-only" aria-live="polite" data-peer-announce></p>

    <ul class="peers">
        {
            peers.map((peer, i) => (
                <li
                    class="peer"
                    style={`--i:${i}`}
                    data-reveal
                    data-peer
                    data-name={peer.name}
                >
                    <a href={peer.url} target="_blank" rel="noopener noreferrer">
                        <span class="icon" aria-hidden="true">
                            {peer.icon ? (
                                <img
                                    src={peer.icon}
                                    alt=""
                                    width="40"
                                    height="40"
                                    decoding="async"
                                    loading="lazy"
                                />
                            ) : (
                                <span class="initial">{peer.name.trim().charAt(0)}</span>
                            )}
                        </span>
                        <span class="text">
                            <span class="name">{peer.name}</span>
                            <span class="domain">{peer.domain}</span>
                        </span>
                        <span class="mark" aria-hidden="true">
                            <ArrowLeftRight size={16} strokeWidth={1.5} />
                        </span>
                        <span class="wire" aria-hidden="true">
                            <span class="packet" data-packet />
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<script>
    import { initPeerJump } from "../../scripts/peer-jump";
    document.addEventListener("astro:page-load", initPeerJump);
</script>

<style>
    .sr-only {
        position: absolute;
        overflow: hidden;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    /* ---- 見出し行 ---- */
    .head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .aside {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding-bottom: 2.5rem;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
    }

    .count {
        color: var(--text-muted);
        white-space: nowrap;
    }

    .jump {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1.1rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: transparent;
        color: var(--text);
        font: inherit;
        white-space: nowrap;
        cursor: pointer;
        transition:
            border-color 0.25s ease,
            color 0.25s ease;
    }

    .jump:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
    }

    .jump[data-running] {
        border-color: var(--accent);
        color: var(--accent);
        cursor: default;
    }

    @media (hover: hover) {
        .jump:hover {
            border-color: var(--accent);
            color: var(--accent);
        }
    }

    /* 見出し行の下の余白に重ねて置くので、文字が出ても何も押し動かさない */
    .status {
        position: absolute;
        right: 0;
        bottom: 0.6rem;
        margin: 0;
        color: var(--accent);
        font-size: 0.72rem;
        white-space: nowrap;
    }

    /* ---- 索引 ---- */
    /* 横に読んで次の段へ進む順(links.json に入れた順) */
    .peers {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 3.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    /* 件数が多いので、出現の段差は数件分で頭打ちにする */
    .peer[data-reveal].is-visible {
        animation-duration: 0.4s;
        animation-delay: calc(min(var(--i, 0), 6) * 30ms);
    }

    .peer a {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
        height: 4.25rem;
        color: var(--text);
        text-decoration: none;
    }

    .peer a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    /* アイコンは相手の色のまま */
    .icon {
        display: grid;
        flex-shrink: 0;
        place-items: center;
        width: 40px;
        height: 40px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 50%;
        background: var(--elevated);
        transition: border-color 0.25s ease;
    }

    .icon img {
        width: 100%;
        height: 100%;
        padding: 3px;
        border-radius: 50%;
        object-fit: contain;
    }

    .initial {
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.9rem;
        font-weight: 700;
    }

    .text {
        display: flex;
        flex: 1;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        min-width: 0;
    }

    .name,
    .domain {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .name {
        flex-shrink: 0;
        max-width: 60%;
        font-size: 1.2rem;
        font-weight: 500;
        transition:
            color 0.2s ease,
            transform 0.35s var(--ease-out);
    }

    /* 普段は隠しておき、回線がつながったときに接続先として現れる */
    .domain {
        min-width: 0;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        opacity: 0;
        transform: translateX(-8px);
        transition:
            opacity 0.3s ease,
            transform 0.35s var(--ease-out);
    }

    .mark {
        display: flex;
        flex-shrink: 0;
        color: var(--accent);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    /* ---- 回線 ---- */
    .wire {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        height: 1px;
        background: var(--border);
    }

    /* 接続中の色。左から伸びる */
    .wire::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.45s var(--ease-out);
    }

    .packet {
        position: absolute;
        top: -2px;
        left: 0;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--accent-glow);
        box-shadow: 0 0 8px 2px color-mix(in srgb, var(--accent-glow) 60%, transparent);
        opacity: 0;
    }

    /* ---- つながった状態: ホバー / フォーカス / Random Jump の当選 ---- */
    .peer a:focus-visible .wire::before,
    .peer[data-picked] .wire::before {
        transform: none;
    }

    .peer a:focus-visible .name,
    .peer[data-picked] .name {
        color: var(--accent);
    }

    .peer a:focus-visible .domain,
    .peer[data-picked] .domain {
        opacity: 1;
        transform: none;
    }

    .peer a:focus-visible .mark,
    .peer[data-picked] .mark {
        opacity: 1;
    }

    .peer[data-picked] .icon {
        border-color: var(--accent);
    }

    /* 経路探索で通過中の行。すぐ点いて、離れると線が縮んで尾を引く */
    .peer[data-hop] .wire::before {
        transform: none;
        transition: none;
    }

    .peer[data-hop] .name {
        color: var(--accent);
        transition: none;
    }

    .peer[data-hop] .icon {
        border-color: var(--accent);
        transition: none;
    }

    @media (hover: hover) {
        .peer a:hover .wire::before {
            transform: none;
        }

        /* 行って、返ってくる */
        .peer a:hover .packet {
            animation: peer-round-trip 1.1s ease-in-out;
        }

        .peer a:hover .name {
            color: var(--accent);
            transform: translateX(4px);
        }

        .peer a:hover .domain {
            opacity: 1;
            transform: none;
        }

        .peer a:hover .mark {
            opacity: 1;
        }

        .peer a:hover .icon {
            border-color: var(--accent);
        }
    }

    @keyframes peer-round-trip {
        0% {
            left: 0;
            opacity: 0;
        }
        8% {
            opacity: 1;
        }
        50% {
            left: calc(100% - 5px);
        }
        92% {
            opacity: 1;
        }
        100% {
            left: 0;
            opacity: 0;
        }
    }

    /* ホバーできない端末では、ドメインを最初から見せる */
    @media (hover: none) {
        .domain {
            opacity: 1;
            transform: none;
        }
    }

    @media (max-width: 720px) {
        .head {
            flex-direction: column;
            align-items: stretch;
            gap: 0;
        }

        .aside {
            justify-content: space-between;
            margin-top: -1rem;
            padding-bottom: 2rem;
        }

        .status {
            right: auto;
            bottom: 0.4rem;
            left: 0;
        }

        .peers {
            grid-template-columns: minmax(0, 1fr);
        }

        .text {
            flex-direction: column;
            align-items: flex-start;
            gap: 0;
        }

        .name,
        .domain {
            max-width: 100%;
        }

        .name {
            font-size: 1.05rem;
            line-height: 1.4;
        }

        .domain {
            font-size: 0.7rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .name,
        .domain,
        .mark,
        .icon,
        .wire::before,
        .jump {
            transition: none;
        }

        .peer a:hover .packet {
            animation: none;
        }
    }
</style>
