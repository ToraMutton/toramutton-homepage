---
// 記事の「タイムライン索引」。トップの Blog セクションと、今後作り直す /blog の両方で使う。
//
//   細い縦の軸(数直線)に沿って、日付つきの行が並ぶ。
//   先頭の 1 件だけ画像と説明を広げた「特集」の見せ方、残りは細い行。
//   行にホバーすると、右からサムネイルが滑り出す。
//   検索 / 掲載先のトグルで絞ると、全記事から該当だけに入れ替わる(ブラウザ内で絞る。ページ内に全記事を持っている)。
//
// /blog だけで使う追加機能(props で入れる):
//   sortable … 検索欄の右に、新しい順 / 古い順を切り替える矢印ボタンを出す。
//              古い順のときは、先頭の「特集」(最新記事を大きく見せる行)は付けない
//   years    … 年が変わるところに「2026」のような年の区切りを入れる(軸に刻んだ大きな目盛りの見た目)
//
// 全記事を DOM に置き、limit を超える行は hidden にしておく。
// こうすると検索結果が同じ見た目の行でそのまま出せて、JS が無くても件数分は読める。
// /blog では limit を渡さなければ全件が最初から見える。
import { Image } from "astro:assets";
import { ArrowDown, ArrowRight, ArrowUpRight, Search, X } from "lucide-astro";
import BrandIcon from "../BrandIcon.astro";
import type { BlogEntry } from "../../utils/all-posts";
import type { PostSource } from "../../utils/feeds";

interface Props {
    posts: BlogEntry[];
    /** 最初に見せる件数。省略すると全件 */
    limit?: number;
    /** 全件ページへのリンク(「View all N posts」行)。出さないなら省略 */
    moreHref?: string;
    /** 並び替えボタンを出す(/blog 用) */
    sortable?: boolean;
    /** 年の区切りを入れる(/blog 用) */
    years?: boolean;
}

const { posts, limit = posts.length, moreHref, sortable = false, years = false } = Astro.props;

const sourceLabel: Record<PostSource, string> = {
    local: "Local",
    zenn: "Zenn",
    note: "Note",
    qiita: "Qiita",
};
// 記事が 0 件の媒体も出す。dev では外部サイトの記事が空(feeds.ts)で、絞り込みの挙動を確かめられなくなるため
const sources = ["zenn", "note", "qiita", "local"] as const;
const countOf = (s: PostSource) => posts.filter((p) => p.source === s).length;

// 日付は JST で出す(外部記事は時刻つき、ローカルは日付だけ。どちらも日本の日付に揃う)
const jst = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
});
const dateParts = (d: Date) => {
    const [year, month, day] = jst.format(d).split("-");
    return { year, md: `${month}.${day}`, iso: `${year}-${month}-${day}` };
};

const hiddenCount = Math.max(0, posts.length - limit);
---

<div
    class:list={["tl-root", { "has-years": years }]}
    data-timeline
    data-limit={limit}
    data-years={years ? "" : undefined}
    data-sortable={sortable ? "" : undefined}
>
    <div class="tools">
        <div class="search-row">
        <label class="search">
            <Search size={16} strokeWidth={1.5} />
            <input
                type="text"
                data-tl-input
                placeholder="Search posts"
                aria-label="記事を検索(タイトル・説明・タグ)"
                autocomplete="off"
                spellcheck="false"
                enterkeyhint="search"
            />
            <kbd aria-hidden="true">/</kbd>
            <button type="button" class="clear" data-tl-clear aria-label="検索をクリア" hidden>
                <X size={14} strokeWidth={1.75} />
            </button>
        </label>

        {
            sortable && (
                <button
                    type="button"
                    class="sort"
                    data-tl-sort
                    data-order="desc"
                    aria-label="並び順: 新しい順(押すと古い順)"
                >
                    <ArrowDown size={16} strokeWidth={1.75} class="sort-arrow" />
                    <span class="sort-label" data-tl-sort-label>Newest</span>
                </button>
            )
        }
        </div>

        <div class="tool-row">
            <!-- 白黒の「すべり台」トグル。選んだ項目の下を、白(ライトでは黒)の台がすべって移る -->
            <div class="seg" role="group" aria-label="掲載先で絞り込む" data-tl-seg>
                <span class="seg-thumb" aria-hidden="true" data-tl-thumb></span>
                <button type="button" class="seg-btn" data-tl-source="all" aria-pressed="true">
                    All<sup>{posts.length}</sup>
                </button>
                {
                    sources.map((s) => (
                        <button type="button" class="seg-btn" data-tl-source={s} aria-pressed="false">
                            {sourceLabel[s]}
                            <sup>{countOf(s)}</sup>
                        </button>
                    ))
                }
            </div>
            <p class="status" data-tl-status aria-live="polite"></p>
        </div>
    </div>

    <div class="timeline" data-tl-list>
        <ol class="rows" data-tl-rows>
            {
                posts.map((post, i) => {
                    const { year, md, iso } = dateParts(post.date);
                    const external = post.source !== "local";
                    const haystack = [post.title, post.description, post.tags.join(" "), sourceLabel[post.source]].join("\n");
                    return (
                        <li
                            class="row"
                            data-tl-row
                            data-featured={i === 0 ? "" : undefined}
                            data-source={post.source}
                            data-year={year}
                            data-search={haystack}
                            data-title={post.title}
                            hidden={i >= limit}
                            style={`--i:${Math.min(i, limit - 1)}`}
                        >
                            <a
                                class="row-link"
                                href={post.url}
                                target={external ? "_blank" : undefined}
                                rel={external ? "noopener noreferrer" : undefined}
                            >
                                <time class="row-date" datetime={iso}>
                                    <span class="y">{year}</span>
                                    <span class="md">{md}</span>
                                </time>
                                <span class="row-node" aria-hidden="true" />
                                <span class="row-main">
                                    <span class="row-title" data-tl-title>
                                        {post.title}
                                    </span>
                                    <span class="row-desc">{post.description}</span>
                                    <span class="row-meta">
                                        <span class={`src src-${post.source}`}>
                                            {post.source === "local" ? (
                                                <span class="src-glyph">$</span>
                                            ) : (
                                                <BrandIcon name={post.source} size={12} />
                                            )}
                                            {sourceLabel[post.source]}
                                            {external && <ArrowUpRight size={12} strokeWidth={1.75} />}
                                        </span>
                                        {post.tags.slice(0, 3).map((tag) => (
                                            <span class="tag">#{tag}</span>
                                        ))}
                                    </span>
                                </span>
                                <span class="row-thumb" aria-hidden="true">
                                    {post.image && typeof post.image === "object" ? (
                                        <Image
                                            src={post.image}
                                            alt=""
                                            width={Math.min(640, post.image.width)}
                                            height={Math.round(Math.min(640, post.image.width) * 0.625)}
                                            fit="cover"
                                            loading="lazy"
                                            draggable="false"
                                        />
                                    ) : post.image ? (
                                        <img src={post.image} alt="" loading="lazy" draggable="false" />
                                    ) : (
                                        <span class="tile">
                                            <span class="tile-glyph">
                                                {post.source === "local" ? "$" : post.source === "zenn" ? "<>" : post.source === "note" ? "¶" : "#"}
                                            </span>
                                        </span>
                                    )}
                                </span>
                            </a>
                        </li>
                    );
                })
            }
        </ol>

        <p class="empty" data-tl-empty hidden>No posts match. (´・ω・｀)</p>

        {
            moreHref && hiddenCount > 0 && (
                <a class="row more" href={moreHref} data-tl-more>
                    <span class="row-date" />
                    <span class="row-node" aria-hidden="true" />
                    <span class="row-main">
                        <span class="row-title">
                            View all {posts.length} posts
                            <ArrowRight size={16} strokeWidth={1.5} class="go" />
                        </span>
                    </span>
                </a>
            )
        }
    </div>
</div>

<script>
    // ---- 検索 / 絞り込み ----
    // 全記事の行はもう DOM にある。条件に合う行の hidden を外し、合わない行に付けるだけ。
    // 絞っていないときは、最初の limit 件だけ(= 新着)に戻る。
    let cleanup: (() => void) | null = null;

    // 全角英数 → 半角、カタカナ → ひらがな、小文字化。どれも 1 文字 → 1 文字なので、
    // 畳んだ文字列の位置がそのまま元のタイトルの位置になる(ハイライトに使う)
    const fold = (s: string) =>
        s
            .replace(/[！-～]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0))
            .replace(/[ァ-ヶ]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60))
            .toLowerCase();

    const escapeHtml = (s: string) =>
        s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

    /** title のうち terms に当たった範囲を <mark> で囲んだ HTML */
    function highlight(title: string, terms: string[]): string {
        if (terms.length === 0) return escapeHtml(title);
        const folded = fold(title);
        const hit = new Array<boolean>(title.length).fill(false);
        for (const term of terms) {
            for (let at = folded.indexOf(term); at !== -1; at = folded.indexOf(term, at + 1)) {
                for (let k = at; k < at + term.length; k++) hit[k] = true;
            }
        }
        let html = "";
        for (let i = 0; i < title.length; ) {
            const on = hit[i];
            let j = i;
            while (j < title.length && hit[j] === on) j++;
            const chunk = escapeHtml(title.slice(i, j));
            html += on ? `<mark>${chunk}</mark>` : chunk;
            i = j;
        }
        return html;
    }

    function init() {
        cleanup?.();
        const root = document.querySelector<HTMLElement>("[data-timeline]");
        if (!root) return;

        const input = root.querySelector<HTMLInputElement>("[data-tl-input]")!;
        const clearBtn = root.querySelector<HTMLButtonElement>("[data-tl-clear]")!;
        const chips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tl-source]"));
        const seg = root.querySelector<HTMLElement>("[data-tl-seg]")!;
        const thumb = root.querySelector<HTMLElement>("[data-tl-thumb]")!;
        const status = root.querySelector<HTMLElement>("[data-tl-status]")!;
        const empty = root.querySelector<HTMLElement>("[data-tl-empty]")!;
        const rowsEl = root.querySelector<HTMLElement>("[data-tl-rows]")!;
        const sortBtn = root.querySelector<HTMLButtonElement>("[data-tl-sort]");
        const sortLabel = root.querySelector<HTMLElement>("[data-tl-sort-label]");
        const hasYears = root.hasAttribute("data-years");
        const more = root.querySelector<HTMLElement>("[data-tl-more]");
        const list = root.querySelector<HTMLElement>("[data-tl-list]")!;
        const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-tl-row]"));
        const limit = Number(root.dataset.limit) || rows.length;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        const items = rows.map((row) => ({
            row,
            source: row.dataset.source!,
            year: row.dataset.year ?? "",
            haystack: fold(row.dataset.search ?? ""),
            title: row.dataset.title ?? "",
            titleEl: row.querySelector<HTMLElement>("[data-tl-title]")!,
        }));

        let source = "all";
        // false: 新しい順(DOM の最初の並び) / true: 古い順
        let asc = false;
        const sequence = () => (asc ? [...items].reverse() : items);

        // 台(thumb)を、いま選ばれているボタンの位置・幅へ移す。CSS の transition ですべって見える。
        // 初回(と、リサイズ・フォント読み込み後の測り直し)は、すべらせずに置く
        const placeThumb = (animate: boolean) => {
            const active = chips.find((c) => c.getAttribute("aria-pressed") === "true");
            if (!active) return;
            if (!animate) thumb.style.transition = "none";
            thumb.style.setProperty("--x", `${active.offsetLeft}px`);
            thumb.style.setProperty("--w", `${active.offsetWidth}px`);
            seg.classList.add("has-thumb");
            if (!animate) {
                void thumb.offsetWidth;
                thumb.style.transition = "";
            }
        };

        const apply = (animate: boolean) => {
            const terms = fold(input.value).split(/\s+/).filter(Boolean);
            const filtering = terms.length > 0 || source !== "all";
            // 絞り込み中は、絞る前の高さを保つ。件数が減ってセクションが縮み、
            // 下のセクションがせり上がって画面が動くのを防ぐ(結果が多いときは自然に伸びる)
            if (filtering && !root.classList.contains("is-filtering")) {
                list.style.minHeight = `${list.offsetHeight}px`;
            } else if (!filtering) {
                list.style.minHeight = "";
            }
            root.classList.toggle("is-filtering", filtering);

            // 年の区切りは毎回作り直す(並び順と絞り込みで、どの行の前に入るかが変わるため)
            rowsEl.querySelectorAll(".year").forEach((el) => el.remove());

            let shown = 0;
            let lastYear = "";
            sequence().forEach((item, i) => {
                const match =
                    (source === "all" || item.source === source) &&
                    terms.every((t) => item.haystack.includes(t));
                const visible = filtering ? match : i < limit;
                item.row.hidden = !visible;
                item.titleEl.innerHTML = visible && filtering ? highlight(item.title, terms) : escapeHtml(item.title);
                // 「特集」(先頭の大きな行)は、新しい順のときの先頭だけ。古い順では付けない
                if (sortBtn) item.row.toggleAttribute("data-featured", !asc && i === 0);
                if (!visible) return;
                item.row.style.setProperty("--i", String(shown));
                if (hasYears && item.year !== lastYear) {
                    lastYear = item.year;
                    const divider = document.createElement("li");
                    divider.className = "year";
                    divider.style.setProperty("--i", String(shown));
                    divider.innerHTML = `<span class="year-label">${item.year}</span>`;
                    rowsEl.insertBefore(divider, item.row);
                }
                shown++;
            });

            if (animate && !reduceMotion.matches) {
                // クラスを付け直して、行が浮かぶアニメーションを頭からやり直す(入れ替わりを見せる)
                root.classList.remove("is-swapping");
                void root.offsetWidth;
                root.classList.add("is-swapping");
            }

            if (more) more.hidden = filtering;
            empty.hidden = !(filtering && shown === 0);
            clearBtn.hidden = input.value === "";
            chips.forEach((chip) =>
                chip.setAttribute("aria-pressed", String(chip.dataset.tlSource === source)),
            );
            placeThumb(animate);
            status.textContent = filtering
                ? `${shown} ${shown === 1 ? "result" : "results"}`
                : items.length > limit
                  ? `Latest ${limit} of ${items.length}`
                  : `${items.length} posts`;
        };

        const onInput = () => apply(true);
        const onClear = () => {
            input.value = "";
            apply(true);
            input.focus();
        };
        const onSort = () => {
            asc = !asc;
            // DOM の順番そのものを入れ替える(行は全部 DOM にあるので、並べ直すだけ)
            rowsEl.append(...sequence().map((item) => item.row));
            sortBtn!.dataset.order = asc ? "asc" : "desc";
            sortBtn!.setAttribute(
                "aria-label",
                asc ? "並び順: 古い順(押すと新しい順)" : "並び順: 新しい順(押すと古い順)",
            );
            if (sortLabel) sortLabel.textContent = asc ? "Oldest" : "Newest";
            apply(true);
        };
        const onChip = (chip: HTMLButtonElement) => () => {
            source = chip.dataset.tlSource!;
            apply(true);
        };
        const chipHandlers = chips.map((chip) => [chip, onChip(chip)] as const);

        // 「/」で検索欄へ、Esc でクリア → もう一度で抜ける
        const onKey = (e: KeyboardEvent) => {
            if (e.key === "/" && !e.metaKey && !e.ctrlKey && !e.altKey) {
                const t = e.target as HTMLElement;
                if (t.closest("input, textarea, select, [contenteditable]")) return;
                e.preventDefault();
                input.focus();
                input.select();
            }
        };
        const onInputKey = (e: KeyboardEvent) => {
            if (e.key !== "Escape") return;
            if (input.value !== "") {
                input.value = "";
                apply(true);
            } else {
                input.blur();
            }
        };

        input.addEventListener("input", onInput);
        input.addEventListener("keydown", onInputKey);
        clearBtn.addEventListener("click", onClear);
        sortBtn?.addEventListener("click", onSort);
        chipHandlers.forEach(([chip, h]) => chip.addEventListener("click", h));
        document.addEventListener("keydown", onKey);

        // 初回表示: 軸が上から伸び、行が順に浮かぶ。見えるところまでスクロールされてから始める
        root.classList.add("is-armed");
        const io = new IntersectionObserver(
            ([entry]) => {
                if (!entry.isIntersecting) return;
                root.classList.add("is-in");
                io.disconnect();
            },
            { threshold: 0.12 },
        );
        io.observe(root);

        apply(false);

        // 台の位置は px で持っているので、幅が変わったとき(リサイズ・Web フォントの読み込み完了)に測り直す
        const ro = new ResizeObserver(() => placeThumb(false));
        ro.observe(seg);
        document.fonts?.ready.then(() => placeThumb(false));

        cleanup = () => {
            ro.disconnect();
            io.disconnect();
            input.removeEventListener("input", onInput);
            input.removeEventListener("keydown", onInputKey);
            clearBtn.removeEventListener("click", onClear);
            sortBtn?.removeEventListener("click", onSort);
            chipHandlers.forEach(([chip, h]) => chip.removeEventListener("click", h));
            document.removeEventListener("keydown", onKey);
            cleanup = null;
        };
    }

    document.addEventListener("astro:page-load", init);
    document.addEventListener("astro:before-swap", () => cleanup?.());
</script>

<style>
    .tl-root {
        --date-w: 6.25rem;
        --node-w: 2.25rem;
        --thumb-w: 15rem;
    }

    /* ---- 検索 + 絞り込みチップ ---- */
    .tools {
        display: grid;
        /* minmax(0, 1fr): 入力欄の固有の幅で列が広がって、スマホで右へはみ出すのを防ぐ */
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
        margin-bottom: 2.5rem;
    }

    /* 検索欄 + 並び替えボタン(あれば)を 1 行に */
    .search-row {
        display: flex;
        gap: 0.75rem;
    }

    .search {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        height: 3rem;
        padding: 0 1rem 0 1.15rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
        color: var(--text-muted);
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease;
    }

    .search:focus-within {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    }

    .search input {
        flex: 1;
        min-width: 0;
        height: 100%;
        padding: 0;
        border: 0;
        outline: 0;
        background: none;
        font: inherit;
        font-size: 0.95rem;
        color: var(--text);
    }

    .search input::placeholder {
        color: var(--text-muted);
        opacity: 0.8;
    }

    /* 「/」で検索欄に飛べるというヒント。入力中や touch 端末では隠す */
    .search kbd {
        display: grid;
        place-items: center;
        width: 1.5rem;
        height: 1.5rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--text-muted);
    }

    .search:focus-within kbd,
    .search:has(.clear:not([hidden])) kbd {
        display: none;
    }

    @media (hover: none) {
        .search kbd {
            display: none;
        }
    }

    .clear {
        display: grid;
        place-items: center;
        width: 1.75rem;
        height: 1.75rem;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: none;
        color: var(--text-muted);
        cursor: pointer;
        transition:
            color 0.2s ease,
            background-color 0.2s ease;
    }

    .clear[hidden] {
        display: none;
    }

    @media (hover: hover) {
        .clear:hover {
            color: var(--text);
            background: var(--elevated);
        }
    }

    /* 並び替えの単ボタン。押すたびに 新しい順 ⇄ 古い順。矢印が半回転して向きが変わる */
    .sort {
        flex: none;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        height: 3rem;
        padding: 0 1.15rem 0 1rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition:
            border-color 0.25s ease,
            color 0.25s ease,
            transform 0.2s ease;
    }

    .sort :global(.sort-arrow) {
        transition: transform 0.45s var(--ease-out);
    }

    .sort[data-order="asc"] :global(.sort-arrow) {
        transform: rotate(180deg);
    }

    .sort:active {
        transform: scale(0.96);
    }

    .sort:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
    }

    @media (hover: hover) {
        .sort:hover {
            border-color: var(--accent);
            color: var(--accent);
        }
    }

    .tool-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1rem;
    }

    /* 掲載先のトグル。枠の中を、白(ライトでは黒)の台が選ばれた項目へすべって移る。
       台の位置・幅は JS が --x / --w に書く。JS が動く前は、選ばれたボタン自身を塗っておく */
    .seg {
        position: relative;
        display: inline-flex;
        max-width: 100%;
        padding: 3px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
