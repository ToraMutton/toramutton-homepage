---
// 全ページ共通のフッター。引き算でシンプルに。
//
//   上端 … 16 進数が左右に流れる 2 行の帯(区切り線の代わり)。ときどき数バイトが光って化ける
//   本文 … 4 列(Index / Last build / Elsewhere / ToraMutton)
import { getVisiblePosts } from "../utils/post";
import { works } from "../data/works";
import { socials } from "../data/home";
import { footerHex } from "../data/footerHex";
import BrandIcon from "./BrandIcon.astro";

// ---- 1 列目: サイトマップ。件数は右肩に小さく出す ----
const postCount = (await getVisiblePosts()).length;
const mainLinks = [
    { href: "/", label: "Top" },
    { href: "/works", label: "Works", count: works.length },
    { href: "/blog", label: "Blog", count: postCount },
    { href: "/about", label: "About" },
];
const otherLinks = [
    { href: "/links", label: "Links" },
    { href: "/advent2026", label: "Advent 2026" },
    // retro は見た目が全く違うページなので、ClientRouter を使わず普通に読み込む
    { href: "/retro/", label: "Retro", reload: true },
];

// ---- 2 列目: 最終ビルド(JST) ----
const buildDate = new Date();
const buildDay = new Intl.DateTimeFormat("ja-JP", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
})
    .format(buildDate)
    .replace(/\//g, "-");
const buildTime = new Intl.DateTimeFormat("ja-JP", {
    timeZone: "Asia/Tokyo",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
}).format(buildDate);
const year = buildDate.getFullYear();

// ---- 上端の 16 進数の帯 ----
// 2 行。それぞれ別の位置からバイト列を切り出す。
// 横に流すので同じ並びを 2 回つなげ、半分ずれたところで継ぎ目なく先頭に戻す
const BYTES = 96;
const bytes = footerHex.replace(/\s+/g, "").match(/.{2}/g) ?? [];
const tickerRows = bytes.length
    ? [0, Math.floor(bytes.length / 2)].map((offset) => {
          const row = Array.from({ length: BYTES }, (_, i) => bytes[(offset + i) % bytes.length]);
          return [...row, ...row];
      })
    : [];
---

<footer class="site-footer" data-footer>
    {
        tickerRows.length > 0 && (
            <div class="ticker" aria-hidden="true">
                {tickerRows.map((row, i) => (
                    <div class:list={["ticker-row", { reverse: i === 1 }]}>
                        <div class="ticker-track">
                            {row.map((b) => (
                                <span>{b}</span>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        )
    }

    <div class="footer-inner">
        <nav class="col" aria-label="サイトマップ">
            <p class="col-label">Index</p>
            <ul class="link-list">
                {
                    mainLinks.map((l) => (
                        <li>
                            <a href={l.href}>
                                {l.label}
                                {l.count !== undefined && <sup>{l.count}</sup>}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <ul class="link-list sub">
                {
                    otherLinks.map((l) => (
                        <li>
                            <a href={l.href} data-astro-reload={l.reload ? true : undefined}>
                                {l.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="col">
            <p class="col-label">Last build</p>
            <p class="mono strong">{buildDay}</p>
            <p class="mono muted">{buildTime} JST</p>
        </div>

        <div class="col">
            <p class="col-label">Elsewhere</p>
            <ul class="link-list social-list">
                {
                    socials.map((s) => (
                        <li>
                            <a
                                href={s.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`social-${s.icon}`}
                            >
                                <BrandIcon name={s.icon} size={14} />
                                <span>{s.name}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div class="col">
            <p class="col-label">ToraMutton</p>
            <p class="muted">UEC / I類 CS Program · MMA</p>
            <p class="muted">
                Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
            </p>
            <p class="muted mono small">&copy; {year} ToraMutton</p>
            <p class="kaomoji">( ∩՞ټ՞∩) ﾝﾌ～～</p>
        </div>
    </div>
</footer>

<script>
    // ---- 16 進数の帯のちらつき ----
    // 0.5〜1.1 秒ごとに 1〜3 バイトが水色に光り、一瞬だけ別の値に化けてから戻る。
    // フッターが見えている間だけ動かす(帯の横移動の CSS アニメーションも止める)
    let stop: (() => void) | null = null;

    function start(footer: HTMLElement) {
        stop?.();
        const cells = Array.from(footer.querySelectorAll<HTMLElement>(".ticker-track span"));
        if (cells.length === 0) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const HEX = "0123456789ABCDEF";
        const randomByte = () => HEX[(Math.random() * 16) | 0] + HEX[(Math.random() * 16) | 0];
        let timer = 0;
        let active = false;

        const glitch = () => {
            const n = 1 + ((Math.random() * 3) | 0);
            for (let k = 0; k < n; k++) {
                const cell = cells[(Math.random() * cells.length) | 0];
                if (cell.classList.contains("is-hot")) continue;
                const original = cell.textContent ?? "";
                cell.textContent = randomByte();
                cell.classList.add("is-hot");
                setTimeout(() => {
                    cell.textContent = original;
                    cell.classList.remove("is-hot");
                }, 380 + Math.random() * 300);
            }
        };

        const loop = () => {
            if (!active) return;
            glitch();
            timer = window.setTimeout(loop, 500 + Math.random() * 600);
        };

        const io = new IntersectionObserver(([entry]) => {
            active = entry.isIntersecting;
            footer.classList.toggle("is-active", active);
            clearTimeout(timer);
            if (active) loop();
        });
        io.observe(footer);

        stop = () => {
            io.disconnect();
            clearTimeout(timer);
            stop = null;
        };
    }

    document.addEventListener("astro:page-load", () => {
        const footer = document.querySelector<HTMLElement>("[data-footer]");
        if (footer) start(footer);
    });
    document.addEventListener("astro:before-swap", () => stop?.());
</script>

<style>
    .site-footer {
        margin-top: auto;
        background: var(--bg-deep);
        color: var(--text);
    }

    /* ---- 16 進数の帯 ---- */
    .ticker {
        display: grid;
        gap: 0.35rem;
        padding: 1.5rem 0;
        overflow: hidden;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        user-select: none;
        /* 左右の端は溶かす */
        mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    }

    .ticker-row {
        overflow: hidden;
        white-space: nowrap;
        opacity: 0.6;
    }

    .ticker-track {
        display: inline-flex;
        gap: 0.9ch;
        animation: ticker 140s linear infinite;
        animation-play-state: paused;
    }

    .ticker-row.reverse .ticker-track {
        animation-direction: reverse;
        animation-duration: 180s;
    }

    .site-footer.is-active .ticker-track {
        animation-play-state: running;
    }

    @keyframes ticker {
        to {
            transform: translateX(-50%);
        }
    }

    .ticker-track span {
        transition:
            color 0.35s ease,
            text-shadow 0.35s ease;
    }

    /* 化けているバイト。アクセント色でほのかに光らせる */
    .ticker-track span.is-hot {
        color: var(--accent);
        text-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent);
        transition: none;
    }

    /* ---- 本文 ---- */
    .footer-inner {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 2.5rem;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 3.5rem 1.5rem 5rem;
    }

    .col p {
        margin: 0 0 0.4rem;
        font-size: 0.9rem;
        line-height: 1.7;
    }

    .col p.col-label {
        margin-bottom: 1.1rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .mono {
        font-family: var(--font-mono);
    }

    .col p.strong {
        font-size: 1.15rem;
        font-weight: 500;
        margin-bottom: 0.1rem;
    }

    .muted {
        color: var(--text-muted);
    }

    .col p.small {
        font-size: 0.78rem;
        margin-top: 1rem;
    }

    .col a {
        color: var(--text);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .link-list {
        display: grid;
        gap: 0.35rem;
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 0.95rem;
    }

    .link-list.sub {
        margin-top: 1.1rem;
        font-size: 0.85rem;
    }

    .link-list.sub a,
    .social-list a {
        color: var(--text-muted);
    }

    .link-list sup {
        margin-left: 0.2rem;
        font-family: var(--font-mono);
        font-size: 0.6rem;
        color: var(--text-muted);
    }

    .social-list a {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        --brand: var(--text);
    }
    .social-list .social-zenn {
        --brand: var(--brand-zenn);
    }
    .social-list .social-qiita {
        --brand: var(--brand-qiita);
    }
    .social-list .social-note {
        --brand: var(--brand-note);
    }

    @media (hover: hover) {
        .col a:hover {
            color: var(--accent);
        }
        .social-list a:hover {
            color: var(--brand);
        }
    }

    .col p.kaomoji {
        margin-top: 0.25rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        opacity: 0.7;
    }

    @media (prefers-reduced-motion: reduce) {
        .ticker-track {
            animation: none;
        }
    }

    /* ---- タブレット・スマホ: 2 列 ---- */
    @media (max-width: 900px) {
        .footer-inner {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            row-gap: 3rem;
        }
    }

    @media (max-width: 520px) {
        .footer-inner {
            padding: 2.5rem 1.25rem 3.5rem;
            gap: 2.5rem 1.5rem;
        }
    }
</style>
