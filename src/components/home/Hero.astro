---
// トップのファーストビュー。
//
// スクロールの仕組み
//   .hero-track は画面より少し縦長で、その中の .hero が sticky で画面に張り付く。
//   張り付いている間のスクロール量を進捗 p(0〜1)にして、右下の三角形を広げる。
//   p = 1 で画面全体が --bg-deep になり、同じ色の Works セクションへ継ぎ目なく続く。
//
// 重なり順(手前ほど数字が大きい):
//   30 … タイトル・時計・スクロール誘導・SNS ドック・草グラフ(三角形と一緒には拡大しない)
//        (スクロール誘導と SNS ドックは ui/ の共通部品。/about のヒーローでも使う)
//   (左のフーリエ波形は FourierRail.astro。ページ全体に固定するので Hero の外にある)
//   15 … 右下の斜め三角形 2 枚(頂点を共有し、斜辺の角度だけ違う。間がスリットになる)
//   10 … 3D キャンバス(メビウスの帯。src/scripts/mobius.ts を後から読み込む)
import ScrollCue from "../ui/ScrollCue.astro";
import SocialDock from "../ui/SocialDock.astro";
import { getContributions } from "../../utils/github";

// ---- GitHub の草 ----
// ドットは細部を見せたいわけではないので、直近 WEEKS 週だけを日曜始まりで切り出す。
// 縦 7 マス(日〜土)× 横 WEEKS 列。三角形の中に欠けずに収まる幅にしてある。
// 数字の方は全体の活動量を見せたいので、直近 1 年の総数を出す
const WEEKS = 16;
const contributions = await getContributions();
const days = contributions.days;
let recent = days;
if (days.length > 0) {
    const last = days[days.length - 1];
    const lastWeekday = new Date(`${last.date}T00:00:00Z`).getUTCDay();
    // 最終週の日曜日から (WEEKS - 1) 週さかのぼった日曜日が先頭
    recent = days.slice(Math.max(0, days.length - (lastWeekday + 1) - (WEEKS - 1) * 7));
}

// ---- 時計(一日の数直線) ----
// 0〜24 時の目盛り 25 本。6 時間ごとの 5 本(00 / 06 / 12 / 18 / 24)は長くして数字を添える。
// 現在時刻のマーカーと、そこまでの塗りは、ブラウザ側のスクリプトが日本時間で動かす
const dayTicks = Array.from({ length: 25 }, (_, h) => ({ h, major: h % 6 === 0 }));
---

<div class="hero-track" data-hero-track>
    <section class="hero" id="top" aria-label="ToraMutton" data-hero>
        <div class="hero-canvas" data-hero-canvas aria-hidden="true"></div>

        <div class="hero-tri hero-tri-a" aria-hidden="true"></div>
        <div class="hero-tri hero-tri-b" aria-hidden="true"></div>

        <!-- 背後の 3D をドラッグできるよう、タイトルはポインター操作を素通しする -->
        <h1 class="hero-title">ToraMutton</h1>

        <!-- 時計: 日本時間。装飾なので読み上げない。ポインターも素通し(背後の 3D をドラッグできるように) -->
        <div class="clock hero-fade" data-clock aria-hidden="true">
            <div class="clock-top">
                <span class="clock-time">
                    <span data-clock-h>--</span><span class="clock-colon">:</span><span data-clock-m>--</span><span class="clock-sec"><span class="clock-colon">:</span><span data-clock-s>--</span></span>
                </span>
                <span class="clock-zone">JST</span>
                <span class="clock-date" data-clock-date></span>
            </div>
            <div class="day">
                <span class="day-fill" data-day-fill></span>
                {dayTicks.map((t) => <span class:list={["day-tick", { major: t.major }]} style={`--x: ${(t.h / 24) * 100}%`} data-day-tick />)}
                <span class="day-now" data-day-now></span>
            </div>
            <div class="day-labels">
                {dayTicks.filter((t) => t.major).map((t) => <span style={`--x: ${(t.h / 24) * 100}%`}>{String(t.h).padStart(2, "0")}</span>)}
            </div>
        </div>

        <ScrollCue href="#works" />

        {
            recent.length > 0 && (
                <a
                    class="grass hero-fade"
                    href="https://github.com/toramutton"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`GitHub: 直近1年で ${contributions.total} contributions`}
                >
                    <span class="grass-total">{contributions.total.toLocaleString("en-US")}</span>
                    <span class="grass-grid" aria-hidden="true">
                        {recent.map((day) => (
                            <span class={`grass-cell lv-${day.level}`} />
                        ))}
                    </span>
                </a>
            )
        }

        <SocialDock />
    </section>
</div>

<script>
    import type { MobiusHandle } from "../../scripts/mobius";
    import { bindHeroScroll } from "../../scripts/hero-scroll";

    let handle: MobiusHandle | null = null;
    let cleanupScroll: (() => void) | null = null;

    // ---- 3D: three(数百KB)は初期表示に要らないので、ブラウザが暇になってから読み込む ----
    function mountMobius() {
        const el = document.querySelector<HTMLElement>("[data-hero-canvas]");
        if (!el || handle) return;
        const start = () =>
            import("../../scripts/mobius").then((m) => {
                // 読み込み中に別ページへ移動していたら何もしない
                if (document.contains(el) && !handle) handle = m.mountMobius(el);
            });
        if ("requestIdleCallback" in window) {
            requestIdleCallback(start, { timeout: 1200 });
        } else {
            setTimeout(start, 150);
        }
    }

    // ---- スクロールで三角形を広げる ----
    // 進捗(--p / --e)の計算は src/scripts/hero-scroll.ts(/about のヒーローと共通)
    function bindScroll() {
        const track = document.querySelector<HTMLElement>("[data-hero-track]");
        const hero = document.querySelector<HTMLElement>("[data-hero]");
        if (!track || !hero) return;
        cleanupScroll = bindHeroScroll({
            track,
            hero,
            // 覆い切ったらメビウスは見えないので描画を止める
            onProgress: (p) => handle?.setSuspended(p >= 0.999),
        });
    }

    // ---- 時計: 日本時間を秒ごとに更新する ----
    // 時刻の文字・日付・「一日のどこまで進んだか」(0〜1)を、Intl で日本時間として取り出す。
    // 端末のタイムゾーンに関係なく、いつも JST を出す(閲覧者が海外でも「トラマトの今」が分かる)。
    const jst = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Asia/Tokyo",
        hourCycle: "h23",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        month: "2-digit",
        day: "2-digit",
        weekday: "short",
    });
    let clockTimer = 0;

    function bindClock() {
        const root = document.querySelector<HTMLElement>("[data-clock]");
        if (!root) return;
        const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
        const h = q("[data-clock-h]");
        const m = q("[data-clock-m]");
        const sec = q("[data-clock-s]");
        const date = q("[data-clock-date]");
        const fill = q("[data-day-fill]");
        const now = q("[data-day-now]");
        const ticks = Array.from(root.querySelectorAll<HTMLElement>("[data-day-tick]"));
        let lastHour = -1;

        const tick = () => {
            const parts: Record<string, string> = {};
            for (const p of jst.formatToParts(new Date())) parts[p.type] = p.value;
            const hh = Number(parts.hour);
            const mm = Number(parts.minute);
            const ss = Number(parts.second);
            h.textContent = parts.hour;
            m.textContent = parts.minute;
            sec.textContent = parts.second;
            date.textContent = `${parts.month}.${parts.day} ${parts.weekday.toUpperCase()}`;

            // 一日のどこまで進んだか(0〜1)。マーカーと塗りは同じ割合で動く
            const day = (hh * 3600 + mm * 60 + ss) / 86400;
            root.style.setProperty("--day", day.toFixed(5));

            // 通り過ぎた時間の目盛りは、アクセント色で点灯させる(1 時間ごとに更新)
            if (hh !== lastHour) {
                lastHour = hh;
                ticks.forEach((t, i) => t.classList.toggle("is-past", i <= hh));
            }
            root.classList.add("is-live");
            // 次の「秒の切り替わり」にぴったり合わせて呼ぶ(setInterval だとだんだんズレて、秒が飛んで見える)
            clockTimer = window.setTimeout(tick, 1000 - (Date.now() % 1000) + 5);
        };
        tick();
    }

    document.addEventListener("astro:page-load", () => {
        mountMobius();
        bindScroll();
        bindClock();
    });
    document.addEventListener("astro:before-swap", () => {
        handle?.destroy();
        handle = null;
        cleanupScroll?.();
        cleanupScroll = null;
        clearTimeout(clockTimer);
    });
</script>

<style>
    /* 画面 1 枚ぶん + 三角形を広げるためのスクロール量 */
    .hero-track {
        position: relative;
        height: 165dvh;
    }

    .hero {
        --p: 0;
        --e: 0;
        position: sticky;
        top: 0;
        height: 100dvh;
        min-height: 560px;
        overflow: hidden;
        background: var(--bg);
    }

    .hero-canvas {
        position: absolute;
        inset: 0;
        z-index: 10;
        opacity: 0;
        transition: opacity 1.2s var(--ease-out);
    }

    /* mobius.ts が最初のフレームを描いたら付ける(一度だけのフェードイン) */
    .hero-canvas:global(.is-ready) {
        opacity: 1;
    }

    /* スクロール連動で沈めるのは中の canvas の方。入れ物と同じ opacity に掛けると、
       スクロールのたびにフェードインのトランジションがやり直しになってしまう */
    .hero-canvas :global(canvas) {
        display: block;
        width: 100%;
        height: 100%;
        opacity: calc(1 - var(--e) * 0.5);
    }

    /* ---- 斜め三角形 2 枚 ----
       どちらも頂点 (100%, 50%) と右下の角を共有し、底辺の長さ(= 斜辺の角度)だけ違う。
         A: なだらかな方。底辺は 57% から
         B: 急な方。底辺は 72% から
       A は B と重ならないよう 71.4% で止めて、0.6% ぶんのすき間をスリットにする
       (頂点に近づくほど細くなり、頂点で消える)。
       スクロールすると右下の角を中心に拡大する。B の方が速く広がるので、途中で A を飲み込む。 */
    .hero-tri {
        position: absolute;
        inset: 0;
        z-index: 15;
        background: var(--bg-deep);
        transform-origin: 100% 100%;
        pointer-events: none;
        will-change: transform;
    }

    .hero-tri-a {
        clip-path: polygon(100% 50%, 71.4% 100%, 57% 100%);
        transform: scale(calc(1 + var(--e) * 2.2));
    }

    .hero-tri-b {
        clip-path: polygon(100% 50%, 100% 100%, 72% 100%);
        /* 1/0.28 + 1/0.5 ≈ 5.6 倍で画面全体を覆う。p = 1 でちょうど覆い切るよう 5.9 倍まで */
        transform: scale(calc(1 + var(--e) * 4.9));
    }

    /* 三角形と一緒に拡大しないもの(文字やアイコン)は、広がるにつれて消す */
    .hero-fade {
        opacity: calc(1 - var(--p) * 2.5);
    }

    /* 見えなくなったリンクを押せないようにする */
    .hero.is-covered .hero-fade {
        visibility: hidden;
    }

    /* ---- 草グラフ(内側の三角形 B の中) ---- */
    .grass {
        position: absolute;
        right: clamp(1rem, 3vw, 2.5rem);
        bottom: 5.25rem;
        z-index: 30;
        display: grid;
        justify-items: end;
        gap: 0.4rem;
        color: var(--text-muted);
        text-decoration: none;
    }

    .grass-total {
        font-family: var(--font-mono);
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1;
        color: var(--text);
        transition: color 0.2s ease;
    }

    .grass:hover .grass-total,
    .grass:focus-visible .grass-total {
        color: var(--accent);
    }

    .grass-grid {
        --cell: 7px;
        display: grid;
        grid-template-rows: repeat(7, var(--cell));
        grid-auto-flow: column;
        grid-auto-columns: var(--cell);
        gap: 2px;
    }

    .grass-cell {
        border-radius: 1.5px;
        background: color-mix(in srgb, var(--text) 7%, transparent);
    }

    /* 色は増やさず、アクセント 1 色の濃さで段階を出す */
    .lv-1 {
        background: color-mix(in srgb, var(--accent) 30%, transparent);
    }
    .lv-2 {
        background: color-mix(in srgb, var(--accent) 52%, transparent);
    }
    .lv-3 {
        background: color-mix(in srgb, var(--accent) 76%, transparent);
    }
    .lv-4 {
        background: var(--accent);
    }

    /* ---- タイトル ---- */
    .hero-title {
        position: absolute;
        top: 50%;
        right: clamp(1.5rem, 8vw, 9rem);
        z-index: 30;
        margin: 0;
        transform: translateY(calc(-50% - var(--e) * 6vh));
        opacity: calc(1 - var(--e) * 1.6);
        font-family: var(--font-mono);
        font-size: clamp(2.75rem, 8vw, 7rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1;
        color: var(--text);
        pointer-events: none;
        user-select: none;
    }

    /* ---- 時計(一日の数直線) ----
       ヘッダー(固定 72px)の下、右上に置く。右端はタイトルの右端にそろえる。
       数字の下に 0〜24 時の目盛りを引き、いまの時刻の位置にマーカー、そこまでの線をアクセント色で塗る。
       ( --day は 0〜1。スクリプトが秒ごとに入れる ) */
    .clock {
        --day: 0;
        position: absolute;
        top: calc(72px + clamp(1.25rem, 3.5vh, 2.5rem));
        right: clamp(1.5rem, 8vw, 9rem);
        z-index: 30;
        width: clamp(230px, 24vw, 340px);
        font-family: var(--font-mono);
        color: var(--text-muted);
        pointer-events: none;
        user-select: none;
        /* スクリプトが最初の時刻を入れるまでは見せない(0 時の位置から飛んでくるのを防ぐ) */
        visibility: hidden;
    }

    .clock.is-live {
        visibility: visible;
    }

    /* 三角形が広がって見えなくなったら、visibility の方は .hero-fade の規則に任せる */
    .hero.is-covered .clock {
        visibility: hidden;
    }

    .clock-top {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        margin-bottom: 0.9rem;
    }

    .clock-time {
        font-size: clamp(1.3rem, 1.9vw, 1.75rem);
        font-weight: 500;
        letter-spacing: 0.04em;
        line-height: 1;
        color: var(--text);
        /* 数字の幅がそろうので、秒が変わっても横にガタつかない */
        font-variant-numeric: tabular-nums;
    }

    .clock-colon {
        display: inline-block;
        margin: 0 0.04em;
        animation: colon-pulse 2s ease-in-out infinite;
    }

    @keyframes colon-pulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.25;
        }
    }

    .clock-zone {
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        color: var(--accent);
    }

    .clock-date {
        margin-left: auto;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
    }

    .day {
        position: relative;
        height: 16px;
        border-bottom: 1px solid color-mix(in srgb, var(--text-muted) 55%, transparent);
    }

    /* 一日のうち、すでに過ぎた分 */
    .day-fill {
        position: absolute;
        left: 0;
        bottom: -1px;
        width: calc(var(--day) * 100%);
        height: 1px;
        background: var(--accent);
    }

    .day-tick {
        position: absolute;
        bottom: 0;
        left: var(--x);
        width: 1px;
        height: 5px;
        background: color-mix(in srgb, var(--text-muted) 55%, transparent);
        transition: background-color 0.6s ease;
    }

    .day-tick.major {
        height: 10px;
    }

    .day-tick.is-past {
        background: var(--accent);
    }

    /* いまの時刻。細い縦線 + 光のにじみ */
    .day-now {
        position: absolute;
        bottom: -1px;
        left: calc(var(--day) * 100%);
        width: 2px;
        height: 16px;
        margin-left: -1px;
        background: var(--accent-glow);
        box-shadow: 0 0 8px 1px color-mix(in srgb, var(--accent) 70%, transparent);
    }

    .day-labels {
        position: relative;
        height: 1em;
        margin-top: 0.45rem;
        font-size: 0.62rem;
        letter-spacing: 0.1em;
        opacity: 0.8;
    }

    .day-labels span {
        position: absolute;
        left: var(--x);
        transform: translateX(-50%);
    }

    @media (prefers-reduced-motion: reduce) {
        .clock-colon {
            animation: none;
        }
        .hero-canvas {
            transition: none;
        }
    }

    /* 三角形が狭くなる中間の幅では、草を直近 10 週に減らして欠けないようにする */
    @media (max-width: 1180px) {
        .grass-cell:nth-child(-n + 42) {
            display: none;
        }
    }

    /* ---- モバイル: タイトルを中央に、三角形は控えめに、草は省く ---- */
    @media (max-width: 768px) {
        .hero-title {
            right: 50%;
            transform: translate(50%, calc(-50% - var(--e) * 6vh));
        }

        .hero-tri-a {
            clip-path: polygon(100% 72%, 66% 100%, 24% 100%);
        }

        .hero-tri-b {
            clip-path: polygon(100% 72%, 100% 100%, 67% 100%);
            /* 縦長画面は底辺が短いので、もっと大きくしないと覆い切れない */
            /* 1/0.33 + 1/0.28 ≈ 6.6 倍 */
            transform: scale(calc(1 + var(--e) * 5.9));
        }

        .grass {
            display: none;
        }

        /* スマホ: 中央に寄せ、秒を省いて短くする(分まで) */
        .clock {
            right: 50%;
            width: min(70vw, 260px);
            transform: translateX(50%);
        }

        .clock-sec {
            display: none;
        }
    }
</style>
