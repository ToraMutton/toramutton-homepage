---
// 全ページ共通のヘッダー。
//   左: マスコットのロゴ(押すといつでもトップへ)
//   右: Home / Blog / About + テーマダイアル(ThemeDial.astro)
//   スマホ幅(≤720px)では、この 3 つの横並びが、円形 FAB から扇状に開くメニューに変わる
//   (部品は ui/FabFan.astro。/blog の並び替えなどと共通)。PC 幅では FAB は出ない。
//
// 現在地の下線(.nav-indicator)は、今いるページのリンクの中にだけ描く。
// transition:name を付けてあるので、ClientRouter でページを移ると
// 「前のページの下線の位置 → 新しいページの下線の位置」へ自動で滑らかに動く。
import { BookOpenText, House, Menu, PenLine, User, X } from "lucide-astro";
import Mascot from "../assets/profile/toramutton-line.svg";
import FabFan from "./ui/FabFan.astro";
import ThemeDial from "./ThemeDial.astro";

const nav = [
    { href: "/", label: "Home", icon: House },
    { href: "/blog", label: "Blog", icon: PenLine },
    { href: "/about", label: "About", icon: User },
];

// /blog/xxx のような下層ページでも、親(/blog)を現在地として扱う
const first = Astro.url.pathname.split("/").filter(Boolean)[0];
const current = first ? `/${first}` : "/";

// スマホ用の扇メニューの項目(上の nav と同じ中身 + 現在地)
const fanItems = nav.map((item) => ({ ...item, active: item.href === current }));
---

<header id="site-header">
    <nav>
        <a href="/" class="logo" aria-label="トップへ戻る" data-logo>
            <Mascot class="logo-mark" aria-hidden="true" />
        </a>

        <div id="nav-links" class="internal-links">
            {
                nav.map((item) => {
                    const active = item.href === current;
                    return (
                        <a
                            href={item.href}
                            class:list={["nav-link", { active }]}
                            aria-current={active ? "page" : undefined}
                        >
                            {item.label}
                            {active && (
                                <span
                                    class="nav-indicator"
                                    transition:name="nav-indicator"
                                    aria-hidden="true"
                                />
                            )}
                        </a>
                    );
                })
            }
        </div>

        <div class="controls-group">
            <ThemeDial />

            <button id="toc-toggle" class="toc-toggle ctrl-btn" aria-label="目次を開く">
                <div class="icon-container-toc">
                    <span class="icon-toc-open"><BookOpenText size={20} /></span>
                    <span class="icon-toc-close"><X size={20} /></span>
                </div>
            </button>

            <!-- 扇は真下〜左下に開く(左へ振りすぎると、隣のテーマダイアルに重なる) -->
            <FabFan
                class="header-fan"
                items={fanItems}
                label="メニューを開く"
                icon={Menu}
                start={92}
                end={150}
                radius={130}
            />
        </div>
    </nav>
</header>

<script>
    // backdrop のヘルパー
    function getOrCreateBackdrop(): HTMLElement {
        let backdrop = document.getElementById("toc-backdrop");
        if (!backdrop) {
            backdrop = document.createElement("div");
            backdrop.id = "toc-backdrop";
            document.body.appendChild(backdrop);
        }
        return backdrop;
    }

    function closeToc(tocSidebar: Element, tocToggle: HTMLElement) {
        tocSidebar.classList.remove("mobile-open");
        tocToggle.classList.remove("active");
        const backdrop = document.getElementById("toc-backdrop");
        if (backdrop) backdrop.classList.remove("visible");
    }

    // ---- スクロールしたらヘッダーに背景を付ける ----
    // トップページでは、ヒーロー(三角形が広がる区間)を抜けるまでは透明のまま
    let detachScroll: (() => void) | null = null;
    function bindHeaderScroll(header: HTMLElement) {
        detachScroll?.();
        const update = () => {
            const track = document.querySelector<HTMLElement>("[data-hero-track]");
            const threshold = track
                ? track.offsetTop + track.offsetHeight - header.offsetHeight
                : 8;
            header.classList.toggle("is-scrolled", window.scrollY > threshold);
        };
        window.addEventListener("scroll", update, { passive: true });
        update();
        detachScroll = () => window.removeEventListener("scroll", update);
    }

    document.addEventListener("astro:page-load", () => {
        // ページ遷移時に残留 backdrop をクリーンアップ
        const stale = document.getElementById("toc-backdrop");
        if (stale) stale.remove();

        const header = document.getElementById("site-header");
        if (header) bindHeaderScroll(header);

        // --- ロゴ: トップにいるときは読み込み直さず、上までスクロールして戻る ---
        const logo = document.querySelector<HTMLAnchorElement>("[data-logo]");
        if (logo) {
            logo.onclick = (e) => {
                if (location.pathname !== "/") return;
                e.preventDefault();
                const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
            };
        }

        // --- 0. 目次トグル ---
        const tocToggle = document.getElementById("toc-toggle");
        const tocSidebar = document.querySelector(".blog-toc");
        if (tocToggle && tocSidebar) {
            tocToggle.classList.add("has-toc");
            tocToggle.onclick = () => {
                const isOpening = !tocSidebar.classList.contains("mobile-open");
                tocSidebar.classList.toggle("mobile-open");
                tocToggle.classList.toggle("active");

                const backdrop = getOrCreateBackdrop();
                if (isOpening) {
                    backdrop.classList.add("visible");
                    // バックドロップクリックで閉じる
                    backdrop.onclick = () => closeToc(tocSidebar, tocToggle as HTMLElement);
                } else {
                    backdrop.classList.remove("visible");
                }

                // 扇メニューが開いていたら閉じる
                document.dispatchEvent(new CustomEvent("fab-fan:close"));
            };
        }

        // --- 1. 扇メニュー(ui/FabFan.astro)を開いたら、目次ドロワーは閉じる ---
        // 扇は ClientRouter のページ差し替えで入れ替わるので、ここでの登録は積み重ならない
        document.querySelector("[data-fab-fan]")?.addEventListener("fab-fan:open", () => {
            if (tocSidebar && tocToggle) closeToc(tocSidebar, tocToggle as HTMLElement);
        });
    });
</script>

<style>
    /* === 基本設定 === */
    header {
        --header-height: 72px;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 9999;
        margin: 0;
        padding: 0 clamp(1rem, 3vw, 2.5rem);
        background: transparent;
        border-bottom: 1px solid transparent;
        transition:
            border-color 0.3s ease,
            background-color 0.3s ease,
            backdrop-filter 0.3s ease;
    }

    /* ヒーローを抜けた後(他のページではスクロールし始めたら)は背景を付けて読みやすくする */
    header.is-scrolled {
        background: color-mix(in srgb, var(--bg-deep) 82%, transparent);
        backdrop-filter: blur(10px);
        border-bottom-color: var(--border);
    }

    nav {
        display: flex;
        align-items: center;
        height: var(--header-height);
        position: relative;
    }

    .internal-links {
        margin-left: auto;
    }

    .controls-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: 1.75rem;
        flex-shrink: 0;
        z-index: 1001;
    }

    /* === ロゴ(マスコット) === */
    .logo {
        display: block;
        color: var(--text);
        border-radius: 12px;
        transition:
            color 0.25s ease,
            transform 0.35s var(--ease-out);
        z-index: 1001;
    }

    /* 横長の絵。場所取りは 40px のままにして左右に 7px ずつはみ出させ、
       中心をずらさない(真下の FourierRail が 40px 幅を前提に位置を決めている) */
    .logo-mark {
        display: block;
        width: 54px;
        height: 40px;
        margin: 0 -7px;
    }

    @media (hover: hover) {
        .logo:hover {
            color: var(--accent);
            transform: rotate(-8deg);
        }
    }

    .logo:focus-visible {
        color: var(--accent);
        outline: 2px solid var(--accent);
        outline-offset: 3px;
    }

    /* === ナビリンク(PC) === */
    .internal-links {
        display: flex;
        gap: 1.9rem;
    }

    .nav-link {
        position: relative;
        padding: 0.5rem 0;
        font-family: var(--font-mono);
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .nav-link.active {
        color: var(--text);
    }

    @media (hover: hover) {
        .nav-link:hover {
            color: var(--accent);
        }
    }

    /* 現在地の短い下線。ページ移動時は transition:name で前の位置から滑ってくる */
    .nav-indicator {
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 1.4rem;
        height: 2px;
        margin-left: -0.7rem;
        border-radius: 1px;
        background: var(--accent);
    }

    /* 下線の移動アニメーションの速さと加減速 */
    :global(::view-transition-group(nav-indicator)) {
        animation-duration: 0.45s;
        animation-timing-function: var(--ease-out);
    }

    /* === コントロールボタン共通 === */
    .ctrl-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        outline: none;
        cursor: pointer;
        color: inherit;
        padding: 0;
        width: 40px;
        height: 40px;
        border-radius: var(--radius);
        transition:
            background 0.2s,
            color 0.2s;
    }
    @media (hover: hover) {
        .ctrl-btn:hover {
            background: color-mix(in srgb, var(--accent) 12%, transparent);
            color: var(--accent);
        }
    }
    .ctrl-btn:active {
        transform: scale(0.92);
        background: color-mix(in srgb, var(--accent) 18%, transparent);
    }

    /* === TOC トグル(扇メニューの丸ボタンと同じ見た目) === */
    .toc-toggle {
        display: none;
        width: 44px;
        height: 44px;
        flex: none;
        border: 1px solid var(--border);
        border-radius: 50%;
        background: color-mix(in srgb, var(--surface) 88%, transparent);
        color: var(--text);
    }
    .icon-container-toc {
        position: relative;
        width: 20px;
        height: 20px;
    }
    .icon-toc-open,
    .icon-toc-close {
        position: absolute;
        top: 0;
        left: 0;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .icon-toc-open {
        opacity: 1;
        transform: rotate(0deg) scale(1);
    }
    .icon-toc-close {
        opacity: 0;
        transform: rotate(-90deg) scale(0.5);
    }
    .toc-toggle.active .icon-toc-open {
        opacity: 0;
        transform: rotate(90deg) scale(0.5);
    }
    .toc-toggle.active .icon-toc-close {
        opacity: 1;
        transform: rotate(0deg) scale(1);
    }
    .toc-toggle.active {
        border-color: var(--accent);
        color: var(--accent);
    }
    /* 記事ページの目次は 1024px 以上で常時表示。それ未満はこのボタンでドロワー */
    @media (max-width: 1023px) {
        .toc-toggle.has-toc {
            display: flex;
        }
    }

    /* === 扇メニュー(スマホ幅だけ) ===
       PC 幅では横並びのリンクを使うので、FAB は出さない */
    /* FabFan は別コンポーネントなので、ヘッダー側の CSS から触るには :global が要る */
    :global(.header-fan) {
        display: none;
    }

    /* === スマホ・タブレット(≤720px) === */
    @media (max-width: 720px) {
        .ctrl-btn {
            width: 44px;
            height: 44px;
        }

        :global(.header-fan) {
            display: block;
        }

        /* 横並びのリンクは隠し、代わりに FAB を右端に出す。controls-group を右へ押しやる */
        .internal-links {
            display: none;
        }

        .controls-group {
            margin-left: auto;
        }
    }

    /* ===
        TOC バックドロップ
        .blog-toc が開いたとき、コンテンツエリアを薄く dim する
        ヘッダー (z 9999) の下、TOC パネル (z 1000) の下
    === */
    :global(#toc-backdrop) {
        position: fixed;
        top: 72px; /* ヘッダーは dim しない */
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.18s ease;
    }
    :global(#toc-backdrop.visible) {
        opacity: 1;
        pointer-events: auto;
    }
    @media (prefers-reduced-motion: reduce) {
        :global(#toc-backdrop) {
            transition: none;
        }
        .logo {
            transition: none;
        }
    }
</style>
