---
export const prerender = true;
import { getCollection } from "astro:content";
import Layout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import BrandIcon from "../components/BrandIcon.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/toramutton.jpg";
import pcDesktopImg from "../assets/desktop/fastfetch.jpeg";
import pcCaseImg from "../assets/desktop/trapezium-8.png";
// note / Zenn / Qiita の取得は src/utils/feeds.ts に集約している
import { getExternalPosts } from "../utils/feeds";
import { adventCalendar, adventDays } from "../data/advent2026";
import { resolveAdventEntry } from "../utils/advent";
import {
    Sparkles,
    Target,
    Cpu,
    Music,
    Timer,
    GitGraph,
    User,
    Link,
    Palette,
} from "lucide-astro";
// 表示する中身は src/data/home.ts にまとめてある
import {
    heroUser,
    heroSpecs,
    socials,
    heroPalette,
    terminalCommands,
    missions,
    uptimes,
} from "../data/home";
import { asciiAvatar } from "../data/asciiAvatar";
import { songs } from "../data/songs";

// fastfetch の 2 行目のアンダーライン(user@host と同じ長さ)
const heroTitle = `${heroUser.user}@${heroUser.host}`;
const heroRule = "-".repeat(heroTitle.length);
// SOCIAL の値は URL の末尾を @ID にする
const handle = (url: string) =>
    `@${new URL(url).pathname.split("/").filter(Boolean).pop()}`;

// === 記事一覧 ===
const isDev = import.meta.env.DEV;

// ローカル記事（下書きは dev でだけ見える）
const localPostsRaw = await getCollection('blog', ({ data }) => {
    return isDev || data.draft !== true;
});

const localPosts = localPostsRaw.map((post) => ({
    title: post.data.title,
    url: `/blog/${post.id}/`,
    date: post.data.pubDate,
    image: post.data.heroImage,
    tags: post.data.tags,
    source: 'local' as const,
}));

// note / Zenn / Qiita。取得は src/utils/feeds.ts に集約している
const externalPosts = await getExternalPosts();

// 統合・ソート・抽出
const latestPosts = [...localPosts, ...externalPosts]
    .sort((a, b) => b.date.valueOf() - a.date.valueOf())
    .slice(0, 10); // 最新記事、10選

// marquee のサムネは 280px 枠(2x で 560px)。元画像がそれより小さいときは
// 拡大すると逆に重くなるので、上限としてだけ使う
const THUMB_W = 560;

// === GitHub Contributions取得 ===
type ContributionDay = { date: string; count: number; level: number };
let ghContributions: ContributionDay[] = [];
let ghTotal = 0;
try {
    const ghRes = await fetch(
        "https://github-contributions-api.jogruber.de/v4/toramutton?y=last",
    );
    const ghData = await ghRes.json();
    ghTotal = ghData.total?.lastYear || 0;
    ghContributions = ghData.contributions || [];
} catch (e) {
    console.error("GitHub contributions fetch failed", e);
}
// 取得できた分は全部表示(y=last で約1年分)。カード自体が横長になったので出し切る
const contributionHistory = ghContributions;

// ランダムで3つ選ぶ（重複なし）
const shuffled = [...terminalCommands].sort(() => Math.random() - 0.5);
const selectedCommands = shuffled.slice(0, 3);

const today = new Date();
// バーグラフは固定365日を100%とした「残量ゲージ」。日が近づくほど縮む
const MISSION_WINDOW_DAYS = 365;
const missionData = missions.map((m) => {
    const target = new Date(m.date);
    const diff = target.getTime() - today.getTime();
    const days = Math.ceil(diff / (1000 * 60 * 60 * 24));
    const p = Math.min(Math.max(days, 0) / MISSION_WINDOW_DAYS, 1);
    return { ...m, days, p };
});

// === Advent 2026 カウントダウン ===
// 開催開始日(12/1)までの日数と、公開済みの日数を出しておく
const ADVENT_START = new Date(`${adventCalendar.year}-12-01T00:00:00+09:00`);
const adventDaysLeft = Math.ceil(
    (ADVENT_START.getTime() - today.getTime()) / (1000 * 60 * 60 * 24),
);
const resolvedAdventDays = adventDays
    .map((entry) => resolveAdventEntry(entry, localPostsRaw))
    .sort((a, b) => a.day - b.day);
const adventOpenCount = resolvedAdventDays.filter((entry) => entry.url).length;

// 円形グラフ: 25日分を円周上のセグメントにする(12時の位置から時計回り)
const RING_R = 40;
const RING_C = 50;
const RING_GAP_DEG = 3.5;
const ringPolar = (deg: number) => {
    const rad = ((deg - 90) * Math.PI) / 180;
    return [RING_C + RING_R * Math.cos(rad), RING_C + RING_R * Math.sin(rad)];
};
const ringStep = 360 / adventDays.length;
const ringSegments = resolvedAdventDays.map((d, i) => {
    const [x0, y0] = ringPolar(i * ringStep + RING_GAP_DEG / 2);
    const [x1, y1] = ringPolar((i + 1) * ringStep - RING_GAP_DEG / 2);
    return {
        day: d.day,
        status: d.url ? "open" : "locked",
        d: `M ${x0.toFixed(2)} ${y0.toFixed(2)} A ${RING_R} ${RING_R} 0 0 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`,
    };
});

---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
            <!-- hero: fastfetch 風。`$ fastfetch` を打つと、左の ASCII アートと
                 右の情報が上から同時に流れる(JS: playHero)。
                 user@host をクリックすると最初から打ち直す -->
            <section class="hero" data-hero>
                <div class="session" data-session>
                    <p class="line">
                        <span class="prompt">$</span>
                        <span class="cmd" data-type>fastfetch</span>
                    </p>

                    <div class="ff" data-ff>
                        <!-- 左: アバターの ASCII アート(scripts/ascii-avatar.mjs) -->
                        <pre class="ff-logo" aria-hidden="true" data-ff-logo>{
                            asciiAvatar.map((row) => (
                                <span class="line ff-logo-row">{row}</span>
                            ))
                        }</pre>

                        <!-- 右: 情報 -->
                        <div class="ff-info" data-ff-info>
                            <p class="line ff-head">
                                <button
                                    type="button"
                                    class="ff-user"
                                    data-replay
                                    title="もう一度打つ"
                                >
                                    <Image
                                        src={heroImage}
                                        alt=""
                                        class="ff-avatar"
                                        width={80}
                                        height={80}
                                    />
                                    <span class="ff-user-name">{heroUser.user}</span
                                    ><span class="ff-user-at">@</span><span
                                        class="ff-user-name">{heroUser.host}</span
                                    >
                                </button>
                            </p>
                            <p class="line ff-rule" aria-hidden="true">
                                {heroRule}
                            </p>

                            <p class="line ff-section">
                                <User size={14} />
                                <span class="ff-section-name">USER</span>
                                <span class="ff-section-dots" aria-hidden="true"
                                ></span>
                            </p>
                            {
                                heroSpecs.map((spec) => (
                                    <p class="line ff-row">
                                        <spec.icon size={14} />
                                        <span class="ff-key">{spec.key}</span>
                                        {spec.kind === "clock" ? (
                                            <span
                                                class="ff-val"
                                                data-clock
                                                set:text="--:--:--"
                                            />
                                        ) : spec.copy ? (
                                            <button
                                                type="button"
                                                class="ff-val ff-copy"
                                                data-copy={spec.value}
                                                aria-label={`${spec.key} をコピー`}
                                            >
                                                <span set:text={spec.value} />
                                                <span
                                                    class="ff-copied"
                                                    aria-hidden="true"
                                                    set:text="copied"
                                                />
                                            </button>
                                        ) : (
                                            <span class="ff-val">
                                                {spec.live && (
                                                    <span class="dot-live" />
                                                )}
                                                <span set:text={spec.value} />
                                            </span>
                                        )}
                                    </p>
                                ))
                            }

                            <p class="line ff-section">
                                <Link size={14} />
                                <span class="ff-section-name">SOCIAL</span>
                                <span class="ff-section-dots" aria-hidden="true"
                                ></span>
                            </p>
                            {
                                socials.map((s) => (
                                    <p class="line ff-row">
                                        <BrandIcon name={s.icon} size={14} />
                                        <span class="ff-key">{s.name}</span>
                                        <a
                                            href={s.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="ff-val ff-link"
                                            set:text={handle(s.url)}
                                        />
                                    </p>
                                ))
                            }

                            <p class="line ff-section">
                                <Palette size={14} />
                                <span class="ff-section-name">PALETTE</span>
                                <span class="ff-section-dots" aria-hidden="true"
                                ></span>
                            </p>
                            <p class="line ff-palette" aria-hidden="true">
                                {
                                    heroPalette.map((v) => (
                                        <span
                                            class="ff-swatch"
                                            style={`color: var(${v})`}
                                            title={v}
                                        >
                                            ██
                                        </span>
                                    ))
                                }
                            </p>
                        </div>
                    </div>

                    <p class="line line-blank"></p>
                    <p class="line">
                        <span class="prompt">$</span>
                        <a href="/about" class="cmd cmd-link">
                            <span data-type>cd ./about</span><span
                                class="cursor-arrow">→</span
                            >
                        </a>
                    </p>
                </div>
            </section>

            <section class="recent-posts" data-reveal>
                <SectionHeading>
                    最新の記事
                    <a href="/blog" class="view-all" slot="aside"
                        >すべての記事を見る →</a
                    >
                </SectionHeading>
                <!-- marquee outer: 実スクロールコンテナ。自動送りは JS が
                     scrollLeft を進めるだけなので、掴んで動かすことも
                     ホイール/トラックパッド/スワイプで動かすこともできる -->
                <div class="marquee-outer" id="marquee-outer">
                    <div class="marquee-track" id="marquee-track">
                        {
                            latestPosts.map((post, i) => (
                                <a
                                    href={post.url}
                                    class="post-card-mini ui-card ui-card-link"
                                    style={`--i:${i}`}
                                    target={
                                        post.source !== "local"
                                            ? "_blank"
                                            : "_self"
                                    }
                                    rel={
                                        post.source !== "local"
                                            ? "noopener noreferrer"
                                            : undefined
                                    }
                                >
                                    <div class="post-thumb">
                                        {post.source === "local" &&
                                        typeof post.image === "object" ? (
                                            <Image
                                                src={post.image}
                                                alt=""
                                                width={Math.min(
                                                    THUMB_W,
                                                    post.image.width,
                                                )}
                                            />
                                        ) : post.image &&
                                          typeof post.image === "string" ? (
                                            <img
                                                src={post.image}
                                                alt=""
                                                width="560"
                                                height="315"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        ) : (
                                            <div class="no-image-placeholder">
                                                No Image
                                            </div>
                                        )}
                                        <span
                                            class={`badge badge-${post.source}`}
                                        >
                                            {post.source.toUpperCase()}
                                        </span>
                                    </div>
                                    <div class="post-info">
                                        <time
                                            datetime={post.date.toISOString()}
                                        >
                                            {post.date.toLocaleDateString(
                                                "ja-JP",
                                                {
                                                    year: "numeric",
                                                    month: "2-digit",
                                                    day: "2-digit",
                                                },
                                            )}
                                        </time>
                                        <h3 class="post-title">{post.title}</h3>
                                    </div>
                                </a>
                            ))
                        }
                    </div>
                </div>
            </section>

            <script
                id="terminal-commands-data"
                type="application/json"
                set:html={JSON.stringify(terminalCommands)}
            />

            <div class="grid-container">
                <!-- Mini Terminal -->
                <div
                    class="widget-card ui-card ui-card-hover term-card mini-terminal-card"
                    data-reveal
                    style="--i: 0"
                    data-mini-terminal
                >
                    <div class="card-header">
                        <span class="term-dots" data-dots>
                            <i
                                data-dot="red"
                                role="button"
                                tabindex="0"
                                aria-label="reroll"></i>
                            <i
                                data-dot="yellow"
                                role="button"
                                tabindex="0"
                                aria-label="reroll"></i>
                            <i
                                data-dot="green"
                                role="button"
                                tabindex="0"
                                aria-label="reroll"></i>
                        </span>
                        <span class="term-title">~/toramutton</span>
                    </div>
                    <div
                        class="card-body term-body mini-terminal-body"
                        id="mini-terminal-body"
                    >
                        {
                            selectedCommands.map((c, i) => (
                                <div
                                    class="mt-block"
                                    data-cmd={c.cmd}
                                    data-out={c.out}
                                    data-index={i}
                                >
                                    <p class="mt-line">
                                        <span class="mt-prompt">$</span>
                                        <span class="mt-cmd" />
                                    </p>
                                    <p class="mt-out" />
                                </div>
                            ))
                        }
                        <p class="mt-line mt-cursor-line">
                            <span class="mt-prompt">$</span>
                            <span class="mt-cursor" id="mt-cursor">▌</span>
                        </p>
                    </div>
                </div>

                <!-- GitHub Contributions -->
                <div class="widget-card ui-card ui-card-hover gh-card" data-reveal style="--i: 1">
                    <div class="card-header">
                        <GitGraph class="icon-blue" size={16} />
                        <h3>GitHub Contributions</h3>
                        <span class="gh-total">{ghTotal} / yr</span>
                    </div>
                    <div class="card-body">
                        <div class="gh-grid" id="gh-grid">
                            {
                                contributionHistory.map((day, i) => (
                                    <div
                                        class={`gh-cell gh-level-${day.level}`}
                                        data-date={day.date}
                                        data-count={day.count}
                                        style={`--i:${i}`}
                                    />
                                ))
                            }
                        </div>
                        <div class="gh-tip" id="gh-tip" aria-hidden="true"></div>
                        <div class="gh-legend">
                            <span class="gh-legend-label">Less</span>
                            <div class="gh-cell gh-level-0"></div>
                            <div class="gh-cell gh-level-1"></div>
                            <div class="gh-cell gh-level-2"></div>
                            <div class="gh-cell gh-level-3"></div>
                            <div class="gh-cell gh-level-4"></div>
                            <span class="gh-legend-label">More</span>
                        </div>
                        <div class="dedicated-link">
                            <a
                                href="https://github.com/toramutton"
                                target="_blank"
                                rel="noopener noreferrer"
                                >View GitHub Profile →
                            </a>
                        </div>
                    </div>
                </div>

                <!-- My Desktop PC -->
                <div class="widget-card ui-card ui-card-hover project-card" data-reveal style="--i: 2">
                    <div class="card-header">
                        <Cpu class="icon-blue" size={16} />
                        <h3>My Desktop PC</h3>
                    </div>
                    <div class="card-body">
                        <div class="pc-visual">
                            <div class="pc-visual-base">
                                <Image
                                    src={pcDesktopImg}
                                    alt="Hyprland desktop, trapezium-08"
                                    class="pc-visual-img"
                                />
                            </div>
                            <div class="pc-visual-shadow" aria-hidden="true">
                            </div>
                            <div class="pc-visual-overlay">
                                <Image
                                    src={pcCaseImg}
                                    alt="Ryzen 7 7700 + Radeon RX 9060 XT machine interior"
                                    class="pc-visual-img"
                                />
                            </div>
                        </div>
                        <p class="card-desc">
                            Ryzen 7 7700 + Radeon RX 9060 XT 16GB 構成。
                            2026/02/13~
                        </p>
                        <div class="dedicated-link">
                            <a href="/about#trapezium">View Details →</a>
                        </div>
                    </div>
                </div>

                <!-- Countdown -->
                <div class="widget-card ui-card ui-card-hover mission-card" data-reveal style="--i: 3">
                    <div class="card-header">
                        <Target class="icon-blue" size={16} />
                        <h3>Countdown</h3>
                    </div>
                    <div class="card-body">
                        <div class="mission-list">
                            {
                                missionData.map((m, i) => (
                                    <div
                                        class="mission-item js-mission-item"
                                        data-date={m.date}
                                        style={`--i:${i}`}
                                    >
                                        <div class="mission-info">
                                            <span class="mission-icon">
                                                <m.icon
                                                    size={16}
                                                    strokeWidth={2}
                                                />
                                            </span>
                                            <span class="mission-title">
                                                {m.title}
                                            </span>
                                            <span class="mission-date">
                                                {m.date.replace(/-/g, "/")}
                                            </span>
                                        </div>
                                        <div class="mission-days">
                                            <span class="days-num js-days-num">
                                                {m.days}
                                            </span>
                                            <span class="days-unit">days</span>
                                        </div>
                                        <div class="mission-bar">
                                            <div
                                                class="mission-bar-fill js-mission-fill"
                                                style={`--p:${m.p}`}
                                            />
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <!-- Uptime -->
                <div class="widget-card ui-card ui-card-hover uptime-card" data-reveal style="--i: 4">
                    <div class="card-header">
                        <Timer class="icon-blue" size={16} />
                        <h3>Uptime</h3>
                    </div>
                    <div class="card-body">
                        <div class="uptime-list">
                            {
                                uptimes.map((u) => (
                                    <div
                                        class="uptime-item"
                                        data-since={u.since}
                                    >
                                        <div class="uptime-label">
                                            <u.icon
                                                size={14}
                                                class="uptime-icon"
                                            />{" "}
                                            {u.label}
                                        </div>
                                        <div class="uptime-value">
                                            <span class="uptime-num">--</span>
                                            <span class="uptime-unit">
                                                days
                                            </span>
                                        </div>
                                        <div class="uptime-date">
                                            since {u.since.replace(/-/g, "/")}
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                        <div class="uptime-clock" id="uptime-clock"></div>
                    </div>
                </div>

                <!-- Advent 2026 -->
                <div class="widget-card ui-card ui-card-hover advent-card" data-reveal style="--i: 5">
                    <div class="card-header">
                        <Sparkles class="icon-blue" size={16} />
                        <h3>Advent 2026</h3>
                    </div>
                    <div class="card-body">
                        <p class="card-desc card-desc-compact">
                            一人アドベントカレンダー2026開催予定地
                        </p>
                        <div class="advent-layout">
                            <!-- 左: 開催までのカウントダウン -->
                            <div
                                class="mission-item js-mission-item advent-countdown"
                                data-date="2026-12-01"
                            >
                                <div class="mission-info">
                                    <span class="mission-icon">
                                        <Sparkles size={16} strokeWidth={2} />
                                    </span>
                                    <span class="mission-title">開催まで</span>
                                </div>
                                <div class="mission-days">
                                    <span class="days-num js-days-num">
                                        {adventDaysLeft}
                                    </span>
                                    <span class="days-unit">days</span>
                                </div>
                            </div>
                            <!-- 右: 公開状況の円形グラフ -->
                            <div class="advent-ring" aria-hidden="true">
                                <svg viewBox="0 0 100 100">
                                    <g class="advent-ring-rot">
                                        {
                                            ringSegments.map((s, i) => (
                                                <path
                                                    class={`advent-seg advent-seg-${s.status}`}
                                                    d={s.d}
                                                    style={`--i:${i}`}
                                                >
                                                    <title>12/{s.day}</title>
                                                </path>
                                            ))
                                        }
                                    </g>
                                </svg>
                                <div class="advent-ring-center">
                                    <span class="advent-ring-num">
                                        {adventOpenCount}
                                    </span>
                                    <span class="advent-ring-label">open</span>
                                </div>
                            </div>
                        </div>
                        <div class="dedicated-link">
                            <a href="/advent2026/">View Calendar →</a>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Today's Music: `$ play --random` を打って曲名をグリッチ表示し、
                 下の再生バーが伸び切ったら次の曲へ(画面内にあるときだけ)。
                 ヘッダーのドットは Mini Terminal と同じ演出で再抽選 -->
            <div
                class="widget-card ui-card ui-card-hover term-card music-card"
                data-reveal
                data-music
            >
                <div class="card-header">
                    <span class="term-dots" data-dots>
                        <i
                            data-dot="red"
                            role="button"
                            tabindex="0"
                            aria-label="next song"></i>
                        <i
                            data-dot="yellow"
                            role="button"
                            tabindex="0"
                            aria-label="next song"></i>
                        <i
                            data-dot="green"
                            role="button"
                            tabindex="0"
                            aria-label="next song"></i>
                    </span>
                    <Music class="icon-blue" size={16} />
                    <h3>Today's Music</h3>
                    <span class="music-count">{songs.length} tracks</span>
                </div>
                <div class="card-body term-body music-body" id="music-body">
                    <p class="mt-line">
                        <span class="mt-prompt">$</span>
                        <span class="mt-cmd" id="music-cmd"></span>
                    </p>
                    <div class="music-now" id="music-now">
                        <span class="music-note" aria-hidden="true">♪</span>
                        <div class="music-text">
                            <p class="music-title">
                                <span id="music-title"></span><span
                                    class="music-cursor"
                                    id="music-cursor"></span>
                            </p>
                            <p class="music-meta" id="music-meta">
                                <span id="music-artist"></span>
                                <span class="music-sep">·</span>
                                <span id="music-year"></span>
                            </p>
                        </div>
                    </div>
                    <div class="music-bar" aria-hidden="true">
                        <div class="music-bar-fill" id="music-bar-fill"></div>
                    </div>
                </div>
            </div>

            <!-- Uptime counter script -->
            <script>
                import { songs } from "../data/songs";
                import {
                    createTimers,
                    typeText,
                    glitchType,
                    wait,
                    bindDots,
                    reduceMotion,
                } from "../utils/typewriter";

                let uptimeTimer: ReturnType<typeof setInterval> | null = null;

                document.addEventListener("astro:page-load", () => {
                    // 各ウィジェットのタイマー。再抽選時に一括キャンセルする
                    const heroTimers = createTimers();
                    const mtTimers = createTimers();
                    const musicTimers = createTimers();

                    // ====================================
                    // Hero: 1 本のターミナルセッション
                    // ====================================
                    // .line を上から順に「打つ / 出す」
                    const hero =
                        document.querySelector<HTMLElement>("[data-hero]");
                    const session =
                        hero?.querySelector<HTMLElement>("[data-session]");

                    // data-type を持つ span は元の文字列を data-text に退避して
                    // 空にしておく(打つときに戻す)
                    hero?.querySelectorAll<HTMLElement>("[data-type]").forEach(
                        (el) => {
                            if (el.dataset.text === undefined) {
                                el.dataset.text = el.textContent?.trim() ?? "";
                            }
                            el.textContent = "";
                        },
                    );

                    // 1行を「見せる」。打つ文字があればそこで待つ
                    async function playLine(
                        line: HTMLElement,
                        gapMs: number,
                        timers = heroTimers,
                    ) {
                        line.classList.add("is-shown");
                        const target =
                            line.querySelector<HTMLElement>("[data-type]");
                        if (target) {
                            await typeText(
                                target,
                                target.dataset.text ?? "",
                                timers,
                            );
                            line.classList.add("is-typed");
                            await wait(timers, 220);
                        } else if (!line.classList.contains("line-blank")) {
                            await wait(timers, gapMs);
                        }
                    }

                    // 行を順に出す。fastfetch の出力([data-ff])だけは
                    // 左のロゴと右の情報を同時に上から流す
                    const playLines = async (
                        lines: Iterable<HTMLElement>,
                        gapMs: number,
                    ) => {
                        for (const line of lines) await playLine(line, gapMs);
                    };

                    let heroPlaying = false;
                    async function playHero() {
                        if (!hero || !session) return;
                        heroTimers.clear();
                        heroPlaying = true;
                        session
                            .querySelectorAll<HTMLElement>(".line")
                            .forEach((l) =>
                                l.classList.remove("is-shown", "is-typed"),
                            );

                        // 少し待ってから開始(reveal と被らないように)
                        await wait(heroTimers, reduceMotion() ? 0 : 350);
                        for (const child of Array.from(
                            session.children,
                        ) as HTMLElement[]) {
                            if (child.matches("[data-ff]")) {
                                await Promise.all([
                                    playLines(
                                        child.querySelectorAll<HTMLElement>(
                                            "[data-ff-logo] .line",
                                        ),
                                        45,
                                    ),
                                    playLines(
                                        child.querySelectorAll<HTMLElement>(
                                            "[data-ff-info] .line",
                                        ),
                                        55,
                                    ),
                                ]);
                            } else if (child.classList.contains("line")) {
                                await playLine(child, 160);
                            }
                        }
                        heroPlaying = false;
                    }

                    if (hero) {
                        const start = () =>
                            requestAnimationFrame(() => {
                                hero.setAttribute("data-loaded", "");
                                playHero();
                            });
                        document.fonts?.ready
                            ? document.fonts.ready.then(start)
                            : start();
                    }

                    // ---- `ToraMutton` クリックで打ち直し ----
                    session
                        ?.querySelector<HTMLElement>("[data-replay]")
                        ?.addEventListener("click", () => {
                            if (heroPlaying) return;
                            playHero();
                        });

                    // ---- status: 値クリックでコピー ----
                    session
                        ?.querySelectorAll<HTMLElement>("[data-copy]")
                        .forEach((btn) => {
                            btn.addEventListener("click", async () => {
                                const v = btn.dataset.copy ?? "";
                                try {
                                    await navigator.clipboard.writeText(v);
                                    btn.classList.add("is-copied");
                                    setTimeout(
                                        () => btn.classList.remove("is-copied"),
                                        1200,
                                    );
                                } catch {
                                    /* clipboard が使えない環境では何もしない */
                                }
                            });
                        });

                    // カウントダウン処理
                    const missionItems =
                        document.querySelectorAll<HTMLElement>(
                            ".js-mission-item",
                        );
                    const now = new Date();
                    now.setHours(0, 0, 0, 0);

                    missionItems.forEach((item) => {
                        const targetDateStr = item.dataset.date;
                        if (!targetDateStr) return;

                        const target = new Date(targetDateStr);
                        target.setHours(0, 0, 0, 0);

                        const diff = target.getTime() - now.getTime();
                        const days = Math.ceil(diff / (1000 * 60 * 60 * 24));

                        const numEl =
                            item.querySelector<HTMLElement>(".js-days-num");
                        if (numEl) {
                            numEl.innerText = days.toString();
                        }

                        // バーグラフ(固定365日を100%とした残量)
                        const fillEl =
                            item.querySelector<HTMLElement>(".js-mission-fill");
                        if (fillEl) {
                            const p = Math.min(Math.max(days, 0) / 365, 1);
                            fillEl.style.setProperty("--p", p.toString());
                        }
                    });

                    // ---- GitHub Contributions: 日別ツールチップ ----
                    const ghGrid = document.getElementById("gh-grid");
                    const ghTip = document.getElementById("gh-tip");
                    if (ghGrid && ghTip) {
                        const showTip = (cell: HTMLElement) => {
                            const count = cell.dataset.count ?? "0";
                            ghTip.textContent = `${cell.dataset.date} · ${count} contribution${count === "1" ? "" : "s"}`;

                            // card-body(offsetParent)基準の座標に変換
                            const base =
                                ghTip.offsetParent as HTMLElement | null;
                            if (!base) return;
                            const br = base.getBoundingClientRect();
                            const cr = cell.getBoundingClientRect();
                            const cx = cr.left - br.left + cr.width / 2;
                            const above = cr.top - br.top > 36;
                            ghTip.style.left = `${cx}px`;
                            ghTip.style.top = `${above ? cr.top - br.top - 6 : cr.bottom - br.top + 6}px`;
                            ghTip.classList.toggle("is-below", !above);
                            ghTip.classList.add("is-visible");
                        };
                        ghGrid.addEventListener("mouseover", (e) => {
                            const cell = (e.target as HTMLElement).closest<HTMLElement>(
                                ".gh-cell",
                            );
                            if (cell) showTip(cell);
                        });
                        ghGrid.addEventListener("mouseleave", () =>
                            ghTip.classList.remove("is-visible"),
                        );
                        ghGrid.addEventListener(
                            "scroll",
                            () => ghTip.classList.remove("is-visible"),
                            { passive: true },
                        );
                    }

                    // ---- marquee: 実スクロール + rAF による自動送り ----
                    // scrollLeft を進めるだけなので、ユーザーはいつでも
                    // ホイール / トラックパッド / スワイプ / ドラッグで
                    // 手動操作できる(自動送りは操作中だけ止まる)
                    const mqOuter = document.getElementById("marquee-outer");
                    const mqTrack = document.getElementById("marquee-track");
                    if (mqOuter && mqTrack) {
                        // 自動送りはマウスのある環境(= PC)だけ。
                        // スマホ・タブレットは普通の横スワイプ領域にして、
                        // 複製も無限ループもしない(同じ記事が2周見えるため)
                        const isDesktop = window.matchMedia(
                            "(hover: hover) and (pointer: fine)",
                        ).matches;
                        const reduceMotion = window.matchMedia(
                            "(prefers-reduced-motion: reduce)",
                        ).matches;
                        const overflows =
                            mqTrack.scrollWidth > mqOuter.clientWidth;
                        const autoScroll =
                            isDesktop && !reduceMotion && overflows;

                        // 中身を2周分に複製し、半分進んだら巻き戻して無限ループに
                        if (autoScroll) {
                            mqTrack.innerHTML =
                                mqTrack.innerHTML + mqTrack.innerHTML;
                        }

                        // 折り返し幅は毎フレーム scrollWidth を読むと
                        // その都度レイアウトが同期計算されてしまうので、
                        // 一度だけ測ってサイズ変化時に測り直す
                        let half = mqTrack.scrollWidth / 2;
                        let ro: ResizeObserver | null = null;
                        let pos = mqOuter.scrollLeft;

                        // 半分を超えたら巻き戻す(逆方向も同様)。
                        // 複製していないときは巻き戻す基準が無いので付けない
                        if (autoScroll) {
                            ro = new ResizeObserver(() => {
                                half = mqTrack.scrollWidth / 2;
                            });
                            ro.observe(mqOuter);

                            const wrap = () => {
                                if (half <= 0) return;
                                if (mqOuter.scrollLeft >= half) {
                                    mqOuter.scrollLeft -= half;
                                } else if (mqOuter.scrollLeft < 0) {
                                    mqOuter.scrollLeft += half;
                                }
                                pos = mqOuter.scrollLeft;
                            };
                            mqOuter.addEventListener("scroll", wrap, {
                                passive: true,
                            });
                        }

                        // --- 一時停止の管理 ---
                        let hovering = false;
                        let dragging = false;
                        let idleTimer: ReturnType<typeof setTimeout> | null =
                            null;
                        let interacting = false;
                        // ホイールやスワイプの直後はしばらく自動送りを止める
                        const nudge = () => {
                            interacting = true;
                            if (idleTimer) clearTimeout(idleTimer);
                            idleTimer = setTimeout(() => {
                                interacting = false;
                            }, 1200);
                        };
                        mqOuter.addEventListener(
                            "pointerenter",
                            () => (hovering = true),
                        );
                        mqOuter.addEventListener(
                            "pointerleave",
                            () => (hovering = false),
                        );
                        mqOuter.addEventListener(
                            "focusin",
                            () => (hovering = true),
                        );
                        mqOuter.addEventListener(
                            "focusout",
                            () => (hovering = false),
                        );
                        mqOuter.addEventListener("wheel", nudge, {
                            passive: true,
                        });
                        mqOuter.addEventListener("touchstart", nudge, {
                            passive: true,
                        });

                        // --- 掴んで動かす ---
                        // setPointerCapture を使うので window にリスナーを
                        // 足さずに済む(ページ遷移でリークしない)。
                        // ただし pointerdown 時点で即 capture すると、
                        // ただのクリックまで click イベントの標的が
                        // mqOuter に付け替わってしまい、カードのリンクに
                        // 飛べなくなる(Chromium の挙動)。なので実際に
                        // 動かした(しきい値を超えた)ときだけ capture する
                        const DRAG_THRESHOLD = 4;
                        let startX = 0;
                        let startScroll = 0;
                        let moved = 0;
                        let pressPointerId: number | null = null;
                        mqOuter.addEventListener("pointerdown", (e) => {
                            // タッチはネイティブのスワイプに任せる
                            // (自前で scrollLeft を動かすと二重に効く)
                            if (e.pointerType !== "mouse") return;
                            if (e.button !== 0) return;
                            pressPointerId = e.pointerId;
                            moved = 0;
                            startX = e.clientX;
                            startScroll = mqOuter.scrollLeft;
                        });
                        mqOuter.addEventListener("pointermove", (e) => {
                            if (pressPointerId !== e.pointerId) return;
                            const dx = e.clientX - startX;
                            moved = Math.max(moved, Math.abs(dx));
                            if (!dragging) {
                                if (moved <= DRAG_THRESHOLD) return;
                                dragging = true;
                                mqOuter.setPointerCapture(e.pointerId);
                                mqOuter.classList.add("is-dragging");
                            }
                            mqOuter.scrollLeft = startScroll - dx;
                        });
                        const endDrag = () => {
                            pressPointerId = null;
                            if (!dragging) return;
                            dragging = false;
                            mqOuter.classList.remove("is-dragging");
                            nudge();
                        };
                        mqOuter.addEventListener("pointerup", endDrag);
                        mqOuter.addEventListener("pointercancel", endDrag);
                        // ドラッグ後のクリックでリンクに飛ばないように
                        mqOuter.addEventListener(
                            "click",
                            (e) => {
                                if (moved > 6) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                }
                            },
                            true,
                        );

                        // --- 自動送り(PC のみ) ---
                        if (autoScroll) {
                            // 記事が増えても一周が伸びすぎないよう、全長から
                            // 速度を決める(ただし 28〜70px/秒 に収める)
                            const LOOP_SECONDS = 60;
                            const speed = Math.min(
                                Math.max(half / LOOP_SECONDS, 28),
                                70,
                            );
                            let last = performance.now();
                            const step = (now: number) => {
                                // ページ遷移で外れたらループを終了
                                if (!mqOuter.isConnected) {
                                    ro?.disconnect();
                                    return;
                                }
                                const dt = Math.min(now - last, 100);
                                last = now;
                                const idle =
                                    !hovering &&
                                    !dragging &&
                                    !interacting &&
                                    !document.hidden;
                                if (idle) {
                                    // 手動操作でズレた分を拾い直してから進める
                                    if (
                                        Math.abs(mqOuter.scrollLeft - pos) > 1
                                    ) {
                                        pos = mqOuter.scrollLeft;
                                    }
                                    pos += (speed * dt) / 1000;
                                    if (half > 0 && pos >= half) pos -= half;
                                    mqOuter.scrollLeft = pos;
                                }
                                requestAnimationFrame(step);
                            };
                            requestAnimationFrame(step);
                        }
                    }

                    // ====================================
                    // Mini Terminal
                    // ====================================
                    const miniTermCard = document.querySelector<HTMLElement>(
                        "[data-mini-terminal]",
                    );
                    const mtBody =
                        document.getElementById("mini-terminal-body");

                    const allCommands: { cmd: string; out: string }[] =
                        JSON.parse(
                            document.getElementById("terminal-commands-data")
                                ?.textContent ?? "[]",
                        );

                    let currentCommands: { cmd: string; out: string }[] =
                        Array.from(
                            mtBody?.querySelectorAll<HTMLElement>(
                                ".mt-block",
                            ) ?? [],
                        ).map((b) => ({
                            cmd: b.dataset.cmd ?? "",
                            out: b.dataset.out ?? "",
                        }));

                    function renderMiniTerminal() {
                        if (!mtBody) return;
                        const blocksHTML = currentCommands
                            .map(
                                () => `
                    <div class="mt-block">
                        <p class="mt-line">
                            <span class="mt-prompt">$</span>
                            <span class="mt-cmd"></span>
                        </p>
                        <p class="mt-out"></p>
                    </div>`,
                            )
                            .join("");
                        mtBody.innerHTML =
                            blocksHTML +
                            `<p class="mt-line mt-cursor-line">
                    <span class="mt-prompt">$</span>
                    <span class="mt-cursor" id="mt-cursor">▌</span>
                </p>`;
                    }

                    async function typeMiniTerminal() {
                        if (!mtBody) return;
                        mtTimers.clear();
                        const blocks =
                            mtBody.querySelectorAll<HTMLElement>(".mt-block");
                        const cursor =
                            mtBody.querySelector<HTMLElement>("#mt-cursor");

                        for (const [idx, block] of blocks.entries()) {
                            const { cmd, out } = currentCommands[idx];
                            const cmdEl =
                                block.querySelector<HTMLElement>(".mt-cmd");
                            const outEl =
                                block.querySelector<HTMLElement>(".mt-out");
                            if (!cmdEl || !outEl) continue;
                            await typeText(cmdEl, cmd, mtTimers);
                            await wait(mtTimers, 80);
                            outEl.textContent = out;
                            outEl.classList.add("is-visible");
                            await wait(mtTimers, 300);
                        }
                        if (cursor) cursor.style.opacity = "1";
                    }

                    function pickNewCommands() {
                        const currentCmds = currentCommands.map((c) => c.cmd);
                        const pool = allCommands.filter(
                            (c) => !currentCmds.includes(c.cmd),
                        );
                        const source = pool.length >= 3 ? pool : allCommands;
                        currentCommands = [...source]
                            .sort(() => Math.random() - 0.5)
                            .slice(0, 3);
                    }

                    function rerollMiniTerminal() {
                        pickNewCommands();
                        renderMiniTerminal();
                        typeMiniTerminal();
                    }

                    // カード内に行を足す(ドット演出用)。Today's Music と共通の見た目
                    const termLine =
                        (body: HTMLElement) =>
                        (text: string, kind: "cmd" | "comment") => {
                            const p = document.createElement("p");
                            p.className = "mt-line";
                            p.innerHTML =
                                kind === "cmd"
                                    ? `<span class="mt-prompt">$</span><span class="mt-cmd">${text}</span>`
                                    : `<span class="mt-prompt mt-prompt-muted">#</span><span class="mt-cmd">${text}</span>`;
                            body.appendChild(p);
                            return p;
                        };

                    if (miniTermCard && mtBody) {
                        bindDots({
                            card: miniTermCard,
                            body: mtBody,
                            dots: miniTermCard.querySelectorAll<HTMLElement>(
                                "[data-dots] i[data-dot]",
                            ),
                            appendLine: termLine(mtBody),
                            reroll: rerollMiniTerminal,
                        });

                        const mtObserver = new IntersectionObserver(
                            (entries) => {
                                entries.forEach((entry) => {
                                    if (entry.isIntersecting) {
                                        mtTimers.add(typeMiniTerminal, 300);
                                        mtObserver.unobserve(entry.target);
                                    }
                                });
                            },
                            { threshold: 0.2 },
                        );
                        mtObserver.observe(miniTermCard);
                    }

                    // ====================================
                    // Today's Music
                    // ====================================
                    // `$ play --random` を打つ → 曲名をグリッチタイプ →
                    // アーティスト/年をフェード → 再生バーが伸びる。
                    // バーが伸び切ったら、カードが画面内にあるときだけ次の曲へ
                    const musicCard =
                        document.querySelector<HTMLElement>("[data-music]");
                    const musicBody = document.getElementById("music-body");
                    const musicCmd = document.getElementById("music-cmd");
                    const musicNow = document.getElementById("music-now");
                    const musicTitle = document.getElementById("music-title");
                    const musicCursor = document.getElementById("music-cursor");
                    const musicMeta = document.getElementById("music-meta");
                    const musicArtist = document.getElementById("music-artist");
                    const musicYear = document.getElementById("music-year");
                    const musicBar = document.getElementById("music-bar-fill");

                    let currentSong = -1;
                    let musicVisible = false;
                    let musicEnded = false;

                    function pickSong() {
                        let i = currentSong;
                        // 直前と同じ曲は引き直す
                        while (songs.length > 1 && i === currentSong) {
                            i = Math.floor(Math.random() * songs.length);
                        }
                        currentSong = i;
                        return songs[i];
                    }

                    async function playSong() {
                        if (
                            !musicCmd ||
                            !musicNow ||
                            !musicTitle ||
                            !musicMeta ||
                            !musicArtist ||
                            !musicYear
                        )
                            return;
                        musicTimers.clear();
                        musicEnded = false;
                        const song = pickSong();

                        // リセット
                        musicNow.classList.remove("is-shown");
                        musicMeta.classList.remove("is-shown");
                        musicCursor?.classList.remove("blink");
                        musicBar?.classList.remove("is-playing");
                        musicTitle.textContent = "";

                        await typeText(musicCmd, "play --random", musicTimers, 32);
                        await wait(musicTimers, 150);

                        musicNow.classList.add("is-shown");
                        await glitchType(musicTitle, song.title, musicTimers);
                        musicCursor?.classList.add("blink");

                        musicArtist.textContent = song.artist;
                        musicYear.textContent = song.year;
                        musicMeta.classList.add("is-shown");

                        // 再生バー: 次フレームでクラスを付けて transition を走らせる
                        await wait(musicTimers, 120);
                        if (musicBar) {
                            void musicBar.offsetWidth;
                            musicBar.classList.add("is-playing");
                        }
                    }

                    // バーが伸び切った → 見えていれば次の曲、見えていなければ
                    // 見えたときに進める(裏でずっと切り替わらないように)
                    const advanceIfVisible = () => {
                        if (!musicEnded || !musicVisible || document.hidden)
                            return;
                        if (musicCard?.classList.contains("is-busy")) return;
                        playSong();
                    };
                    musicBar?.addEventListener("transitionend", (e) => {
                        if (e.propertyName !== "transform") return;
                        if (!musicBar.classList.contains("is-playing")) return;
                        musicEnded = true;
                        advanceIfVisible();
                    });
                    document.addEventListener("visibilitychange", advanceIfVisible);

                    if (musicCard && musicBody) {
                        bindDots({
                            card: musicCard,
                            body: musicBody,
                            dots: musicCard.querySelectorAll<HTMLElement>(
                                "[data-dots] i[data-dot]",
                            ),
                            appendLine: termLine(musicBody),
                            reroll: playSong,
                        });

                        // 初回は画面に入ったときに始める。
                        // 以降は「見えているか」だけを追いかける
                        let started = false;
                        const musicObserver = new IntersectionObserver(
                            (entries) => {
                                entries.forEach((entry) => {
                                    musicVisible = entry.isIntersecting;
                                    if (entry.isIntersecting && !started) {
                                        started = true;
                                        musicTimers.add(playSong, 200);
                                    }
                                    advanceIfVisible();
                                });
                            },
                            { threshold: 0.3 },
                        );
                        musicObserver.observe(musicCard);
                    }

                    // ---- Uptime counter ----
                    if (uptimeTimer !== null) clearInterval(uptimeTimer);

                    function updateUptime() {
                        const now = new Date();
                        // 日付は data-since 属性に入っている（元データは src/data/home.ts）
                        document
                            .querySelectorAll<HTMLElement>("[data-since]")
                            .forEach((item) => {
                                const since = item.dataset.since;
                                const numEl =
                                    item.querySelector(".uptime-num");
                                if (!since || !numEl) return;
                                const days = Math.floor(
                                    (now.getTime() -
                                        new Date(
                                            `${since}T00:00:00+09:00`,
                                        ).getTime()) /
                                        86400000,
                                );
                                numEl.textContent = days.toLocaleString("ja-JP");
                            });
                        // Uptime カードの時計と hero の `time = ` を同じ値で更新
                        const clock = now.toLocaleString("ja-JP", {
                            timeZone: "Asia/Tokyo",
                            hour: "2-digit",
                            minute: "2-digit",
                            second: "2-digit",
                        });
                        const clockEl = document.getElementById("uptime-clock");
                        if (clockEl) clockEl.textContent = clock;
                        document
                            .querySelectorAll<HTMLElement>("[data-clock]")
                            .forEach((el) => (el.textContent = clock));
                    }
                    updateUptime();
                    uptimeTimer = setInterval(updateUptime, 1000);
                });

                // メッセージ
                const style3D = `
        font-weight: 900;
        font-size: 2.5rem;
        color: #bae6fd;
        text-shadow:
            0 1px 0 #0ea5e9,
            0 2px 0 #0284c7,
            0 3px 0 #0369a1,
            0 4px 0 #075985,
            0 5px 0 #0c4a6e,
            0 6px 1px rgba(0,0,0,0.1),
            0 0 5px rgba(0,0,0,0.1),
            0 1px 3px rgba(0,0,0,0.3),
            0 3px 5px rgba(0,0,0,0.2),
            0 5px 10px rgba(0,0,0,0.25),
            0 10px 10px rgba(0,0,0,0.2),
            0 20px 20px rgba(0,0,0,0.15);
    `;

                const styleAA =
                    "font-family: 'Menlo', 'Consolas', monospace; font-weight: bold; color: #38bdf8; line-height: 1.2;";
                const styleBody =
                    "font-family: sans-serif; color: #7dd3fc; font-size: 0.9rem;";

                console.log("%cToraMutton's Homepage", style3D);
                console.log(
                    `%c
 ______                  __  ___      __  __
