                    </div>
                    <div class="card-body">
                        <div class="pc-visual">
                            <div class="pc-visual-base">
                                <Image
                                    src={pcDesktopImg}
                                    alt="Hyprland desktop, trapezium-08"
                                    class="pc-visual-img"
                                />
                            </div>
                            <div class="pc-visual-shadow" aria-hidden="true">
                            </div>
                            <div class="pc-visual-overlay">
                                <Image
                                    src={pcCaseImg}
                                    alt="Ryzen 7 7700 + Radeon RX 9060 XT machine interior"
                                    class="pc-visual-img"
                                />
