                <!-- marquee outer: 実スクロールコンテナ。自動送りは JS が
                     scrollLeft を進めるだけなので、掴んで動かすことも
                     ホイール/トラックパッド/スワイプで動かすこともできる -->
                <div class="marquee-outer" id="marquee-outer">
                    <div class="marquee-track" id="marquee-track">
                        {
                            latestPosts.map((post, i) => (
                                <a
                                    href={post.url}
                                    class="post-card-mini ui-card ui-card-link"
                                    style={`--i:${i}`}
                                    target={
                                        post.source !== "local"
                                            ? "_blank"
                                            : "_self"
                                    }
                                    rel={
                                        post.source !== "local"
                                            ? "noopener noreferrer"
                                            : undefined
                                    }
                                >
                                    <div class="post-thumb">
