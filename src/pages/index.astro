    /* ====================================
       4. widget-card — border-card ベース
       ==================================== */
    /* 12カラムグリッド。上段(Terminal 3 / GitHub 6 / PC 3)・
       下段(Countdown 5 / Uptime 3 / Advent 4)ともに列合計が12になるよう
       span を組んでいるので、折返しや余りの隙間は発生しない。
       行の高さは各行内で最も背の高いカードに揃う(既存の
       .dedicated-link { margin-top: auto } が下端を吸収する)。 */
    .grid-container {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 1.5rem;
        margin: 3rem 0;
    }

    /* 上段: Terminal / GitHub Contributions(hero) / My Desktop PC */
    .mini-terminal-card {
        grid-column: span 3;
    }
    .gh-card {
        grid-column: span 6;
    }
    .project-card {
        grid-column: span 3;
    }

    /* 下段: Countdown / Uptime / Advent 2026 */
    .mission-card {
        grid-column: span 5;
    }
    .uptime-card {
        grid-column: span 3;
    }
    .advent-card {
        grid-column: span 4;
    }

    /* 枠・背景は global.css の .ui-card、出現は [data-reveal]。
       ホバーでカード自体は動かさない(座標がズレてカーソル下の対象が
       変わってしまうため)。枠がシアンになるだけ(.ui-card-hover)。 */
    .widget-card {
        display: flex;
        flex-direction: column;
        overflow: hidden; /* header の border-bottom が角から溢れないよう */
        position: relative;
    }

    /* ====================================
       4.1 オフセット影 — 主役ブロック共通の語彙
       ====================================
       My Desktop PC の .pc-visual-shadow と同じ考え方:
       ぼかさない実体の影を静止時から敷いておき、hover で距離が伸びて
       cyan に変わる。本体は逆方向に -3px 出して奥行きを作る。
       影も transform もレイアウトに影響しないので、カードの箱と
       カーソル下の座標は動かない。
       (GitHub / Countdown / Advent はそれぞれ固有のグラフ演出に
       切り替えたため、この影は Uptime のみ) */
    .uptime-item {
        --off: 5px;
        --off-color: var(--border-color);
        box-shadow: var(--off) var(--off) 0 var(--off-color);
        transition:
            box-shadow 0.35s cubic-bezier(0.2, 0, 0.2, 1),
            transform 0.35s cubic-bezier(0.2, 0, 0.2, 1);
    }

    @media (hover: hover) {
        .uptime-card:hover .uptime-item {
            --off: 9px;
            --off-color: var(--accent-blue);
            transform: translate(-3px, -3px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .uptime-item {
            transition: none;
        }
    }

    /* カードヘッダー: terminal-header と同じ tone */
    .card-header {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--border-color);
        background: var(--elevated);
        flex-shrink: 0;
    }

    .card-header h3 {
        margin: 0;
        font-size: 0.88rem;
        font-family: var(--font-mono);
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    /* カードボディ共通 padding */
    .card-body {
        padding: 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .card-desc {
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.7;
        flex-grow: 1;
        margin: 0;
    }

    .icon-blue {
        color: var(--accent-blue);
    }

    /* ====================================
       4.3 My Desktop PC — ビジュアル
       ==================================== */
    .pc-visual {
        position: relative;
        aspect-ratio: 8 / 5;
        margin-bottom: calc(6% + 1rem);
    }

    .pc-visual-base {
        position: absolute;
        inset: 0;
        z-index: 1;
        border: 1px solid var(--border-color);
        clip-path: polygon(0 0, 100% 0, 100% 100%, 24% 100%, 0 76%);
        transition: transform 0.35s cubic-bezier(0.2, 0, 0.2, 1);
    }

    .pc-visual-shadow {
        position: absolute;
        left: -4%;
        bottom: -8%;
        width: 46%;
        aspect-ratio: 4 / 5;
        z-index: 2;
        background: var(--border-color);
        clip-path: polygon(0 6%, 88% 0, 100% 92%, 12% 100%);
        transform: translate(7px, 7px);
        transition:
            transform 0.35s cubic-bezier(0.2, 0, 0.2, 1),
            background-color 0.35s ease;
    }

    .pc-visual-overlay {
        position: absolute;
        left: -4%;
        bottom: -8%;
        width: 46%;
        aspect-ratio: 4 / 5;
        z-index: 3;
        border: 1px solid var(--border-color);
        clip-path: polygon(0 6%, 88% 0, 100% 92%, 12% 100%);
        transition: transform 0.35s cubic-bezier(0.2, 0, 0.2, 1);
    }

    .pc-visual-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    @media (hover: hover) {
        .project-card:hover .pc-visual-shadow {
            transform: translate(12px, 12px);
            background: var(--accent-blue);
        }
        .project-card:hover .pc-visual-overlay {
            transform: translate(-3px, -3px);
        }
        .project-card:hover .pc-visual-base {
            transform: scale(1.02);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .pc-visual-base,
        .pc-visual-shadow,
        .pc-visual-overlay {
            transition: none;
        }
    }

    /* ====================================
       4.5 ターミナル系カード共通(Mini Terminal / Today's Music)
       ====================================
       ヘッダーのドット、黄ドットの squish、行(.mt-*)の見た目を共有する。
       .mt-* は JS が innerHTML で作る行にも当たるよう :global にしている */
    .term-card {
        font-family: var(--font-mono);
        transform-origin: top center;
        transition:
            transform 0.3s cubic-bezier(0, 0, 0.2, 1.4),
            opacity 0.3s ease,
            border-color 0.18s ease;
    }

    .term-dots {
        display: inline-flex;
        gap: 5px;
    }
    .term-dots i {
        display: inline-block;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--border-color);
        cursor: pointer;
        transition: background 0.15s ease;
    }

    @media (hover: hover) {
        .term-dots:hover i[data-dot="red"] {
            background: #ff5f57;
        }
        .term-dots:hover i[data-dot="yellow"] {
            background: #ffbd2e;
        }
        .term-dots:hover i[data-dot="green"] {
            background: #28c840;
        }
    }

    /* squish アニメ（黄） */
    .term-card.is-squishing {
        transform: scaleY(0.04);
        opacity: 0;
        pointer-events: none;
    }

    .term-title {
        font-size: 0.72rem;
        color: var(--text-muted);
        letter-spacing: 0.02em;
    }

    .term-body :global(.mt-line) {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        min-height: 1.5em;
        font-size: 0.88rem;
    }

    .term-body :global(.mt-prompt) {
        color: var(--accent-blue);
        font-weight: 600;
        flex-shrink: 0;
    }

    .term-body :global(.mt-prompt-muted) {
        color: var(--text-muted);
    }

    .term-body :global(.mt-cmd) {
        color: var(--text-main);
        font-size: 0.88rem;
    }

    /* ---- Mini Terminal ---- */
    .mini-terminal-body {
        gap: 0;
        padding: 1rem 1.25rem 1.25rem;
    }

    .mini-terminal-body :global(.mt-block) {
        margin-bottom: 0.6rem;
    }

    .mini-terminal-body :global(.mt-block:last-of-type) {
        margin-bottom: 0.4rem;
    }

    .mini-terminal-body :global(.mt-cursor-line) {
        margin-top: 0.2rem;
    }

    .mini-terminal-body :global(.mt-out) {
        color: var(--accent-blue);
        font-size: 0.85rem;
        padding-left: 1.2rem;
        margin: 0.1rem 0 0;
        min-height: 1.4em;
        opacity: 0;
        transform: translateY(3px);
        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
    }

    .mini-terminal-body :global(.mt-out.is-visible) {
        opacity: 1;
        transform: translateY(0);
    }

    .mini-terminal-body :global(.mt-cursor) {
        color: var(--accent-blue);
        font-size: 0.9rem;
        animation: mt-blink 1s step-end infinite;
        opacity: 0; /* JS で表示 */
    }

    @keyframes mt-blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .mt-cursor {
            animation: none;
            opacity: 1;
        }
        .mt-out {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    /* ====================================
       5. Countdown カード
       ==================================== */
    .mission-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    /* 1行 = [info | days] の2列 + 全幅のバーグラフ */
    .mission-item {
        --i: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        row-gap: 0.5rem;
        padding: 0.65rem 0;
        border-bottom: 1px dashed var(--border-color);
    }

    .mission-item:last-child {
        border-bottom: none;
    }

    .mission-info {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .mission-icon {
        color: var(--text-muted);
        flex-shrink: 0;
    }

    .mission-title {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-main);
    }

    .mission-days {
        display: flex;
        align-items: baseline;
        gap: 0.25rem;
        font-family: var(--font-mono);
        flex-shrink: 0;
    }

    .days-num {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--accent-blue);
    }

    .days-unit {
        font-size: 0.65rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* 目標日: 行 hover で横から現れる(hover の無い端末では常時表示) */
    .mission-date {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: var(--text-muted);
        opacity: 0;
        transform: translateX(-4px);
        transition:
            opacity 0.2s ease,
            transform 0.2s ease;
    }

    /* 残量ゲージ: 固定365日を100%とし、日が近づくほど縮む。
       reveal(.is-visible)で左から伸び、行ごとに --i で少しずつ遅らせる。
       transition-delay は transform だけに付けて、hover 側の
       height / opacity には遅延が乗らないようにしている */
    .mission-bar {
        grid-column: 1 / -1;
        position: relative;
        height: 4px;
        border: 1px solid var(--border-color);
        transition: height 0.2s ease;
    }

    .mission-bar-fill {
        position: absolute;
        inset: 0;
        background: var(--accent-blue);
        opacity: 0.55;
        transform-origin: left;
        transform: scaleX(0);
        transition:
            transform 0.9s cubic-bezier(0.2, 0, 0.2, 1) calc(var(--i) * 90ms),
            opacity 0.2s ease;
    }

    .mission-card.is-visible .mission-bar-fill {
        transform: scaleX(var(--p, 0));
    }

    @media (hover: hover) {
        .mission-item:hover .mission-bar {
            height: 8px;
        }
        .mission-item:hover .mission-bar-fill {
            opacity: 1;
        }
        .mission-item:hover .mission-date {
            opacity: 1;
            transform: none;
        }
    }

    @media (hover: none) {
        .mission-date {
            opacity: 1;
            transform: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .mission-bar-fill,
        .mission-date {
            transition: none;
        }
    }

    /* ====================================
       6. dedicated-link / coming-soon
       ==================================== */
    .dedicated-link {
        margin-top: auto;
    }

    .dedicated-link a {
        display: block;
        padding: 0.55rem 1rem;
        border: 1px solid var(--border-color);
        text-align: center;
        font-size: 0.72rem;
        font-family: var(--font-mono);
        font-weight: 700;
        color: var(--accent-blue);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: none;
        border-radius: 0;
        transition:
            border-color 0.18s ease,
            background 0.18s ease;
    }

    @media (hover: hover) {
        .dedicated-link a:hover {
            border-color: var(--accent-blue);
            background: rgba(34, 211, 238, 0.06);
        }
    }

    .coming-soon-badge {
        margin-top: 1.25rem;
        padding: 0.5rem 1rem;
        border: 1px dashed var(--border-color);
        color: var(--text-muted);
        text-align: center;
        font-size: 0.72rem;
        font-family: var(--font-mono);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        border-radius: 0;
    }

    .advent-card {
        border-style: dashed !important;
    }

    /* Countdown カードと同じ行で高さが揃うため、中身に余りが出た分は
       各ブロック間に均等配分する(CTA だけを margin-top: auto で
       下端に寄せると、間に一箇所だけ大きな空白ができてしまうため) */
    .advent-card .card-body {
        justify-content: space-between;
    }
    .advent-card .dedicated-link {
        margin-top: 0;
    }

    .card-desc-compact {
        flex-grow: 0;
        margin-bottom: 0.9rem;
    }

    /* 左: カウントダウンのタイル / 右: 円形グラフ */
    .advent-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1rem;
        align-items: center;
    }

    /* .mission-item の2列グリッドを上書きして縦積みの stat タイルに */
    .advent-countdown {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.3rem;
        border: 1px dashed var(--border-color);
        padding: 0.8rem 0.9rem;
        transition:
            border-color 0.35s ease,
            border-style 0.35s ease;
    }

    .advent-countdown .days-num {
        font-size: 2rem;
        line-height: 1;
    }

    /* ---- 円形グラフ ---- */
    .advent-ring {
        position: relative;
        width: 120px;
        height: 120px;
        flex-shrink: 0;
    }

    .advent-ring svg {
        width: 100%;
        height: 100%;
        display: block;
        overflow: visible;
    }

    .advent-ring-rot {
        transform-box: view-box;
        transform-origin: center;
        transition: transform 0.5s cubic-bezier(0.2, 0, 0.2, 1);
    }

    /* セグメント: reveal で 12時の位置から順にポップイン。
       animation-fill backwards なので、終わった後は通常の cascade に戻り
       hover 側の stroke-width / opacity の transition が効く */
    .advent-seg {
        fill: none;
        stroke: var(--border-color);
        stroke-width: 8;
        opacity: 0;
        transform-box: fill-box;
        transform-origin: center;
        transition:
            stroke-width 0.35s ease,
            opacity 0.35s ease;
    }

    .advent-seg-open {
        stroke: var(--accent-blue);
    }

    .advent-card.is-visible .advent-seg {
        opacity: 1;
        animation: advent-pop 0.4s cubic-bezier(0.2, 0, 0.2, 1) backwards;
        animation-delay: calc(var(--i, 0) * 40ms);
    }

    @keyframes advent-pop {
        from {
            opacity: 0;
            transform: scale(0.5);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .advent-ring-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .advent-ring-num {
        font-family: var(--font-mono);
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1;
        color: var(--text-main);
        transition: color 0.35s ease;
    }

    .advent-ring-label {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-top: 0.2rem;
    }

    /* hover: 円が1目盛り回り、open が太く・locked が沈む */
    @media (hover: hover) {
        .advent-card:hover .advent-ring-rot {
            transform: rotate(14.4deg);
        }
        .advent-card:hover .advent-seg-open {
            stroke-width: 11;
        }
        .advent-card:hover .advent-seg-locked {
            opacity: 0.45;
        }
        .advent-card:hover .advent-ring-num {
            color: var(--accent-blue);
        }
        .advent-card:hover .advent-countdown {
            border-color: var(--accent-blue);
            border-style: solid;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .advent-card.is-visible .advent-seg {
            animation: none;
        }
        .advent-ring-rot,
        .advent-seg,
        .advent-countdown {
            transition: none;
        }
    }

    /* ====================================
       8. GitHub Contributions カード
       ==================================== */
    .gh-total {
        font-size: 0.75rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        margin-left: auto;
    }

    .gh-grid {
        display: grid;
        grid-template-rows: repeat(7, 1fr);
        grid-auto-flow: column;
        /* 列の最小幅をセルの min-width(10px)と揃える。0 のままだと
           週数が多い(ほぼ1年分)のに幅が狭い画面でトラックがセルより
           細くなり、セルの min-width が隣のトラックにはみ出して
           重なって見えてしまう。最小幅を保証し、収まらない分は
           overflow-x のスクロールに逃がす。 */
        grid-auto-columns: minmax(10px, 1fr);
        gap: 3px;
        /* overflow-x: auto を指定すると overflow-y も auto に計算されるため、
           hover で scale(1.4) したセルが最上段・最下段(と左右端)で
           切れてしまう。内側に 5px の余白を作って逃がし、同じ分だけ
           負のマージンで引き戻して見た目の位置は元のまま保つ。 */
        padding: 5px;
        margin: -5px -5px calc(0.75rem - 5px);
        overflow-x: auto;
        scrollbar-width: none;
    }
    .gh-grid::-webkit-scrollbar {
        display: none;
    }

    .gh-cell {
        width: 100%;
        aspect-ratio: 1;
        border-radius: 2px;
        min-width: 10px;
        min-height: 10px;
    }

    /* reveal: 1日ずつ左上から順にポップイン(--i は日付のインデックス)。
       transition ではなく animation にしているのは、遅延を
       hover 側の transform に漏らさないため。fill backwards なので
       終わった後は通常の cascade に戻る */
    .gh-grid .gh-cell {
        opacity: 0;
        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease;
    }

    .gh-card.is-visible .gh-grid .gh-cell {
        opacity: 1;
        animation: gh-pop 0.4s cubic-bezier(0.2, 0, 0.2, 1) backwards;
        animation-delay: calc(var(--i, 0) * 3ms);
    }

    @keyframes gh-pop {
        from {
            opacity: 0;
            transform: translateY(6px) scale(0.4);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    @media (hover: hover) {
        .gh-card.is-visible .gh-grid .gh-cell:hover {
            position: relative;
            z-index: 1;
            transform: scale(1.4);
            box-shadow: 0 0 0 1px var(--accent-blue);
        }
    }

    /* 日別ツールチップ: gh-grid は overflow-x: auto で切れるので、
       card-body 直下に1つだけ置いて JS で位置を合わせる。
       left / top も transition に入れて、セル間をすべるように移動させる */
    .gh-card .card-body {
        position: relative;
    }

    .gh-tip {
        position: absolute;
        left: 0;
        top: 0;
        z-index: 5;
        padding: 0.3rem 0.55rem;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: var(--text-main);
        background: var(--elevated);
        border: 1px solid var(--accent-blue);
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, calc(-100% + 4px));
        transition:
            opacity 0.16s ease,
            transform 0.16s ease,
            left 0.12s ease,
            top 0.12s ease;
    }
    .gh-tip.is-visible {
        opacity: 1;
        transform: translate(-50%, -100%);
    }
    .gh-tip.is-below {
        transform: translate(-50%, -4px);
    }
    .gh-tip.is-below.is-visible {
        transform: translate(-50%, 0);
    }

    @media (prefers-reduced-motion: reduce) {
        .gh-card.is-visible .gh-grid .gh-cell {
            animation: none;
        }
        .gh-grid .gh-cell,
        .gh-tip {
            transition: none;
        }
    }

    /* dark */
    .gh-level-0 {
        background: var(--elevated);
    }
    .gh-level-1 {
        background: #0e4429;
    }
    .gh-level-2 {
        background: #006d32;
    }
    .gh-level-3 {
        background: #26a641;
    }
    .gh-level-4 {
        background: #39d353;
    }

    /* light */
    :global(html:not(.dark)) .gh-level-0 {
        background: #ebedf0;
    }
    :global(html:not(.dark)) .gh-level-1 {
        background: #9be9a8;
    }
    :global(html:not(.dark)) .gh-level-2 {
        background: #40c463;
    }
    :global(html:not(.dark)) .gh-level-3 {
        background: #30a14e;
    }
    :global(html:not(.dark)) .gh-level-4 {
        background: #216e39;
    }

    .gh-legend {
        display: flex;
        align-items: center;
        gap: 4px;
        justify-content: flex-end;
        margin-bottom: 0.75rem;
    }

    .gh-legend .gh-cell {
        width: 11px;
        height: 11px;
        min-width: 11px;
        min-height: 11px;
        aspect-ratio: auto;
    }

    .gh-legend-label {
        font-size: 0.65rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
    }

    /* ====================================
       9. Uptime カード
       ==================================== */
    .uptime-list {
        display: flex;
        flex-direction: column;
        /* 各ボックスがオフセット影を持つので、影が下のボックスに
           かぶらないよう 0.5rem から広げている */
        gap: 0.75rem;
    }

    .uptime-item {
        padding: 0.85rem 1rem;
        border: 1px solid var(--border-color);
        border-radius: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .uptime-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-mono);
    }

    .uptime-icon {
        color: var(--accent-blue);
        flex-shrink: 0;
    }

    .uptime-value {
        display: flex;
        align-items: baseline;
        gap: 0.35rem;
    }

    .uptime-num {
        font-size: 1.8rem;
        font-weight: 800;
        font-family: var(--font-mono);
        color: var(--accent-blue);
        letter-spacing: -0.02em;
    }

    .uptime-unit {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .uptime-date {
        font-size: 0.68rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
    }

    .uptime-clock {
        margin-top: 0.75rem;
        text-align: center;
        font-family: var(--font-mono);
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-muted);
        letter-spacing: 0.12em;
        border-top: 1px solid var(--border-color);
        padding-top: 0.75rem;
    }

    /* ====================================
       10. Today's Music カード
       ====================================
       Mini Terminal と同じ「$ コマンド → 出力」の並び。
       出力は ♪ + 曲名(グリッチタイプ) + アーティスト · 年。
       下の再生バーは Countdown の mission-bar と同じ語彙(細い枠 +
       アクセント色の fill、hover で太くなる) */
    .music-card {
        margin-top: 1.5rem;
    }

    .music-count {
        margin-left: auto;
        font-size: 0.75rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
    }

    .music-body {
        padding: 1rem 1.25rem 1.25rem;
        gap: 0.5rem;
    }

    .music-now {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
        padding-left: 1.2rem;
        min-height: 3.4em;
        opacity: 0;
        transform: translateY(4px);
        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
    }
    .music-now.is-shown {
        opacity: 1;
        transform: none;
    }

    .music-note {
        color: var(--accent-blue);
        font-size: 1.2rem;
        line-height: 1.5;
        flex-shrink: 0;
    }

    .music-text {
        min-width: 0;
    }

    /* 曲名: グリッチタイプライター */
    .music-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--accent-blue);
        margin: 0;
        line-height: 1.3;
        min-height: 1.3em;
