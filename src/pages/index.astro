                                >
                                    <Twitter size={14} /><span>Twitter</span>
                                </a>
                                <!-- <a
                                    href={TW_TECH_URL}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="social-btn"
                                    aria-label="Twitter Tech"
                                >
                                    <Twitter size={14} /><span>tech</span>
                                </a> -->
                            </div>
                            <p class="line line-blank" style="--i: 8"></p>
                            <p class="line" style="--i: 9">
                                <span class="prompt">$</span>
                                <a href="/about" class="cmd cmd-link">
                                    cd ./about<span class="cursor-arrow">
                                        →</span
                                    >
                                </a>
                            </p>
                        </div>
                    </div>

                    <!-- 右カラム: spec-list -->
                    <aside class="spec-block" style="--i: 2">
                        <p class="spec-block-title">// status</p>
                        <ul class="spec-list">
                            {
                                heroSpecs.map((spec) => (
                                    <li>
                                        <span class="spec-key">{spec.key}</span>
                                        <span
                                            class:list={[
                                                "spec-val",
                                                spec.live && "spec-val-live",
                                            ]}
                                        >
                                            {spec.live && (
                                                <span class="dot-live" />
                                            )}
                                            {spec.value}
                                        </span>
                                    </li>
                                ))
                            }
                        </ul>
                    </aside>
                </div>
            </section>

            <section class="recent-posts" data-reveal>
