                        </div>
                        <p class="card-desc">
                            Ryzen 7 7700 + Radeon RX 9060 XT 16GB 構成。
                            2026/02/13~
                        </p>
                        <div class="dedicated-link">
                            <a href="/about#trapezium">View Details →</a>
                        </div>
                    </div>
                </div>

                <!-- Countdown -->
                <div class="widget-card ui-card ui-card-hover mission-card" data-reveal style="--i: 3">
                    <div class="card-header">
                        <Target class="icon-blue" size={16} />
                        <h3>Countdown</h3>
                    </div>
                    <div class="card-body">
                        <div class="mission-list">
