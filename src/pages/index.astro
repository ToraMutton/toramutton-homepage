---
// トップページ。1枚のストーリーとして、ヒーロー → Works → Blog → About の順に縦に並べる。
// 見た目と動きは src/components/home/ の各部品が持ち、このファイルは並べるだけにする。
export const prerender = true;
import Layout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Hero from "../components/home/Hero.astro";
import WorksSection from "../components/home/WorksSection.astro";
import BlogSection from "../components/home/BlogSection.astro";
import AboutSection from "../components/home/AboutSection.astro";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} width="bare">
    <Hero />
    <WorksSection />
    <BlogSection />
    <AboutSection />
</Layout>
