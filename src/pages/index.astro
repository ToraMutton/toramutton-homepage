    }
    /* (.line の flex / min-height を打ち消すため親付きで指定) */
    .ff-logo .ff-logo-row {
        display: block;
        white-space: pre;
        min-height: 0;
    }

    .ff-info {
        min-width: 0;
    }

    /* 1 行目: user@host。クリックで打ち直す(ボタンだが見た目は文字) */
    .ff-user {
        appearance: none;
        background: none;
