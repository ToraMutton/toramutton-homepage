    /* ====================================
       3. 最新の記事 — marquee
       ==================================== */
    /* 出現は全ページ共通の [data-reveal](global.css) */
    .recent-posts {
        margin: 4rem 0;
    }

    /* view-all: glass 廃止 → flat border リンク */
    .view-all {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.45rem 0.9rem;
