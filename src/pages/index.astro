                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <!-- Uptime -->
                <div class="widget-card ui-card ui-card-hover uptime-card" data-reveal style="--i: 4">
                    <div class="card-header">
                        <Timer class="icon-blue" size={16} />
                        <h3>Uptime</h3>
                    </div>
                    <div class="card-body">
                        <div class="uptime-list">
                            {
                                uptimes.map((u) => (
                                    <div
                                        class="uptime-item"
                                        data-since={u.since}
                                    >
                                        <div class="uptime-label">
                                            <u.icon
                                                size={14}
                                                class="uptime-icon"
                                            />{" "}
                                            {u.label}
                                        </div>
                                        <div class="uptime-value">
                                            <span class="uptime-num">--</span>
                                            <span class="uptime-unit">
                                                days
                                            </span>
                                        </div>
                                        <div class="uptime-date">
                                            since {u.since.replace(/-/g, "/")}
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                        <div class="uptime-clock" id="uptime-clock"></div>
                    </div>
                </div>

                <!-- Advent 2026 -->
                <div class="widget-card ui-card ui-card-hover advent-card" data-reveal style="--i: 5">
                    <div class="card-header">
                        <Sparkles class="icon-blue" size={16} />
                        <h3>Advent 2026</h3>
                    </div>
                    <div class="card-body">
                        <p class="card-desc card-desc-compact">
                            一人アドベントカレンダー2026開催予定地
                        </p>
                        <div class="advent-layout">
                            <!-- 左: 開催までのカウントダウン -->
                            <div
                                class="mission-item js-mission-item advent-countdown"
                                data-date="2026-12-01"
                            >
                                <div class="mission-info">
                                    <span class="mission-icon">
                                        <Sparkles size={16} strokeWidth={2} />
                                    </span>
                                    <span class="mission-title">開催まで</span>
                                </div>
                                <div class="mission-days">
                                    <span class="days-num js-days-num">
                                        {adventDaysLeft}
                                    </span>
                                    <span class="days-unit">days</span>
                                </div>
                            </div>
                            <!-- 右: 公開状況の円形グラフ -->
                            <div class="advent-ring" aria-hidden="true">
                                <svg viewBox="0 0 100 100">
                                    <g class="advent-ring-rot">
                                        {
                                            ringSegments.map((s, i) => (
                                                <path
                                                    class={`advent-seg advent-seg-${s.status}`}
                                                    d={s.d}
                                                    style={`--i:${i}`}
                                                >
                                                    <title>12/{s.day}</title>
                                                </path>
                                            ))
                                        }
                                    </g>
                                </svg>
                                <div class="advent-ring-center">
                                    <span class="advent-ring-num">
                                        {adventOpenCount}
                                    </span>
                                    <span class="advent-ring-label">open</span>
                                </div>
                            </div>
                        </div>
                        <div class="dedicated-link">
                            <a href="/advent2026/">View Calendar →</a>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Today's Music -->
            <div class="widget-card ui-card ui-card-hover recommendation-card" data-reveal>
                <div class="card-header">
                    <Music class="icon-secondary" size={16} />
                    <h3>Today's Music</h3>
                </div>
                <div id="song-display" class="song-container">
                    <p class="song-cmd-line" id="song-cmd-line">
                        <span class="song-cmd-prompt">$</span><span
                            id="song-cmd-text"></span>
                    </p>
                    <p class="song-title" id="song-title">
                        <span id="song-title-text"></span><span
                            class="song-cursor"
                            id="song-cursor"></span>
                    </p>
                    <p class="song-year-wrapper" id="song-year-wrapper">
                        released in <span id="song-year" class="song-year"
                            >----</span
                        >
                    </p>
                </div>
                <button id="next-song-btn" class="secondary-btn">
                    reload →
                </button>
            </div>

            <!-- Uptime counter script -->
            <script>
                import { songs } from "../data/songs";

                let uptimeTimer: ReturnType<typeof setInterval> | null = null;

                document.addEventListener("astro:page-load", () => {
                    // ★ タイマー管理を一番上に移動
                    let mtTimers: ReturnType<typeof setTimeout>[] = [];
                    const addMtTimer = (fn: () => void, ms: number) => {
                        mtTimers.push(setTimeout(fn, ms));
                    };
                    const clearMtTimers = () => {
                        mtTimers.forEach(clearTimeout);
                        mtTimers = [];
                    };

                    let musicTimers: ReturnType<typeof setTimeout>[] = [];
                    const addMusicTimer = (fn: () => void, ms: number) => {
                        musicTimers.push(setTimeout(fn, ms));
                    };
                    const clearMusicTimers = () => {
                        musicTimers.forEach(clearTimeout);
                        musicTimers = [];
                    };

                    const hero =
                        document.querySelector<HTMLElement>("[data-hero]");
                    if (hero) {
                        const trigger = () =>
                            requestAnimationFrame(() =>
                                hero.setAttribute("data-loaded", ""),
                            );
                        document.fonts?.ready
                            ? document.fonts.ready.then(trigger)
                            : trigger();
                    }

                    // ---- Terminal dots easter egg ----
                    const terminal =
                        document.querySelector<HTMLElement>(".terminal");
                    const termBody =
                        terminal?.querySelector<HTMLElement>(".terminal-body");

                    terminal
                        ?.querySelectorAll<HTMLElement>("i[data-dot]")
                        .forEach((dot) => {
                            dot.addEventListener("click", () => {
                                if (terminal.classList.contains("is-busy"))
                                    return;
                                const kind = dot.dataset.dot;
                                if (kind === "red")
                                    exitDot(terminal, termBody!);
                                if (kind === "yellow") minimizeDot(terminal);
                                if (kind === "green") maxDot(termBody!);
                            });
                        });

                    function exitDot(
                        terminal: HTMLElement,
                        termBody: HTMLElement,
                    ) {
                        terminal.classList.add("is-busy");
                        const saved = termBody.innerHTML;

                        const exitLine = document.createElement("p");
                        exitLine.className = "line";
                        exitLine.innerHTML = `<span class="prompt">$</span><span class="cmd"> exit 0</span>`;
                        termBody.appendChild(exitLine);

                        setTimeout(() => {
                            termBody.style.cssText =
                                "opacity:0; transition:opacity 0.3s ease";
                            setTimeout(() => {
                                termBody.innerHTML = `
                        <p class="line"><span class="comment"># Connection closed.</span></p>
                        <p class="line"><span class="comment"># Rebooting...</span></p>
                    `;
                                termBody.style.cssText =
                                    "opacity:1; transition:opacity 0.3s ease";
                                setTimeout(() => {
                                    termBody.style.cssText =
                                        "opacity:0; transition:opacity 0.3s ease";
                                    setTimeout(() => {
                                        termBody.innerHTML = saved;
                                        termBody.style.cssText = "";
                                        terminal.classList.remove("is-busy");
                                        const hero =
                                            document.querySelector(
                                                "[data-hero]",
                                            );
                                        hero?.removeAttribute("data-loaded");
                                        requestAnimationFrame(() =>
                                            hero?.setAttribute(
                                                "data-loaded",
                                                "",
                                            ),
                                        );
                                    }, 320);
                                }, 1200);
                            }, 350);
                        }, 600);
                    }

                    function minimizeDot(terminal: HTMLElement) {
                        terminal.classList.add("is-minimizing", "is-busy");
                        setTimeout(() => {
                            terminal.classList.remove("is-minimizing");
                            setTimeout(
                                () => terminal.classList.remove("is-busy"),
                                350,
                            );
                        }, 580);
                    }

                    function maxDot(termBody: HTMLElement) {
                        const msg = document.createElement("p");
                        msg.className = "line line-comment";
                        msg.innerHTML = `<span class="comment"># nothing to maximize here :)</span>`;
                        termBody.appendChild(msg);
                        setTimeout(() => {
                            msg.style.cssText =
                                "opacity:0; transition:opacity 0.3s ease";
                            setTimeout(() => msg.remove(), 320);
                        }, 1500);
                    }

                    // カウントダウン処理
                    const missionItems =
                        document.querySelectorAll<HTMLElement>(
                            ".js-mission-item",
                        );
                    const now = new Date();
                    now.setHours(0, 0, 0, 0);

                    missionItems.forEach((item) => {
                        const targetDateStr = item.dataset.date;
                        if (!targetDateStr) return;

                        const target = new Date(targetDateStr);
                        target.setHours(0, 0, 0, 0);

                        const diff = target.getTime() - now.getTime();
                        const days = Math.ceil(diff / (1000 * 60 * 60 * 24));

                        const numEl =
                            item.querySelector<HTMLElement>(".js-days-num");
                        if (numEl) {
                            numEl.innerText = days.toString();
                        }

                        // バーグラフ(固定365日を100%とした残量)
                        const fillEl =
                            item.querySelector<HTMLElement>(".js-mission-fill");
                        if (fillEl) {
                            const p = Math.min(Math.max(days, 0) / 365, 1);
                            fillEl.style.setProperty("--p", p.toString());
                        }
                    });

                    // ---- GitHub Contributions: 日別ツールチップ ----
                    const ghGrid = document.getElementById("gh-grid");
                    const ghTip = document.getElementById("gh-tip");
                    if (ghGrid && ghTip) {
                        const showTip = (cell: HTMLElement) => {
                            const count = cell.dataset.count ?? "0";
                            ghTip.textContent = `${cell.dataset.date} · ${count} contribution${count === "1" ? "" : "s"}`;

                            // card-body(offsetParent)基準の座標に変換
                            const base =
                                ghTip.offsetParent as HTMLElement | null;
                            if (!base) return;
                            const br = base.getBoundingClientRect();
                            const cr = cell.getBoundingClientRect();
                            const cx = cr.left - br.left + cr.width / 2;
                            const above = cr.top - br.top > 36;
                            ghTip.style.left = `${cx}px`;
                            ghTip.style.top = `${above ? cr.top - br.top - 6 : cr.bottom - br.top + 6}px`;
                            ghTip.classList.toggle("is-below", !above);
                            ghTip.classList.add("is-visible");
                        };
                        ghGrid.addEventListener("mouseover", (e) => {
                            const cell = (e.target as HTMLElement).closest<HTMLElement>(
                                ".gh-cell",
                            );
                            if (cell) showTip(cell);
                        });
                        ghGrid.addEventListener("mouseleave", () =>
                            ghTip.classList.remove("is-visible"),
                        );
                        ghGrid.addEventListener(
                            "scroll",
                            () => ghTip.classList.remove("is-visible"),
                            { passive: true },
                        );
                    }

                    const titleEl = document.getElementById("song-title");
                    const yearEl = document.getElementById("song-year");
                    const btn = document.getElementById("next-song-btn");

                    // ---- marquee: 実スクロール + rAF による自動送り ----
                    // scrollLeft を進めるだけなので、ユーザーはいつでも
                    // ホイール / トラックパッド / スワイプ / ドラッグで
                    // 手動操作できる(自動送りは操作中だけ止まる)
                    const mqOuter = document.getElementById("marquee-outer");
                    const mqTrack = document.getElementById("marquee-track");
                    if (mqOuter && mqTrack) {
                        // 自動送りはマウスのある環境(= PC)だけ。
                        // スマホ・タブレットは普通の横スワイプ領域にして、
                        // 複製も無限ループもしない(同じ記事が2周見えるため)
                        const isDesktop = window.matchMedia(
                            "(hover: hover) and (pointer: fine)",
                        ).matches;
                        const reduceMotion = window.matchMedia(
                            "(prefers-reduced-motion: reduce)",
                        ).matches;
                        const overflows =
                            mqTrack.scrollWidth > mqOuter.clientWidth;
                        const autoScroll =
                            isDesktop && !reduceMotion && overflows;

                        // 中身を2周分に複製し、半分進んだら巻き戻して無限ループに
                        if (autoScroll) {
                            mqTrack.innerHTML =
                                mqTrack.innerHTML + mqTrack.innerHTML;
                        }

                        // 折り返し幅は毎フレーム scrollWidth を読むと
                        // その都度レイアウトが同期計算されてしまうので、
                        // 一度だけ測ってサイズ変化時に測り直す
                        let half = mqTrack.scrollWidth / 2;
                        let ro: ResizeObserver | null = null;
                        let pos = mqOuter.scrollLeft;

                        // 半分を超えたら巻き戻す(逆方向も同様)。
                        // 複製していないときは巻き戻す基準が無いので付けない
                        if (autoScroll) {
                            ro = new ResizeObserver(() => {
                                half = mqTrack.scrollWidth / 2;
                            });
                            ro.observe(mqOuter);

                            const wrap = () => {
                                if (half <= 0) return;
                                if (mqOuter.scrollLeft >= half) {
                                    mqOuter.scrollLeft -= half;
                                } else if (mqOuter.scrollLeft < 0) {
                                    mqOuter.scrollLeft += half;
                                }
                                pos = mqOuter.scrollLeft;
                            };
                            mqOuter.addEventListener("scroll", wrap, {
                                passive: true,
                            });
                        }

                        // --- 一時停止の管理 ---
                        let hovering = false;
                        let dragging = false;
                        let idleTimer: ReturnType<typeof setTimeout> | null =
                            null;
                        let interacting = false;
                        // ホイールやスワイプの直後はしばらく自動送りを止める
                        const nudge = () => {
                            interacting = true;
                            if (idleTimer) clearTimeout(idleTimer);
                            idleTimer = setTimeout(() => {
                                interacting = false;
                            }, 1200);
                        };
                        mqOuter.addEventListener(
                            "pointerenter",
                            () => (hovering = true),
                        );
                        mqOuter.addEventListener(
                            "pointerleave",
                            () => (hovering = false),
                        );
                        mqOuter.addEventListener(
                            "focusin",
                            () => (hovering = true),
                        );
                        mqOuter.addEventListener(
                            "focusout",
                            () => (hovering = false),
                        );
                        mqOuter.addEventListener("wheel", nudge, {
                            passive: true,
                        });
                        mqOuter.addEventListener("touchstart", nudge, {
                            passive: true,
                        });

                        // --- 掴んで動かす ---
                        // setPointerCapture を使うので window にリスナーを
                        // 足さずに済む(ページ遷移でリークしない)。
                        // ただし pointerdown 時点で即 capture すると、
                        // ただのクリックまで click イベントの標的が
                        // mqOuter に付け替わってしまい、カードのリンクに
                        // 飛べなくなる(Chromium の挙動)。なので実際に
                        // 動かした(しきい値を超えた)ときだけ capture する
                        const DRAG_THRESHOLD = 4;
                        let startX = 0;
                        let startScroll = 0;
                        let moved = 0;
                        let pressPointerId: number | null = null;
                        mqOuter.addEventListener("pointerdown", (e) => {
                            // タッチはネイティブのスワイプに任せる
                            // (自前で scrollLeft を動かすと二重に効く)
                            if (e.pointerType !== "mouse") return;
                            if (e.button !== 0) return;
                            pressPointerId = e.pointerId;
                            moved = 0;
                            startX = e.clientX;
                            startScroll = mqOuter.scrollLeft;
                        });
                        mqOuter.addEventListener("pointermove", (e) => {
                            if (pressPointerId !== e.pointerId) return;
                            const dx = e.clientX - startX;
                            moved = Math.max(moved, Math.abs(dx));
                            if (!dragging) {
                                if (moved <= DRAG_THRESHOLD) return;
                                dragging = true;
                                mqOuter.setPointerCapture(e.pointerId);
                                mqOuter.classList.add("is-dragging");
                            }
                            mqOuter.scrollLeft = startScroll - dx;
                        });
                        const endDrag = () => {
                            pressPointerId = null;
                            if (!dragging) return;
                            dragging = false;
                            mqOuter.classList.remove("is-dragging");
                            nudge();
                        };
                        mqOuter.addEventListener("pointerup", endDrag);
                        mqOuter.addEventListener("pointercancel", endDrag);
                        // ドラッグ後のクリックでリンクに飛ばないように
                        mqOuter.addEventListener(
                            "click",
                            (e) => {
                                if (moved > 6) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                }
                            },
                            true,
                        );

                        // --- 自動送り(PC のみ) ---
                        if (autoScroll) {
                            // 記事が増えても一周が伸びすぎないよう、全長から
                            // 速度を決める(ただし 28〜70px/秒 に収める)
                            const LOOP_SECONDS = 60;
                            const speed = Math.min(
                                Math.max(half / LOOP_SECONDS, 28),
                                70,
                            );
                            let last = performance.now();
                            const step = (now: number) => {
                                // ページ遷移で外れたらループを終了
                                if (!mqOuter.isConnected) {
                                    ro?.disconnect();
                                    return;
                                }
                                const dt = Math.min(now - last, 100);
                                last = now;
                                const idle =
                                    !hovering &&
                                    !dragging &&
                                    !interacting &&
                                    !document.hidden;
                                if (idle) {
                                    // 手動操作でズレた分を拾い直してから進める
                                    if (
                                        Math.abs(mqOuter.scrollLeft - pos) > 1
                                    ) {
                                        pos = mqOuter.scrollLeft;
                                    }
                                    pos += (speed * dt) / 1000;
                                    if (half > 0 && pos >= half) pos -= half;
                                    mqOuter.scrollLeft = pos;
                                }
                                requestAnimationFrame(step);
                            };
                            requestAnimationFrame(step);
                        }
                    }

                    // ====================================
                    // Mini Terminal
                    // ====================================
                    const miniTermCard = document.querySelector<HTMLElement>(
                        "[data-mini-terminal]",
                    );
                    const mtBody =
                        document.getElementById("mini-terminal-body");

                    const allCommands: { cmd: string; out: string }[] =
                        JSON.parse(
                            document.getElementById("terminal-commands-data")
                                ?.textContent ?? "[]",
                        );

                    let currentCommands: { cmd: string; out: string }[] =
                        Array.from(
                            mtBody?.querySelectorAll<HTMLElement>(
                                ".mt-block",
                            ) ?? [],
                        ).map((b) => ({
                            cmd: b.dataset.cmd ?? "",
                            out: b.dataset.out ?? "",
                        }));

                    function renderMiniTerminal() {
                        if (!mtBody) return;
                        const blocksHTML = currentCommands
                            .map(
                                () => `
                    <div class="mt-block">
                        <p class="mt-line">
                            <span class="mt-prompt">$</span>
                            <span class="mt-cmd"></span>
                        </p>
                        <p class="mt-out"></p>
                    </div>`,
                            )
                            .join("");
                        mtBody.innerHTML =
                            blocksHTML +
                            `<p class="mt-line mt-cursor-line">
                    <span class="mt-prompt">$</span>
                    <span class="mt-cursor" id="mt-cursor">▌</span>
                </p>`;
                    }

                    function typeMiniTerminal() {
                        if (!mtBody) return;
                        const blocks =
                            mtBody.querySelectorAll<HTMLElement>(".mt-block");
                        const cursor =
                            mtBody.querySelector<HTMLElement>("#mt-cursor");
                        let blockDelay = 0;

                        blocks.forEach((block, idx) => {
                            const { cmd, out } = currentCommands[idx];
                            const cmdEl =
                                block.querySelector<HTMLElement>(".mt-cmd");
                            const outEl =
                                block.querySelector<HTMLElement>(".mt-out");
                            if (!cmdEl || !outEl) return;

                            const startDelay = blockDelay;
                            // ★ 全て addMtTimer に修正済み
                            addMtTimer(() => {
                                let charIndex = 0;
                                const typeChar = () => {
                                    if (charIndex < cmd.length) {
                                        cmdEl.textContent = cmd.slice(
                                            0,
                                            ++charIndex,
                                        );
                                        addMtTimer(typeChar, 38);
                                    } else {
                                        outEl.textContent = out;
                                        addMtTimer(
                                            () =>
                                                outEl.classList.add(
                                                    "is-visible",
                                                ),
                                            80,
                                        );
                                    }
                                };
                                typeChar();
                            }, startDelay);

                            blockDelay += cmd.length * 38 + 80 + 300;
                        });

                        addMtTimer(() => {
                            if (cursor) cursor.style.opacity = "1";
                        }, blockDelay);
                    }

                    function pickNewCommands() {
                        const currentCmds = currentCommands.map((c) => c.cmd);
                        const pool = allCommands.filter(
                            (c) => !currentCmds.includes(c.cmd),
                        );
                        const source = pool.length >= 3 ? pool : allCommands;
                        currentCommands = [...source]
                            .sort(() => Math.random() - 0.5)
                            .slice(0, 3);
                    }

                    function rerollMiniTerminal() {
                        pickNewCommands();
                        renderMiniTerminal();
                        typeMiniTerminal();
                    }

                    // ---- ドットクリック演出 ----
                    const mtDotsEl = document.getElementById("mt-dots");
                    const mtCard = document.querySelector<HTMLElement>(
                        ".mini-terminal-card",
                    );

                    mtDotsEl
                        ?.querySelectorAll<HTMLElement>("i[data-mt-dot]")
                        .forEach((dot) => {
                            dot.addEventListener("click", () => {
                                if (mtCard?.classList.contains("mt-busy"))
                                    return;
                                if (!mtBody) return;
                                mtCard?.classList.add("mt-busy");
                                const kind = dot.dataset.mtDot;

                                if (kind === "red") {
                                    const exitLine =
                                        document.createElement("p");
                                    exitLine.className = "mt-line";
                                    exitLine.innerHTML = `<span class="mt-prompt">$</span><span class="mt-cmd"> exit 0</span>`;
                                    mtBody.appendChild(exitLine);

                                    setTimeout(() => {
                                        mtBody.style.cssText =
                                            "opacity:0; transition:opacity 0.3s ease";
                                        setTimeout(() => {
                                            mtBody.innerHTML = `
                                <p class="mt-line"><span class="mt-prompt" style="color:var(--text-muted)">#</span><span class="mt-cmd"> Connection closed.</span></p>
                                <p class="mt-line"><span class="mt-prompt" style="color:var(--text-muted)">#</span><span class="mt-cmd"> Rebooting...</span></p>`;
                                            mtBody.style.cssText =
                                                "opacity:1; transition:opacity 0.3s ease";
                                            setTimeout(() => {
                                                mtBody.style.cssText =
                                                    "opacity:0; transition:opacity 0.3s ease";
                                                setTimeout(() => {
                                                    mtBody.style.cssText = "";
                                                    rerollMiniTerminal();
                                                    mtCard?.classList.remove(
                                                        "mt-busy",
                                                    );
                                                }, 320);
                                            }, 1000);
                                        }, 350);
                                    }, 500);
                                } else if (kind === "yellow") {
                                    mtCard?.classList.add("is-squishing");
                                    setTimeout(() => {
                                        rerollMiniTerminal();
                                        mtCard?.classList.remove(
                                            "is-squishing",
                                        );
                                        setTimeout(
                                            () =>
                                                mtCard?.classList.remove(
                                                    "mt-busy",
                                                ),
                                            350,
                                        );
                                    }, 500);
                                } else if (kind === "green") {
                                    const msg = document.createElement("p");
                                    msg.className = "mt-line";
                                    msg.innerHTML = `<span class="mt-prompt" style="color:var(--text-muted)">#</span><span class="mt-cmd"> re-rolling...</span>`;
                                    mtBody.appendChild(msg);

                                    setTimeout(() => {
                                        msg.style.cssText =
                                            "opacity:0; transition:opacity 0.3s ease";
                                        setTimeout(() => {
                                            rerollMiniTerminal();
                                            mtCard?.classList.remove("mt-busy");
                                        }, 320);
                                    }, 800);
                                }
                            });
                        });

                    if (miniTermCard) {
                        const mtObserver = new IntersectionObserver(
                            (entries) => {
                                entries.forEach((entry) => {
                                    if (entry.isIntersecting) {
                                        addMtTimer(typeMiniTerminal, 300);
                                        mtObserver.unobserve(entry.target);
                                    }
                                });
                            },
                            { threshold: 0.2 },
                        );
                        mtObserver.observe(miniTermCard);
                    }

                    // --- 要素取得を id ベースに切り替え ---
                    const cmdTextEl = document.getElementById("song-cmd-text");
                    const titleTextEl =
                        document.getElementById("song-title-text");
                    const cursorEl = document.getElementById("song-cursor");
                    const yearWrapEl =
                        document.getElementById("song-year-wrapper");

                    const GLITCH_CHARS =
                        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*<>/\\|";
                    const randChar = () =>
                        GLITCH_CHARS[
                            Math.floor(Math.random() * GLITCH_CHARS.length)
                        ];

                    // タイプライター（コマンド行）
                    function typeCmd(text: string, onDone: () => void) {
                        if (!cmdTextEl) return;
                        cmdTextEl.textContent = "";
                        let i = 0;
                        const tick = () => {
                            if (i >= text.length) {
                                onDone();
                                return;
                            }
                            cmdTextEl.textContent += text[i++];
                            // ★ 全て addMusicTimer に修正済み
                            addMusicTimer(tick, 32);
                        };
                        tick();
                    }

                    // グリッチタイプライター（タイトル行）
                    function glitchType(text: string, onDone: () => void) {
                        if (!titleTextEl) return;
                        titleTextEl.textContent = "";

                        const chars = [...text];
                        let confirmed = 0;

                        const nextChar = () => {
                            if (confirmed >= chars.length) {
                                onDone();
                                return;
                            }

                            const targetChar = chars[confirmed];
                            let glitchCount = 0;
                            const shouldGlitch = /[\p{L}\p{N}]/u.test(
                                targetChar,
                            );
                            const maxGlitch = shouldGlitch ? 3 : 0;

                            const glitchTick = () => {
                                if (glitchCount >= maxGlitch) {
                                    const base = chars
                                        .slice(0, confirmed)
                                        .join("");
                                    titleTextEl.textContent = base + targetChar;
                                    confirmed++;
                                    addMusicTimer(nextChar, 45);
                                } else {
                                    const base = chars
                                        .slice(0, confirmed)
                                        .join("");
                                    titleTextEl.textContent = base + randChar();
                                    glitchCount++;
                                    addMusicTimer(glitchTick, 38);
                                }
                            };
                            glitchTick();
                        };
                        nextChar();
                    }

                    // スロット年号
                    function slotYear(targetYear: string, onDone: () => void) {
                        if (!yearEl) return;
                        const target = parseInt(targetYear, 10);
                        const duration = 900;
                        const start = performance.now();

                        const tick = (now: number) => {
                            const elapsed = now - start;
                            const progress = Math.min(elapsed / duration, 1);
                            const eased = 1 - Math.pow(1 - progress, 3);

                            if (progress < 1) {
                                const display = Math.floor(
                                    Math.random() * 10000,
                                )
                                    .toString()
                                    .padStart(4, "0");
                                yearEl.textContent = display;
                                requestAnimationFrame(tick);
                            } else {
                                yearEl.textContent = targetYear;
                                onDone();
                            }
                        };
                        requestAnimationFrame(tick);
                    }

                    function updateSong() {
                        const randomSong =
                            songs[Math.floor(Math.random() * songs.length)];

                        // ★ clearMusicTimers に修正済み
                        clearMusicTimers();
                        if (cmdTextEl) cmdTextEl.textContent = "";
                        if (titleTextEl) titleTextEl.textContent = "";
                        if (cursorEl) cursorEl.classList.remove("blink");
                        if (yearEl) yearEl.textContent = "----";
                        if (yearWrapEl) yearWrapEl.style.opacity = "0";

                        typeCmd("play --random", () => {
                            addMusicTimer(() => {
                                if (yearWrapEl) {
                                    yearWrapEl.style.transition =
                                        "opacity 0.3s ease";
                                    yearWrapEl.style.opacity = "0.8";
                                }
                                slotYear(randomSong.year, () => {});
                                glitchType(randomSong.title, () => {
                                    if (cursorEl)
                                        cursorEl.classList.add("blink");
                                });
                            }, 150);
                        });
                    }

                    btn?.addEventListener("click", updateSong);
                    updateSong();

                    // ---- Uptime counter ----
                    if (uptimeTimer !== null) clearInterval(uptimeTimer);

                    function updateUptime() {
                        const now = new Date();
                        // 日付は data-since 属性に入っている（元データは src/data/home.ts）
                        document
                            .querySelectorAll<HTMLElement>("[data-since]")
                            .forEach((item) => {
                                const since = item.dataset.since;
                                const numEl =
                                    item.querySelector(".uptime-num");
                                if (!since || !numEl) return;
                                const days = Math.floor(
                                    (now.getTime() -
                                        new Date(
                                            `${since}T00:00:00+09:00`,
                                        ).getTime()) /
                                        86400000,
                                );
                                numEl.textContent = days.toLocaleString("ja-JP");
                            });
                        const clockEl = document.getElementById("uptime-clock");
                        if (clockEl)
                            clockEl.textContent = now.toLocaleString("ja-JP", {
                                timeZone: "Asia/Tokyo",
                                hour: "2-digit",
                                minute: "2-digit",
                                second: "2-digit",
                            });
                    }
                    updateUptime();
                    uptimeTimer = setInterval(updateUptime, 1000);
                });

                // メッセージ
