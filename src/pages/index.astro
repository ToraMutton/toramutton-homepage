    /* ====================================
   Load animations
   ====================================
   行の出現は JS(playHero)が上から順に .is-shown を付けて進める。
   [data-type] の span は打っている間だけ右にキャレットが付き、
   打ち終わると(.is-typed)消える */
    .line {
        opacity: 0;
        transform: translateY(6px);
    }
    .line.is-shown {
        opacity: 1;
        transform: none;
        transition:
            opacity 0.35s ease,
            transform 0.35s ease;
    }
    .line.is-shown:not(.is-typed) [data-type] {
        border-right: 2px solid var(--accent-blue);
        padding-right: 1px;
        animation: caret 0.7s step-end infinite;
    }
    @keyframes caret {
        50% {
            border-color: transparent;
        }
    }
    /* cd ./about の矢印は打ち終わってから */
    .cursor-arrow {
        opacity: 0;
        transition:
            opacity 0.25s ease,
            transform 0.18s ease;
    }
    .line.is-typed .cursor-arrow {
        opacity: 1;
    }

    /* ====================================
   Reduced motion
   ==================================== */
