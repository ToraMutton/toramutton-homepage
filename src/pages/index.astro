    }

    @media (hover: hover) {
        .view-all:hover {
            color: var(--accent-blue);
            border-color: var(--accent-blue);
        }
    }

    /* ---- marquee wrapper ----
       CSS の transform アニメーションではなく「本物の横スクロール領域」。
       自動送りは JS が scrollLeft を進めるだけなので、ホイール・
       トラックパッド・スワイプ・ドラッグでいつでも手で動かせる。
       上下の padding は hover 時のオフセット影を切らないための逃げ
       (overflow-x を指定すると overflow-y も auto に計算されるため)。 */
    .marquee-outer {
        overflow-x: auto;
        overflow-y: hidden;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
        padding: 8px 0;
        margin: -8px 0;
        /* 掴んで動かせるのはマウスのある環境だけ(タッチはスワイプ) */
        -webkit-overflow-scrolling: touch;
        /* 左右に fade mask */
        -webkit-mask-image: linear-gradient(
            to right,
            transparent 0%,
            black 6%,
            black 94%,
            transparent 100%
        );
        mask-image: linear-gradient(
            to right,
            transparent 0%,
            black 6%,
            black 94%,
            transparent 100%
        );
    }

    .marquee-outer::-webkit-scrollbar {
        display: none;
    }

    @media (hover: hover) and (pointer: fine) {
        .marquee-outer {
            cursor: grab;
        }
        /* ドラッグ中はカーソルを変えて、テキスト選択・画像ドラッグを止める */
        .marquee-outer.is-dragging {
            cursor: grabbing;
            user-select: none;
        }
    }

    .marquee-track {
        display: flex;
        gap: 1.25rem;
        width: max-content;
    }

    .marquee-track :global(img) {
        -webkit-user-drag: none;
        user-select: none;
    }

    /* ---- post-card-mini: de-glass ---- */
    /* 枠・背景・hover(枠がシアン + オフセット影)は global.css の .ui-card 系 */
    .post-card-mini {
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        width: 280px;
        overflow: hidden;
        text-decoration: none;
        color: var(--text-main);
        position: relative;
    }

    /* カード下端のアクセントバー。Countdown の mission-bar と同じく
       左から伸びる。レイアウトには影響しない */
    .post-card-mini::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 2px;
        background: var(--accent-blue);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.35s cubic-bezier(0.2, 0, 0.2, 1);
        z-index: 3;
    }

    /* reveal: セクションが出たあと、カードが1枚ずつ持ち上がる
       (global.css の reveal-in を、セクションの .is-visible をきっかけに使う) */
    .recent-posts .post-card-mini {
        opacity: 0;
    }

    .recent-posts.is-visible .post-card-mini {
        opacity: 1;
        animation: reveal-in 0.55s var(--ease-out) backwards;
        animation-delay: calc(var(--i, 0) * 40ms);
    }

    @media (prefers-reduced-motion: reduce) {
        .recent-posts .post-card-mini {
            opacity: 1;
        }
        .recent-posts.is-visible .post-card-mini {
            animation: none;
        }
        .post-card-mini::after {
            transition: none;
        }
    }

    /* サムネ上の斜め clip-path ワイプ（yui540 演出）*/
    .post-thumb::after {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--accent-blue);
        opacity: 0.18;
        clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
        transition: clip-path 0.42s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
        z-index: 1;
    }

    @media (hover: hover) {
        .post-card-mini:hover .post-thumb::after {
            clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
        }

        /* 画像ズーム */
        .post-card-mini:hover .post-thumb img {
            transform: scale(1.05);
        }

        /* タイトル accent */
        .post-card-mini:hover .post-title {
            color: var(--accent-blue);
        }

        .post-card-mini:hover::after {
            transform: scaleX(1);
        }
    }

    .post-thumb {
