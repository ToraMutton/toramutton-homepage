                    </div>
                </div>
            </section>

            <script
                id="terminal-commands-data"
                type="application/json"
                set:html={JSON.stringify(terminalCommands)}
            />

            <div class="grid-container">
                <!-- Mini Terminal -->
                <div
                    class="widget-card ui-card ui-card-hover mini-terminal-card"
                    data-reveal
                    style="--i: 0"
                    data-mini-terminal
                >
                    <div class="card-header">
                        <span class="mini-terminal-dots" id="mt-dots">
                            <i
                                data-mt-dot="red"
                                role="button"
                                tabindex="0"
                                aria-label="reroll"></i>
                            <i
                                data-mt-dot="yellow"
                                role="button"
                                tabindex="0"
                                aria-label="reroll"></i>
                            <i
                                data-mt-dot="green"
                                role="button"
                                tabindex="0"
                                aria-label="reroll"></i>
                        </span>
                        <span class="mini-terminal-title">~/toramutton</span>
                    </div>
                    <div
                        class="card-body mini-terminal-body"
                        id="mini-terminal-body"
                    >
                        {
                            selectedCommands.map((c, i) => (
                                <div
                                    class="mt-block"
                                    data-cmd={c.cmd}
                                    data-out={c.out}
                                    data-index={i}
                                >
                                    <p class="mt-line">
                                        <span class="mt-prompt">$</span>
                                        <span class="mt-cmd" />
                                    </p>
                                    <p class="mt-out" />
                                </div>
                            ))
                        }
                        <p class="mt-line mt-cursor-line">
                            <span class="mt-prompt">$</span>
                            <span class="mt-cursor" id="mt-cursor">▌</span>
                        </p>
                    </div>
                </div>

                <!-- GitHub Contributions -->
                <div class="widget-card ui-card ui-card-hover gh-card" data-reveal style="--i: 1">
                    <div class="card-header">
                        <GitGraph class="icon-blue" size={16} />
                        <h3>GitHub Contributions</h3>
                        <span class="gh-total">{ghTotal} / yr</span>
                    </div>
                    <div class="card-body">
                        <div class="gh-grid" id="gh-grid">
                            {
                                contributionHistory.map((day, i) => (
                                    <div
                                        class={`gh-cell gh-level-${day.level}`}
                                        data-date={day.date}
                                        data-count={day.count}
                                        style={`--i:${i}`}
                                    />
                                ))
                            }
                        </div>
                        <div class="gh-tip" id="gh-tip" aria-hidden="true"></div>
                        <div class="gh-legend">
                            <span class="gh-legend-label">Less</span>
                            <div class="gh-cell gh-level-0"></div>
                            <div class="gh-cell gh-level-1"></div>
                            <div class="gh-cell gh-level-2"></div>
                            <div class="gh-cell gh-level-3"></div>
                            <div class="gh-cell gh-level-4"></div>
                            <span class="gh-legend-label">More</span>
                        </div>
                        <div class="dedicated-link">
                            <a
                                href="https://github.com/toramutton"
                                target="_blank"
                                rel="noopener noreferrer"
                                >View GitHub Profile →
