---
export const prerender = true;
import { getCollection } from "astro:content";
import Layout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
    SITE_TITLE,
    SITE_DESCRIPTION,
    TW_DAILY_URL,
    TW_TECH_URL,
    GITHUB_URL,
    NOTE_URL,
    ZENN_URL,
    QIITA_URL,
} from "../consts";
import { Image } from "astro:assets";
import heroImage from "../assets/toramutton.jpg";
import pcDesktopImg from "../assets/desktop/fastfetch.jpeg";
import pcCaseImg from "../assets/desktop/trapezium-8.png";
// note / Zenn / Qiita の取得は src/utils/feeds.ts に集約している
import { getExternalPosts } from "../utils/feeds";
import { adventCalendar, adventDays } from "../data/advent2026";
import { resolveAdventEntry } from "../utils/advent";
import {
    Twitter,
    Github,
    Sparkles,
    Target,
    Cpu,
    Music,
    Timer,
    GitGraph,
} from "lucide-astro";
// 表示する中身は src/data/home.ts にまとめてある
import {
    heroSpecs,
    terminalCommands,
    missions,
    uptimes,
} from "../data/home";

// === 記事一覧 ===
const isDev = import.meta.env.DEV;

// ローカル記事（下書きは dev でだけ見える）
const localPostsRaw = await getCollection('blog', ({ data }) => {
    return isDev || data.draft !== true;
});

const localPosts = localPostsRaw.map((post) => ({
    title: post.data.title,
    url: `/blog/${post.id}/`,
    date: post.data.pubDate,
    image: post.data.heroImage,
    tags: post.data.tags,
    source: 'local' as const,
}));

// note / Zenn / Qiita。取得は src/utils/feeds.ts に集約している
const externalPosts = await getExternalPosts();

// 統合・ソート・抽出
const latestPosts = [...localPosts, ...externalPosts]
    .sort((a, b) => b.date.valueOf() - a.date.valueOf())
    .slice(0, 10); // 最新記事、10選

// marquee のサムネは 280px 枠(2x で 560px)。元画像がそれより小さいときは
// 拡大すると逆に重くなるので、上限としてだけ使う
const THUMB_W = 560;

// === GitHub Contributions取得 ===
type ContributionDay = { date: string; count: number; level: number };
let ghContributions: ContributionDay[] = [];
let ghTotal = 0;
try {
    const ghRes = await fetch(
        "https://github-contributions-api.jogruber.de/v4/toramutton?y=last",
    );
    const ghData = await ghRes.json();
    ghTotal = ghData.total?.lastYear || 0;
    ghContributions = ghData.contributions || [];
} catch (e) {
    console.error("GitHub contributions fetch failed", e);
}
// 取得できた分は全部表示(y=last で約1年分)。カード自体が横長になったので出し切る
const contributionHistory = ghContributions;

// ランダムで3つ選ぶ（重複なし）
const shuffled = [...terminalCommands].sort(() => Math.random() - 0.5);
const selectedCommands = shuffled.slice(0, 3);

const today = new Date();
// バーグラフは固定365日を100%とした「残量ゲージ」。日が近づくほど縮む
const MISSION_WINDOW_DAYS = 365;
const missionData = missions.map((m) => {
    const target = new Date(m.date);
    const diff = target.getTime() - today.getTime();
    const days = Math.ceil(diff / (1000 * 60 * 60 * 24));
    const p = Math.min(Math.max(days, 0) / MISSION_WINDOW_DAYS, 1);
    return { ...m, days, p };
});

// === Advent 2026 カウントダウン ===
// 開催開始日(12/1)までの日数と、公開済みの日数を出しておく
const ADVENT_START = new Date(`${adventCalendar.year}-12-01T00:00:00+09:00`);
const adventDaysLeft = Math.ceil(
    (ADVENT_START.getTime() - today.getTime()) / (1000 * 60 * 60 * 24),
);
const resolvedAdventDays = adventDays
    .map((entry) => resolveAdventEntry(entry, localPostsRaw))
    .sort((a, b) => a.day - b.day);
const adventOpenCount = resolvedAdventDays.filter((entry) => entry.url).length;

// 円形グラフ: 25日分を円周上のセグメントにする(12時の位置から時計回り)
const RING_R = 40;
const RING_C = 50;
const RING_GAP_DEG = 3.5;
const ringPolar = (deg: number) => {
    const rad = ((deg - 90) * Math.PI) / 180;
    return [RING_C + RING_R * Math.cos(rad), RING_C + RING_R * Math.sin(rad)];
};
const ringStep = 360 / adventDays.length;
const ringSegments = resolvedAdventDays.map((d, i) => {
    const [x0, y0] = ringPolar(i * ringStep + RING_GAP_DEG / 2);
    const [x1, y1] = ringPolar((i + 1) * ringStep - RING_GAP_DEG / 2);
    return {
        day: d.day,
        status: d.url ? "open" : "locked",
        d: `M ${x0.toFixed(2)} ${y0.toFixed(2)} A ${RING_R} ${RING_R} 0 0 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`,
    };
});

---

