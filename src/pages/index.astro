        .line,
        .line.is-shown {
            transition: none;
        }
        .line.is-shown:not(.is-typed) [data-type] {
            animation: none;
        }
        .cursor-arrow {
            transition: none;
        }
        .dot-live {
            animation: none;
        }
        .ff-link::after,
        .ff-swatch,
        .ff-copied {
            transition: none;
        }
    }

    /* ====================================
