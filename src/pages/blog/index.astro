---
// ブログの一覧。トップの Blog セクションと同じ部品(PostTimeline)を、全件・並び替え・年区切りつきで置く。
// ローカル記事と note / Zenn / Qiita の統合は src/utils/all-posts.ts。
// 検索や並び順は URL に残さない(ブラウザ内で絞るだけ)。
export const prerender = true;
import Layout from "../../layouts/BaseLayout.astro";
import PostTimeline from "../../components/blog/PostTimeline.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
import ViewAll from "../../components/ui/ViewAll.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { adventHref, adventLabel, showAdventLink } from "../../utils/advent-link";
import { getAllPosts } from "../../utils/all-posts";

const posts = await getAllPosts();
const showAdvent = showAdventLink();
---

<Layout title={`${SITE_TITLE} | Blog`} description={SITE_DESCRIPTION} width="bare">
    <!-- 背景は、トップの各セクションと同じ --bg-deep(タイムラインのノードがこの色で軸を隠すため、そろえる) -->
    <div class="blog-page">
        <div class="inner">
            <div class="head">
                <SectionTitle as="h1" title="Blog" caption="書いたもの" />
                {showAdvent && (
                    <div class="aside">
                        <ViewAll href={adventHref} label={adventLabel} accent />
                    </div>
                )}
            </div>

            <PostTimeline {posts} sortable years />
        </div>
    </div>
</Layout>

<style>
    .blog-page {
        min-height: 100dvh;
        background: var(--bg-deep);
        /* 固定ヘッダー(72px)に隠れないぶんの上余白 */
        padding: calc(72px + clamp(2.5rem, 6vh, 4.5rem)) 0 clamp(4rem, 10vh, 7rem);
    }

    .inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    /* トップの HomeSection の見出し行と同じ。リンクは見出しの下端にそろえる */
    .head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .aside {
        padding-bottom: 2.5rem;
    }

    @media (max-width: 520px) {
        .head {
            flex-direction: column;
            align-items: flex-start;
            gap: 0;
        }

        .aside {
            margin-top: -1.5rem;
            padding-bottom: 2rem;
        }
    }
</style>
