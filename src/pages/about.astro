---
export const prerender = true;
import Layout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { Wrench, Heart, Monitor, GitGraph } from 'lucide-astro';
// 表示する中身は src/data/about.ts にまとめてある
import { SKILL_GROUPS, SKILL_LEVELS, INTERESTS, ENV_BLOCKS, TIMELINE } from '../data/about';
---

<Layout
    title="自己紹介 / About Me"
    description="トラマトのプロフィール、経歴、技術、環境など"
    width="narrow"
>
    <div class="about-content">
        <PageHeader
            command="cat ./README.md"
            title="About"
            description="トラマトのプロフィール、経歴、技術、環境など"
        />

        {/* 1. bio */}
        <section class="bio">
            <div class="bio-body" data-reveal>
                <p>
                    電気通信大学 情報理工学域 I 類の
                    <strong>ToraMutton / トラマト</strong>です。 寅松
                    真人(とらまつ まさと)はGrok君が考えてくれた偽名です。<br />
                    MMAというサークルに所属していて、 Twitterに生息しています。<br
                    />
                    Web・コンパイラ・LLMあたりに興味があり、 最近はArch LinuxとWindows11の両方でRicingを楽しんでます。
                </p>
            </div>

            <a
                class="bio-cta env-cmd"
                href="https://note.com/toramutton/n/n338320294cf6"
                target="_blank"
                rel="noopener noreferrer"
                data-reveal
                style="--i: 1"
            >
                <span class="env-dollar">$</span>
                <span class="env-cmd-text">cat ~/profile/intro.md</span>
                <span class="env-comment env-tag"
                    ># より詳しい自己紹介はこちら</span
                >
                <span class="env-arrow">↗</span>
            </a>
        </section>

        {/* 2. Skills & Tools */}
        <SectionHeading>
            <Wrench size={20} class="heading-icon" />
            Skills & Tools
        </SectionHeading>

        <section class="skill-section">
            <p class="skill-intro"># 使用している言語とかツールとか</p>
            <p class="skill-intro skill-legend">
                <span># 熟練度:</span>
                {
                    SKILL_LEVELS.map((lv) => (
                        <span class="legend-item">
                            <span class="legend-n">{lv.level}</span>
                            {lv.label}
                        </span>
                    ))
                }
            </p>

            {
                SKILL_GROUPS.map((group) => (
                    <div class="skill-category">
                        <div class="skill-cmd">
                            <span class="env-dollar">$</span>
                            <span class="skill-cmd-text">{group.cmd}</span>
                            <span class="env-comment">// {group.note}</span>
                        </div>
                        <div class="skill-grid">
                            {group.items.map((skill, i) => (
                                <div
                                    class="skill-card ui-card ui-card-hover"
                                    data-reveal
                                    style={`--i: ${i}`}
                                >
                                    <span
                                        class={`icon-wrapper ${skill.darkInvert ? "dark-invert" : ""}`}
                                    >
                                        <img
                                            src={skill.src}
                                            alt={skill.name}
                                            class="skill-img"
                                            width="48"
                                            height="48"
                                            loading="lazy"
                                        />
                                    </span>
                                    <span class="skill-meta">
                                        <span class="skill-name">
                                            {skill.name}
                                        </span>
                                        <span
                                            class="skill-level"
                                            role="img"
                                            aria-label={`熟練度 ${skill.level} / 5`}
                                        >
                                            {[1, 2, 3, 4, 5].map((n) => (
                                                <span
                                                    class:list={[
                                                        "lv-seg",
                                                        {
                                                            "is-on":
                                                                n <=
                                                                skill.level,
                                                        },
                                                    ]}
                                                />
                                            ))}
                                        </span>
                                    </span>
                                </div>
                            ))}
                        </div>
                    </div>
                ))
            }
        </section>

        {/* 3. Interests & Hobbies */}
        <SectionHeading>
            <Heart size={20} class="heading-icon" />
            Interests & Hobbies
        </SectionHeading>

        <div class="environments">
            <div
                class="env-terminal ui-card"
                aria-label="interests config"
                data-reveal
            >
                <div class="env-line env-promptline">
                    <span class="env-dollar">$</span>
                    <span class="env-typed">cat ~/.config/interests</span>
                </div>

                {
                    INTERESTS.map((block) => (
                        <div class="env-block">
                            <div class="env-line env-section-head">
                                <span class="env-bracket">[</span>
                                <span class="env-section">{block.section}</span>
                                <span class="env-bracket">]</span>
                            </div>
                            <div class="env-line int-row">
                                {block.items.map((item) => (
                                    <span class="int-tag">{item}</span>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        {/* 4. Environments */}
        <SectionHeading id="trapezium">
            <Monitor size={20} class="heading-icon" />
            Environments
        </SectionHeading>

        <div class="environments">
            <div
                class="env-terminal ui-card"
                aria-label="environments config"
                data-reveal
            >
                {/* prompt */}
                <div class="env-line env-promptline">
                    <span class="env-dollar">$</span>
                    <span class="env-typed">cat ~/.config/environments</span>
                </div>

                {/* output: ini blocks */}
                {
                    ENV_BLOCKS.map((block) => (
                        <div class="env-block">
                            <div class="env-line env-section-head">
                                <span class="env-bracket">[</span>
                                <span class="env-section">{block.section}</span>
                                <span class="env-bracket">]</span>
                                {block.meta && (
                                    <span class="env-comment">
                                        # {block.meta}
                                    </span>
                                )}
                            </div>
                            {block.rows.map((row) => (
                                <div class="env-line env-row">
                                    <span class="env-k">{row.k}</span>
                                    <span class="env-eq">=</span>
                                    <span class="env-v">{row.v}</span>
                                </div>
                            ))}
                            {block.link && (
                                <a
                                    class="env-line env-cmd env-cmd--inline"
                                    href={block.link.href}
                                >
                                    <span class="env-dollar">$</span>
                                    <span class="env-cmd-text">
                                        {block.link.cmd}
                                    </span>
                                    <span class="env-comment env-tag">
                                        # {block.link.tag}
                                    </span>
                                    <span class="env-arrow">→</span>
                                </a>
                            )}
                        </div>
                    ))
                }
            </div>
        </div>

        {/* 5. Timeline (git log style) */}
        <SectionHeading>
            <GitGraph size={20} class="heading-icon" />
            Timeline
        </SectionHeading>
        <div class="timeline" data-reveal>
            <div class="timeline-line" aria-hidden="true"></div>
            <div class="git-line" aria-hidden="true">
                <span class="git-dollar">$</span> git log --oneline --graph
            </div>
            {
                TIMELINE.map((item, i) => (
                    <div class="git-row" style={`--i: ${i}`}>
                        <span class="git-date">{item.date}</span>
                        <span class="git-msg">{item.desc}</span>
                    </div>
                ))
            }
        </div>
    </div>

    <style>
        /* === 1. 基本設定 === */
        .about-content {
            line-height: 1.8;
            color: var(--text-main);
        }

        .heading-icon {
            color: var(--accent-blue);
        }

        /* === ライトモード視認性調整 === */
        :global(html:not(.dark)) {
            .skill-cmd-text {
                color: #1d4ed8;
            }
        }

        /* === bio === */
        .bio {
            margin-bottom: 1rem;
        }

        .bio-body {
            padding-left: 1.2rem;
            border-left: 1px solid var(--border-color);
            color: var(--text-main);
            line-height: 1.9;
        }
        .bio-body p {
            margin: 0;
        }

        .bio-cta {
            margin-top: 1.5rem;
        }

        /* === Skills === */
        .skill-section {
            margin: 1rem 0 2rem;
        }
        .skill-intro {
            margin: 0 0 0.35rem;
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.85rem;
        }
        /* 凡例（5〜1 が何を意味するか）。折り返しても読める並び */
        .skill-intro.skill-legend {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 0.15rem 0.9rem;
            margin-bottom: 2rem;
            font-size: 0.78rem;
        }
        .legend-item {
            white-space: nowrap;
        }
        .legend-n {
            color: var(--accent-blue);
            font-weight: 700;
            margin-right: 0.3rem;
        }
        .skill-category {
            margin-bottom: 2.8rem;
        }
        .skill-cmd {
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            gap: 0 0.5rem;
            margin-bottom: 1.1rem;
            font-family: var(--font-mono);
        }
        .skill-cmd-text {
            color: var(--accent-blue);
            font-weight: 700;
        }

        .skill-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 0.8rem;
        }

        /* --- card: 枠・背景・hover は global.css の .ui-card 系 --- */
        .skill-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            padding: 1rem 0.4rem;
        }

        .icon-wrapper {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .skill-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        :global(html.dark) .icon-wrapper.dark-invert {
            filter: invert(0.92) hue-rotate(180deg) brightness(1.05);
        }

        /* 名前 + 熟練度メーターは1かたまり（card の gap とは別の詰め具合にする）*/
        .skill-meta {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.4rem;
        }
        .skill-name {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            font-weight: 700;
            line-height: 1;
            color: var(--text-muted);
            transition: color 0.25s ease;
        }

        /* --- 熟練度メーター（5分割ブロック）--- */
        .skill-level {
            display: flex;
            gap: 2px;
        }
        .lv-seg {
            width: 6px;
            height: 3px;
            background: var(--border-color);
            transition:
                background-color 0.25s ease,
                opacity 0.25s ease;
        }
        .lv-seg.is-on {
            background: var(--accent-blue);
            opacity: 0.6;
        }

        @media (hover: hover) {
            .skill-card:hover .skill-name {
                color: var(--accent-blue);
            }
            .skill-card:hover .lv-seg.is-on {
                opacity: 1;
            }
        }

        /* === Interests（env と共通のターミナル + 専用の行）=== */
        .int-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem 1.2rem;
            padding: 0.15rem 0 0.3rem 1.2rem;
        }
        .int-tag {
            position: relative;
            color: var(--text-main);
            font-family: var(--font-mono), var(--font-sans);
            cursor: default;
            transition: color 0.2s ease;
        }
        .int-tag::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -2px;
            width: 0;
            height: 1px;
            background: var(--accent-blue);
            transition: width 0.25s ease;
        }
        @media (hover: hover) {
            .int-tag:hover {
                color: var(--accent-blue);
            }
            .int-tag:hover::after {
                width: 100%;
            }
        }

        /* === Timeline (git log --graph 風) === */
        .timeline {
            margin: 1rem 0 3rem 0.35rem;
            font-family: var(--font-mono);
            position: relative;
        }
        /* 縦線は出現後に上から下へ描かれ、各行のマーカーがそれを追いかける */
        .timeline-line {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 1px;
            background: var(--border-color);
            transform: scaleY(0);
            transform-origin: top;
            transition: transform 1.2s ease-out;
        }
        .timeline.is-visible .timeline-line {
            transform: scaleY(1);
        }
        .git-line {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin: 0 0 1.2rem 1.4rem;
            user-select: none;
        }
        .git-dollar {
            color: var(--accent-blue);
            opacity: 0.8;
            margin-right: 0.4rem;
        }
        .git-row {
            position: relative;
            display: grid;
            grid-template-columns: auto 1fr;
            column-gap: 0.85rem;
            align-items: baseline;
            padding: 0.55rem 0 0.55rem 1.4rem;
        }
        .git-row::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0.65rem;
            width: 6px;
            height: 6px;
            background: var(--background);
            border: 1.5px solid var(--accent-blue);
            transform: translateX(-50%) rotate(45deg) scale(0);
            opacity: 0;
            transition:
                transform 0.35s var(--ease-out),
                opacity 0.35s ease;
            transition-delay: calc(var(--i, 0) * 130ms);
        }
        .timeline.is-visible .git-row::before {
            transform: translateX(-50%) rotate(45deg) scale(1);
            opacity: 1;
        }
        .git-date {
            color: var(--accent-blue);
            font-size: 0.9rem;
            font-weight: 700;
            white-space: nowrap;
        }
        .git-msg {
            color: var(--text-main);
            font-family: var(--font-mono), var(--font-sans);
            font-size: 0.92rem;
            transition: color 0.2s ease;
        }
        @media (hover: hover) {
            .git-row:hover .git-msg {
                color: var(--accent-blue);
            }
            .git-row:hover::before {
                transform: translateX(-50%) rotate(45deg) scale(1.3);
                background: var(--accent-blue);
                transition-delay: 0s;
            }
        }
        @media (prefers-reduced-motion: reduce) {
            .timeline-line,
            .git-row::before {
                transition: none;
            }
            .timeline-line {
                transform: scaleY(1);
            }
            .git-row::before {
                transform: translateX(-50%) rotate(45deg) scale(1);
                opacity: 1;
            }
        }

        /* === Environments / Interests 共通ターミナル === */
        .environments {
            margin: 1rem 0 3rem;
            --env-key-w: 8rem;
        }
        .env-terminal {
            padding: 1.25rem 1.25rem 1.4rem;
            font-family: var(--font-mono);
            font-size: 0.92rem;
            line-height: 1.7;
            overflow-x: auto;
        }
        .env-dollar {
            color: var(--accent-blue);
            opacity: 0.8;
            margin-right: 0.6rem;
            user-select: none;
        }
        .env-promptline {
            color: var(--text-main);
            margin-bottom: 1rem;
        }
        .env-block {
            margin-bottom: 1.2rem;
        }
        .env-block:last-of-type {
            margin-bottom: 0;
        }
        .env-section-head {
            margin: 0.2rem 0 0.3rem;
        }
        .env-bracket {
            color: var(--accent-blue);
            opacity: 0.5;
        }
        .env-section {
            color: var(--accent-blue);
            font-weight: 700;
        }
        .env-comment {
            color: var(--text-muted);
            margin-left: 0.8rem;
            font-size: 0.85em;
        }
        .env-row {
            display: grid;
            grid-template-columns: var(--env-key-w) 1ch 1fr;
            column-gap: 0.6rem;
            align-items: baseline;
            padding: 0.1rem 0.5rem;
            margin: 0 -0.5rem;
            border-radius: 4px;
            transition: background-color 0.15s ease;
        }
        .env-k {
            color: var(--text-muted);
            white-space: nowrap;
        }
        .env-eq {
            color: var(--text-muted);
            opacity: 0.6;
        }
        .env-v {
            color: var(--text-main);
            font-family: var(--font-mono), var(--font-sans);
            word-break: break-word;
        }
        .env-cmd {
            display: flex;
            align-items: baseline;
            text-decoration: none;
            color: var(--text-main);
            padding: 0.25rem 0.5rem;
            margin: 0 -0.5rem;
            border-radius: 4px;
            font-family: var(--font-mono);
            transition:
                background-color 0.15s ease,
                color 0.15s ease;
        }
        .env-cmd--inline {
            margin-top: 0.6rem;
        }
        .env-tag {
            margin-left: 0.8rem;
        }
        .env-arrow {
            margin-left: 0.5rem;
            color: var(--accent-blue);
            transform: translateX(-4px);
            opacity: 0;
            transition:
                transform 0.2s ease,
                opacity 0.2s ease;
        }
        @media (hover: hover) {
            .env-row:hover {
                background-color: color-mix(
                    in srgb,
                    var(--accent-blue) 10%,
                    transparent
                );
            }
            .env-row:hover .env-k {
                color: var(--accent-blue);
            }
            .env-cmd:hover {
                background-color: color-mix(
                    in srgb,
                    var(--accent-blue) 10%,
                    transparent
                );
            }
            .env-cmd:hover .env-cmd-text {
                color: var(--accent-blue);
            }
            .env-cmd:hover .env-arrow {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* === レスポンシブ === */
        @media (max-width: 900px) {
            .skill-grid {
                grid-template-columns: repeat(5, 1fr);
            }
        }
        @media (max-width: 768px) {
            .environments {
                --env-key-w: 6.5rem;
            }
            .env-terminal {
                font-size: 0.82rem;
                padding: 1rem;
            }
            .env-comment {
                display: block;
                margin-left: 0;
            }
            .env-cmd {
                flex-wrap: wrap;
            }
            .int-row {
                padding-left: 0.8rem;
            }
        }
        @media (max-width: 640px) {
            .skill-grid {
                grid-template-columns: repeat(4, 1fr);
                gap: 0.6rem;
            }
            .skill-card {
                padding: 0.8rem 0.3rem;
            }
            .icon-wrapper {
                width: 36px;
                height: 36px;
            }
            .skill-name {
                font-size: 0.65rem;
            }
            .skill-meta {
                gap: 0.35rem;
            }
            /* 4カラムでもメーターが card 幅を超えないよう少し詰める */
            .lv-seg {
                width: 5px;
            }
        }
    </style>
</Layout>
