---
export const prerender = true;
import Layout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import { ExternalLink, Github, CheckCircle2, Hammer, Lightbulb } from 'lucide-astro';
// 作品データは src/data/works.ts にまとめてある
import { works } from '../data/works';

const completedWorks = works.filter((w) => w.status === 'completed');
const inProgressWorks = works.filter((w) => w.status === 'in-progress');
const plannedWorks = works.filter((w) => w.status === 'planned');
---

<Layout
    title={`${SITE_TITLE} | Works`}
    description="制作物一覧"
    width="narrow"
>
            <section class="works-section">
                <PageHeader
                    command="ls ./works"
                    title="Works"
                    description="制作した・現在進行中・予定のプロジェクト"
                />

                {
                    completedWorks.length > 0 && (
                        <>
                            <SectionHeading>
                                <CheckCircle2 size={20} class="completed-icon" />
                                Completed
                            </SectionHeading>
                            <ul class="works-list">
                                {completedWorks.map((work) => (
                                    <li class:list={["work-row", { "has-link": Boolean(work.url || work.github) }]}>
                                        {work.image && (
                                            <div class="work-image-layer">
                                                <Image
                                                    src={work.image}
                                                    alt=""
                                                    loading="lazy"
                                                />
                                            </div>
                                        )}
                                        <span class="work-icon-cell">
                                            <work.icon size={20} />
                                        </span>
                                        <div class="work-main">
                                            <span class="work-name">
                                                {(work.url || work.github) ? (
                                                    <a
                                                        href={work.url || work.github}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                    >
                                                        {work.name}
                                                    </a>
                                                ) : (
                                                    work.name
                                                )}
                                            </span>
                                            <div class="work-tags">
                                                {work.tags.map((tag) => (
                                                    <span class="work-tag">
                                                        {tag}
                                                    </span>
                                                ))}
                                            </div>
                                        </div>
                                        <p class="work-desc-text">
                                            {work.description}
                                        </p>
                                        <div class="work-right">
                                            <span class="work-year">
                                                {work.year}
                                            </span>
                                            <div class="work-links">
                                                {work.url && (
                                                    <a
                                                        href={work.url}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="work-link"
                                                        aria-label="Visit site"
                                                    >
                                                        <ExternalLink
                                                            size={16}
                                                        />
                                                    </a>
                                                )}
                                                {work.github && (
                                                    <a
                                                        href={work.github}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="work-link"
                                                        aria-label="GitHub repository"
                                                    >
                                                        <Github size={16} />
                                                    </a>
                                                )}
                                            </div>
                                        </div>
                                    </li>
                                ))}
                            </ul>
                        </>
                    )
                }

                {
                    inProgressWorks.length > 0 && (
                        <>
                            <SectionHeading>
                                <Hammer size={20} class="progress-icon" />
                                In Progress
                            </SectionHeading>
                            <ul class="works-list">
                                {inProgressWorks.map((work) => (
                                    <li class:list={["work-row", "in-progress", { "has-link": Boolean(work.github) }]}>
                                        <span class="work-icon-cell">
                                            <work.icon size={20} />
                                        </span>
                                        <div class="work-main">
                                            <span class="work-name">
                                                {(work.url || work.github) ? (
                                                    <a
                                                        href={work.url || work.github}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                    >
                                                        {work.name}
                                                    </a>
                                                ) : (
                                                    work.name
                                                )}
                                            </span>
                                            <div class="work-tags">
                                                {work.tags.map((tag) => (
                                                    <span class="work-tag">
                                                        {tag}
                                                    </span>
                                                ))}
                                            </div>
                                        </div>
                                        <p class="work-desc-text">
                                            {work.description}
                                        </p>
                                        <div class="work-right">
                                            <span class="work-year">
                                                {work.year}
                                            </span>
                                            <div class="work-links">
                                                {work.github && (
                                                    <a
                                                        href={work.github}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="work-link"
                                                        aria-label="GitHub repository"
                                                    >
                                                        <Github size={16} />
                                                    </a>
                                                )}
                                            </div>
                                        </div>
                                    </li>
                                ))}
                            </ul>
                        </>
                    )
                }

                {
                    plannedWorks.length > 0 && (
                        <>
                            <SectionHeading>
                                <Lightbulb size={20} class="planned-icon" />
                                Planned
                            </SectionHeading>
                            <ul class="works-list">
                                {plannedWorks.map((work) => (
                                    <li class="work-row planned">
                                        <span class="work-icon-cell">
                                            <work.icon size={20} />
                                        </span>
                                        <div class="work-main">
                                            <span class="work-name">
                                                {work.name}
                                            </span>
                                            <div class="work-tags">
                                                {work.tags.map((tag) => (
                                                    <span class="work-tag">
                                                        {tag}
                                                    </span>
                                                ))}
                                            </div>
                                        </div>
                                        <p class="work-desc-text">
                                            {work.description}
                                        </p>
                                        <div class="work-right">
                                            <span class="work-year">
                                                {work.year}
                                            </span>
                                        </div>
                                    </li>
                                ))}
                            </ul>
                        </>
                    )
                }
            </section>
</Layout>

<style>

    /* ヘッダ部は components/PageHeader.astro、
       セクション見出しは components/SectionHeading.astro */
    .completed-icon {
        color: #22c55e;
    }

    .progress-icon {
        color: var(--accent-blue);
    }

    .planned-icon {
        color: var(--text-muted);
    }

    /* =========================================
       3. Row list
       ========================================= */
    .works-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
    }

    .work-row {
        display: grid;
        grid-template-columns: 2rem 1fr 2fr auto;
        gap: 1.5rem;
        align-items: center;
        padding: 1rem 0 1rem 0.75rem;
        border-bottom: 1px solid var(--border-color);
        border-radius: 0;
        position: relative;
        overflow: hidden;
        transition:
            background-color 0.2s ease,
            border-bottom-color 0.2s ease;
    }

    /* hover対応デバイスのみ。行の強調はリンクのある行だけ
       (Blog 一覧と同じ見た目だが、クリックできるのは作品名のリンク) */
    @media (hover: hover) {
        .work-row.has-link:hover {
            background-color: color-mix(in srgb, var(--accent-blue) 4%, transparent);
            border-bottom-color: var(--accent-blue);
        }
    }

    /* =========================================
       4. 各セル
       ========================================= */
    .work-icon-cell {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
    }

    .work-main {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 0;
    }

    .work-name {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-main);
        line-height: 1.3;
        font-family: var(--font-mono, "JetBrains Mono", monospace);
        word-break: break-word;
        position: relative;
        padding-left: 0;
        transition:
            padding-left 0.25s ease,
            color 0.2s ease;
    }

    .work-name::before {
        content: "▸";
        position: absolute;
        left: 0;
        top: 50%;
        transform: translate(-0.5rem, -50%);
        color: var(--accent-blue);
        opacity: 0;
        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
        font-family: var(--font-mono, "JetBrains Mono", monospace);
    }

    .work-name a {
        color: inherit;
        text-decoration: none;
    }

    @media (hover: hover) {
        .work-row.has-link:hover .work-name {
            padding-left: 1rem;
            color: var(--accent-blue);
        }
        .work-row.has-link:hover .work-name::before {
            opacity: 1;
            transform: translate(0, -50%);
        }
    }

    .work-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
    }

    .work-tag {
        font-family: var(--font-mono, "JetBrains Mono", monospace);
        font-size: 0.7rem;
        border: 1px solid var(--border-color);
        border-radius: 0;
        padding: 0.1em 0.4em;
        color: var(--text-muted);
        background: transparent;
        font-weight: 500;
    }

    .work-desc-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 0;
    }

    .work-right {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        flex-shrink: 0;
    }

    .work-year {
        font-family: var(--font-mono, "JetBrains Mono", monospace);
        color: var(--text-muted);
        font-size: 0.8rem;
        white-space: nowrap;
    }

    .work-links {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .work-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.25rem;
        border: none;
        background: transparent;
        border-radius: 0;
        transition: color 0.2s ease;
    }

    @media (hover: hover) {
        .work-link:hover {
            color: var(--accent-blue);
        }
    }

    /* =========================================
   5. ステータス別装飾 & 画像レイヤー
   ========================================= */

    /* planned：rowごと薄く */
    .work-row.planned {
        opacity: 0.5;
    }

    /* 画像レイヤー */
    .work-image-layer {
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        width: 45%;
        z-index: 0;
        pointer-events: none;
        clip-path: polygon(15% 0, 100% 0, 100% 100%, 0 100%);
        -webkit-mask-image: linear-gradient(
            to left,
            black 0%,
            black 30%,
            transparent 100%
        );
        mask-image: linear-gradient(
            to left,
            black 0%,
            black 30%,
            transparent 100%
        );
        opacity: 0.35;
        transition: opacity 0.3s ease;
    }

    .work-image-layer img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .work-image-layer::after {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--background);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    @media (hover: hover) {
        .work-row.has-link:hover .work-image-layer::after {
            opacity: 0.5; /* ホバー時に暗いオーバーレイが乗る */
        }
    }

    /* テキスト要素を画像より前面に */
    .work-icon-cell,
    .work-main,
    .work-desc-text,
    .work-right {
        position: relative;
        z-index: 1;
    }

    /* タグの背景（画像と重なったとき読みやすくする） */
    .work-tag {
        background: var(--background);
    }

    /* =========================================
       6. モバイル対応
       ========================================= */
    @media (max-width: 720px) {

        .work-row {
            grid-template-columns: 2rem 1fr auto;
            grid-template-rows: auto auto;
            gap: 0.5rem 1rem;
            padding: 1rem 0;
        }

        .work-icon-cell {
            grid-row: 1;
            grid-column: 1;
        }

        .work-main {
            grid-row: 1;
            grid-column: 2;
        }

        .work-right {
            grid-row: 1;
            grid-column: 3;
        }

        .work-desc-text {
            grid-row: 2;
            grid-column: 1 / -1;
            font-size: 0.8rem;
            padding-left: 0;
        }

        .work-name {
            font-size: 0.9rem;
        }
    }
</style>
