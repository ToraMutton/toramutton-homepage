---
// アドベントカレンダー 2026。
// 公開の判定(日付・リンク解決)は utils/advent.ts、記事の割り当ては data/advent2026.ts。
// 見た目は /links と同じ「見出し + 細い線と文字」。右上に小さな 25 分割の進捗リング。
//   開催中 … 今日のマス(ブラウザ側で JST から判定)の線を、小さな光が走る
//   12/26 以降 … 「完成した記録」。今日の印は出さず、リングのすき間が閉じて 1 本の円になる
export const prerender = true;
import { ArrowUpRight } from "lucide-astro";
import Layout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import AdventExtra from "../components/advent/AdventExtra.astro";
import AdventDay from "../components/advent/AdventDay.astro";
import AdventRing from "../components/advent/AdventRing.astro";
import { SITE_TITLE } from "../consts";
import { getVisiblePosts } from "../utils/post";
import { resolveAdventCalendar } from "../utils/advent";
import { advent2026 as calendar } from "../data/advent2026";

const { prologue, epilogue, days, openCount } = await resolveAdventCalendar(calendar, await getVisiblePosts(), {
    fetchOgp: true,
});
const { year } = calendar;

// 毎朝の再ビルドで焼き直されるので、ビルド時点の日付で「終わったか」を決める
const complete = new Date() >= new Date(`${year}-12-26T00:00:00+09:00`);

const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const firstDow = new Date(Date.UTC(year, 11, 1)).getUTCDay();
const columnOf = (day: number) => ((firstDow + day - 1) % 7) + 1;

const pro = { label: "Prologue", entry: prologue, pending: "はじまりの記事" };
const epi = { label: "Epilogue", entry: epilogue, pending: "12.26 公開" };
---

<Layout
    title={`${SITE_TITLE} | Advent ${year}`}
    description={`トラマトの一人アドベントカレンダー${year}。12月1日から25日までの記事をここに。`}
    width="bare"
>
    <div class="advent-page" data-advent data-year={year} data-complete={complete ? "" : undefined}>
        <div class="inner">
            <div class="head">
                <SectionTitle as="h1" title={`Advent ${year}`} caption="トラマト一人アドベントカレンダー" />
                <div class="aside">
                    <AdventRing open={days.map((d) => Boolean(d.url))} {complete} />
                    <div class="aside-text">
                        <span class="count">
                            <b>{String(openCount).padStart(2, "0")}</b> / {days.length}
                            {complete && <span class="done">complete</span>}
                        </span>
                        {
                            calendar.adventarUrl && (
                                <a class="adventar" href={calendar.adventarUrl} target="_blank" rel="noopener noreferrer">
                                    Adventar
                                    <ArrowUpRight size={14} strokeWidth={1.5} aria-hidden="true" />
                                </a>
                            )
                        }
                    </div>
                </div>
            </div>

            <AdventExtra {...pro} />

            <div class="calendar">
                <div class="weekdays" aria-hidden="true">
                    {weekdays.map((w, i) => <span class:list={{ weekend: i === 0 || i === 6 }}>{w}</span>)}
                </div>
                <ol class="days">
                    {days.map((entry) => <AdventDay {entry} {year} column={columnOf(entry.day)} />)}
                </ol>
            </div>

            <AdventExtra {...epi} />
        </div>
    </div>
</Layout>

<script>
    // 今日のマスに印を付ける。静的ページなので、ビルドの日ではなく見ている瞬間の JST で判定する。
    // 終わった後(data-complete)は「完成した記録」なので何もしない。
    // 確認用: dev サーバーだけ、?today=5 で「今日」を指定できる(本番ビルドでは無効)
    function markToday() {
        const root = document.querySelector<HTMLElement>("[data-advent]");
        if (!root) return;
        const preview = import.meta.env.DEV && new URLSearchParams(location.search).get("today");
        if (preview) {
            root.querySelector(`[data-day="${Number(preview)}"]`)?.setAttribute("data-today", "");
            return;
        }
        if (root.hasAttribute("data-complete")) return;
        const jst = new Date(Date.now() + 9 * 60 * 60 * 1000);
        if (jst.getUTCFullYear() !== Number(root.dataset.year) || jst.getUTCMonth() !== 11) return;
        root.querySelector(`[data-day="${jst.getUTCDate()}"]`)?.setAttribute("data-today", "");
    }
    document.addEventListener("astro:page-load", markToday);
</script>

<style>
    /* 背景と余白は /links・/blog とそろえる */
    .advent-page {
        min-height: 100dvh;
        background: var(--bg-deep);
        padding: calc(72px + clamp(2.5rem, 6vh, 4.5rem)) 0 clamp(4rem, 10vh, 7rem);
    }

    .inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    /* ---- 見出し行(/links と同じ組み方) ---- */
    .head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .aside {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding-bottom: 2.5rem;
    }

    .aside-text {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
    }

    .count {
        color: var(--text-muted);
        white-space: nowrap;
    }

    .count b {
        color: var(--text);
        font-weight: 700;
    }

    .done {
        margin-left: 0.5rem;
        color: var(--accent);
    }

    .adventar {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.25s ease;
    }

    @media (hover: hover) {
        .adventar:hover {
            color: var(--accent);
        }
    }

    /* ---- 暦 ---- */
    .calendar {
        margin: 3rem 0;
    }

    .weekdays,
    .days {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        column-gap: 1.25rem;
    }

    .weekdays {
        margin-bottom: 0.9rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

    .weekdays .weekend {
        color: var(--accent);
    }

    .days {
        row-gap: 2.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    @media (max-width: 900px) {
        .weekdays,
        .days {
            column-gap: 0.75rem;
        }
        .days {
            row-gap: 1.5rem;
        }
    }

    @media (max-width: 720px) {
        .head {
            flex-direction: column;
            align-items: flex-start;
            gap: 0;
        }
        .aside {
            margin-top: -1rem;
            padding-bottom: 2rem;
        }
    }

    /* スマホは暦をやめて 1 列(曜日の行は要らない) */
    @media (max-width: 640px) {
        .calendar {
            margin: 1.5rem 0;
        }
        .weekdays {
            display: none;
        }
        .days {
            grid-template-columns: minmax(0, 1fr);
            row-gap: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .adventar {
            transition: none;
        }
    }
</style>
