---
export const prerender = true;
import { getVisiblePosts } from "../utils/post";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AdventDayCard from "../components/AdventDayCard.astro";
import { SITE_TITLE } from "../consts";
import { fetchOgpImage } from "../utils/rss";
import {
    adventDays,
    adventKickoff,
    adventFinale,
    type AdventEntry,
    type AdventSource,
} from "../data/advent2026";
import { Rocket, Milestone } from "lucide-astro";

// === 記事データの解決 ===
// status: "locked" のエントリは title/note を一切参照せず、
// 問答無用で「ロック状態」だけを返す(=HTMLにネタバレが出ない)
const localPosts = await getVisiblePosts();

interface ResolvedEntry {
    status: "locked" | "open";
    url?: string;
    title?: string;
    image?: any;
    source?: AdventSource;
}

async function resolveEntry(entry: AdventEntry): Promise<ResolvedEntry> {
    if (entry.status !== "open") {
        return { status: "locked" };
    }

    // ローカル記事: blog collectionからタイトル・サムネ・URLを自動取得
    if (entry.source === "local" && entry.slug) {
        const post = localPosts.find((p) => p.id === entry.slug);
        if (!post) {
            // 記事が見つからない場合は安全側でロック扱いにしておく
            return { status: "locked" };
        }
        return {
            status: "open",
            url: `/blog/${post.id}/`,
            title: post.data.title,
            image: post.data.heroImage,
            source: "local",
        };
    }

    // 外部記事(note/Zenn/Qiita): OGP画像をビルド時に取得
    if (entry.url) {
        const image = await fetchOgpImage(entry.url);
        return {
            status: "open",
            url: entry.url,
            title: entry.title,
            image,
            source: entry.source,
        };
    }

    // open指定だがリンク先未設定(例: 記事を書く前の「開始」バナー)
    // → 見た目はアンロックだが、クリックはできない状態として扱う
    return { status: "open" };
}

const resolvedDays = await Promise.all(adventDays.map(resolveEntry));
const resolvedKickoff = await resolveEntry(adventKickoff);
const resolvedFinale = await resolveEntry(adventFinale);

// === カレンダーの曜日配置 ===
const WEEK_START = 0; // 0 = 日曜始まり, 1 = 月曜始まり
const weekdayLabels =
    WEEK_START === 0
        ? ["日", "月", "火", "水", "木", "金", "土"]
        : ["月", "火", "水", "木", "金", "土", "日"];

const firstDow = new Date(2026, 11, 1).getDay(); // 0=日 ... 6=土
const columnOf = (day: number) => {
    const dow = (firstDow + (day - 1)) % 7;
    return ((dow - WEEK_START + 7) % 7) + 1;
};
---

<!doctype html>
<html lang="ja">
    <head>
        <BaseHead
            title={`${SITE_TITLE} | Advent 2026`}
            description="トラマト一人アドベントカレンダー2026"
        />
    </head>
    <body>
        <Header />
        <main>
            <section class="advent-section">
                <div class="advent-header">
                    <h1 class="advent-title">
                        トラマトの一人アドベントカレンダー2026
                    </h1>
                    <p class="advent-command">
                        <span class="prompt">$</span> ./advent2026
                    </p>
                    <p class="advent-desc">
                        トラマトによるはじめての一人アドベントカレンダー2026。<br
                        />
                        12月1日から25日まで、たぶん毎日1記事更新します。
                    </p>
                </div>

                <AdventDayCard
                    status={resolvedKickoff.status}
                    url={resolvedKickoff.url}
                    title={resolvedKickoff.title}
                    image={resolvedKickoff.image}
                    source={resolvedKickoff.source}
                    sublabel="EXTRA"
                    label="Begin"
                    special
                    openIcon={Rocket}
                />

                <div class="calendar-grid">
                    {
                        weekdayLabels.map((wlabel, i) => {
                            const actualDow = (WEEK_START + i) % 7;
                            return (
                                <span
                                    class={`weekday-cell ${actualDow === 0 ? "sun" : ""} ${actualDow === 6 ? "sat" : ""}`}
                                    style={`grid-column: ${i + 1};`}
                                    aria-hidden="true"
                                >
                                    {wlabel}
                                </span>
                            );
                        })
                    }

                    {
                        resolvedDays.map((r, i) => (
                            <AdventDayCard
                                status={r.status}
                                url={r.url}
                                title={r.title}
                                image={r.image}
                                source={r.source}
                                sublabel="Dec"
                                label={i + 1}
                                gridColumn={columnOf(i + 1)}
                            />
                        ))
                    }
                </div>

                <AdventDayCard
                    status={resolvedFinale.status}
                    url={resolvedFinale.url}
                    title={resolvedFinale.title}
                    image={resolvedFinale.image}
                    source={resolvedFinale.source}
                    sublabel="EXTRA"
                    label="Finish"
                    special
                    openIcon={Milestone}
                />
            </section>
        </main>
        <Footer />
    </body>
</html>

<style>
    main {
        max-width: 900px;
        margin: 0 auto;
        padding: 6rem 1.5rem 3rem;
    }

    /* === Header === */
    .advent-header {
        margin-bottom: 3rem;
        border-bottom: 1px dashed var(--border-color);
        padding-bottom: 1.5rem;
    }

    .advent-title {
        font-size: 1.9rem;
        margin: 0 0 0.6rem;
        color: var(--text-main);
        letter-spacing: 0.01em;
    }

    .advent-command {
        margin: 0 0 1rem;
        font-family: var(--font-mono, "JetBrains Mono", monospace);
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .prompt {
        color: var(--accent-blue);
    }

    .advent-desc {
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* === 番外編バー(カレンダーの上下に独立配置) === */
    .advent-section > :global(.day-card.special) {
        display: block;
        margin: 1.5rem 0;
    }

    /* === Grid(PC: 曜日整列の7列カレンダー) === */
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.8rem;
    }

    .weekday-cell {
        text-align: center;
        font-family: var(--font-mono, "JetBrains Mono", monospace);
        font-size: 0.8rem;
        color: var(--text-muted);
        padding-bottom: 0.5rem;
        border-bottom: 1px dashed var(--border-color);
    }

    .weekday-cell.sun,
    .weekday-cell.sat {
        color: color-mix(in srgb, var(--accent-blue) 55%, var(--text-muted));
    }

    /* === レスポンシブ: スマホは縦1列のロウリストに切り替え === */
    @media (max-width: 720px) {
        main {
            padding: 5rem 1rem 2rem;
        }

        .advent-title {
            font-size: 1.5rem;
        }

        .calendar-grid {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .weekday-cell {
            display: none;
        }
    }
</style>
