---
export const prerender = true;
import Layout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import AdventDayCard from "../components/AdventDayCard.astro";
import { SITE_TITLE } from "../consts";
import { getVisiblePosts } from "../utils/post";
import { fetchOgpImage } from "../utils/rss";
import { resolveAdventEntry } from "../utils/advent";
import {
    adventCalendar,
    adventDays,
    adventKickoff,
    adventFinale,
} from "../data/advent2026";
import { ArrowUpRight, CalendarDays, Lock, BookOpen } from "lucide-astro";

const localPosts = await getVisiblePosts();
const entries = await Promise.all(
    [...adventDays, adventKickoff, adventFinale].map(async (entry) => {
        const resolved = resolveAdventEntry(entry, localPosts);
        if (resolved.url && resolved.source !== "local") {
            resolved.image = await fetchOgpImage(resolved.url);
        }
        return resolved;
    }),
);
const resolvedDays = entries
    .slice(0, adventDays.length)
    .sort((a, b) => a.day - b.day);
const [resolvedKickoff, resolvedFinale] = entries.slice(adventDays.length);
const openCount = resolvedDays.filter((entry) => entry.url).length;
const year = adventCalendar.year;
const weekdayLabels = ["日", "月", "火", "水", "木", "金", "土"];
const firstDow = new Date(Date.UTC(year, 11, 1)).getUTCDay();
const columnOf = (day: number) => ((firstDow + day - 1) % 7) + 1;

// トップページの円形メーターと同じく、1セグメント = 1日。
const ringStep = 360 / resolvedDays.length;
const polar = (deg: number) => {
    const rad = ((deg - 90) * Math.PI) / 180;
    return [50 + 40 * Math.cos(rad), 50 + 40 * Math.sin(rad)];
};
const ringSegments = resolvedDays.map((entry, index) => {
    const [x0, y0] = polar(index * ringStep + 2);
    const [x1, y1] = polar((index + 1) * ringStep - 2);
    return {
        ...entry,
        path: `M ${x0.toFixed(2)} ${y0.toFixed(2)} A 40 40 0 0 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`,
    };
});
---

<Layout
    title={`${SITE_TITLE} | Advent ${year}`}
    description={`トラマトの一人アドベントカレンダー${year}。12月1日から25日までの記事をここに。`}
    width="narrow"
>
    <section class="advent-page">
        <PageHeader
            command={`./advent${year}`}
            title={`Advent ${year}`}
            description="トラマトによるはじめての一人アドベントカレンダー。12月1日から25日まで、頑張って毎日1記事更新します。"
        >
            <p class="advent-meta" slot="meta">
                <span
                    ><CalendarDays size={14} aria-hidden="true" />
                    {year}.12.01 — 12.25</span
                >
                <span
                    ><BookOpen size={14} aria-hidden="true" />
                    {openCount} / {resolvedDays.length} 記事公開</span
                >
            </p>
            <div
                class="progress-ring"
                slot="aside"
                role="img"
                aria-label={`${resolvedDays.length}記事中${openCount}記事公開済み`}
            >
                <svg viewBox="0 0 100 100" aria-hidden="true">
                    {
                        ringSegments.map((entry, index) => (
                            <path
                                d={entry.path}
                                class:list={[
                                    "ring-segment",
                                    { "is-open": Boolean(entry.url) },
                                ]}
                                style={`--i:${index}`}
                            />
                        ))
                    }
                </svg>
                <div class="progress-center" aria-hidden="true">
                    <span class="progress-count"
                        >{String(openCount).padStart(2, "0")}</span
                    >
                    <span class="progress-total">/ {resolvedDays.length}</span>
                </div>
            </div>
        </PageHeader>

        <section id="calendar" class="calendar-section">
            <SectionHeading id="calendar-heading">
                <CalendarDays size={20} class="heading-icon" />
                December {year}
                <span class="calendar-legend" slot="aside">
                    <span
                        ><BookOpen
                            size={12}
                            class="legend-open"
                            aria-hidden="true"
                        />公開済み</span
                    >
                    <span><Lock size={12} aria-hidden="true" />公開待ち</span>
                </span>
            </SectionHeading>

            <div class="extra-entry" data-reveal>
                <AdventDayCard
                    {...resolvedKickoff}
                    sublabel="PROLOGUE"
                    label="Begin"
                    special
                />
            </div>
            <div class="calendar-grid">
                {
                    weekdayLabels.map((label, index) => (
                        <span
                            class:list={[
                                "weekday-cell",
                                { weekend: index === 0 || index === 6 },
                            ]}
                            aria-hidden="true"
                        >
                            {label}
                        </span>
                    ))
                }
                {
                    resolvedDays.map((entry) => (
                        <div
                            class="calendar-cell"
                            id={`day-${entry.day}`}
                            style={`--column:${columnOf(entry.day)}; --i:${columnOf(entry.day) - 1}`}
                            data-reveal
                        >
                            <AdventDayCard
                                {...entry}
                                sublabel="DEC"
                                label={entry.day}
                            />
                        </div>
                    ))
                }
            </div>
            <div class="extra-entry" data-reveal>
                <AdventDayCard
                    {...resolvedFinale}
                    sublabel="EPILOGUE"
                    label="Finish"
                    special
                />
            </div>
        </section>

        <section aria-labelledby="adventar-heading">
            <SectionHeading id="adventar-heading">
                <ArrowUpRight size={20} class="heading-icon" />
                Adventar
            </SectionHeading>
            <div class="adventar-panel ui-card" data-reveal>
                <p class="adventar-copy">
                    {
                        adventCalendar.adventarUrl
                            ? "Adventarにも同じカレンダーを置いています。"
                            : "Adventarにも同じカレンダーを置く予定です。公開までお待ちください。"
                    }
                </p>
                {
                    adventCalendar.adventarUrl ? (
                        <a
                            class="adventar-link"
                            href={adventCalendar.adventarUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Adventarで見る
                            <ArrowUpRight size={15} aria-hidden="true" />
                            <span class="sr-only">（新しいタブで開く）</span>
                        </a>
                    ) : (
                        <span class="adventar-pending">カレンダー準備中</span>
                    )
                }
            </div>
        </section>
    </section>
</Layout>

<style>
    /* =========================================
       1. ヘッダ部(進捗リング・メタ情報)
       ========================================= */
    .advent-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.25rem;
        margin: 0.75rem 0 0;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.78rem;
    }

    .advent-meta > span {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .progress-ring {
        position: relative;
        flex-shrink: 0;
        width: 120px;
        aspect-ratio: 1;
    }

    .progress-ring svg {
        display: block;
        width: 100%;
        height: 100%;
        fill: none;
    }

    .ring-segment {
        stroke: var(--border-color);
        stroke-width: 9;
        transform-origin: 50px 50px;
    }

    .ring-segment.is-open {
        stroke: var(--accent-blue);
    }

    .progress-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        line-height: 1;
    }

    .progress-count {
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.04em;
        font-variant-numeric: tabular-nums;
    }

    .progress-total {
        margin-top: 0.3rem;
        font-size: 0.7rem;
        color: var(--text-muted);
    }

    /* ヘッダーが出現したあと、リングの日付セグメントを順に描く */
    @media (prefers-reduced-motion: no-preference) {
        :global([data-reveal].is-visible) .ring-segment {
            animation: segment-enter 0.5s var(--ease-out) backwards;
            animation-delay: calc(0.15s + var(--i) * 25ms);
        }

        @keyframes segment-enter {
            from {
                opacity: 0;
                transform: scale(0.88) rotate(-6deg);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }
    }

    /* =========================================
       2. カレンダー
       ========================================= */
    .calendar-section {
        scroll-margin-top: 90px;
    }

    .heading-icon {
        color: var(--accent-blue);
    }

    .calendar-legend,
    .calendar-legend > span {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .calendar-legend {
        gap: 1rem;
        flex-shrink: 0;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
    }

    .calendar-legend :global(.legend-open) {
        color: var(--accent-blue);
    }

    .extra-entry {
        margin: 1rem 0;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 0.6rem;
        margin: 1rem 0;
    }

    .weekday-cell {
        text-align: center;
        padding: 0.4rem 0;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
    }

    .weekday-cell.weekend {
        color: var(--accent-blue);
    }

    .calendar-cell {
        min-width: 0;
        grid-column: var(--column);
        scroll-margin-top: 100px;
    }

    .calendar-cell:target {
        outline: 2px solid var(--accent-blue);
        outline-offset: 3px;
        border-radius: var(--radius);
    }

    /* =========================================
       3. Adventar
       ========================================= */
    .adventar-panel {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        padding: 1.25rem 1.5rem;
    }

    .adventar-copy {
        flex: 1;
        min-width: 0;
        margin: 0;
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    .adventar-link,
    .adventar-pending {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        flex-shrink: 0;
        padding: 0.45rem 0.9rem;
        border: 1px solid var(--border-color);
        border-radius: 0;
        font-family: var(--font-mono);
        font-size: 0.82rem;
        text-decoration: none;
        white-space: nowrap;
    }

    .adventar-link {
        color: var(--text-muted);
        transition:
            color 0.18s ease,
            border-color 0.18s ease;
    }

    .adventar-pending {
        color: var(--text-muted);
        border-style: dashed;
    }

    @media (hover: hover) {
        .adventar-link:hover {
            color: var(--accent-blue);
            border-color: var(--accent-blue);
        }
    }

    .adventar-link:focus-visible {
        outline: 2px solid var(--accent-blue);
        outline-offset: 3px;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    /* =========================================
       4. モバイル
       ========================================= */
    @media (max-width: 720px) {
        .calendar-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 0;
        }

        .calendar-cell {
            grid-column: auto;
            --i: 0 !important;
        }

        .weekday-cell {
            display: none;
        }

        .adventar-panel {
            flex-wrap: wrap;
            padding: 1rem 1.2rem;
        }

        .adventar-link,
        .adventar-pending {
            justify-content: center;
            width: 100%;
        }
    }

    @media (max-width: 640px) {
        .progress-ring {
            width: 100px;
        }
    }
</style>
