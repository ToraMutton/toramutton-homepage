---
export const prerender = true;

import Layout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
import friendLinks from "../data/links.json";
import faviconMapJson from "../data/favicon-map.json";
import { ExternalLink, Users } from "lucide-astro";

const getDomain = (url: string) => {
    try {
        return new URL(url).hostname.replace(/^www\./, "");
    } catch {
        return url;
    }
};

// icon が null のサイトは `npm run favicons` が生成した対応表を使う。
// ページ描画時にはネットワークへアクセスしない。
const faviconMap: Record<string, string> = faviconMapJson;
const links = friendLinks.map((link) => ({
    ...link,
    domain: getDomain(link.url),
    icon: link.icon ?? faviconMap[link.url] ?? null,
}));
---

<Layout
    title={`${SITE_TITLE} | Links`}
    description="トラマトの相互リンク一覧"
    width="narrow"
>
    <section class="links-page">
        <header class="links-intro" data-reveal>
            <p class="links-command">
                <span class="prompt">$</span> ls ~/links
            </p>
            <div class="title-row">
                <div>
                    <h1>Links</h1>
                    <p class="links-description">
                        友人や知り合いのウェブサイトを集めた相互リンク集です。
                    </p>
                </div>
                <span class="links-count">
                    <Users size={16} aria-hidden="true" />
                    {links.length} sites
                </span>
            </div>
        </header>

        <ol class="links-grid" data-links-grid>
            {
                links.map((link, index) => (
                    <li class="link-entry" style={`--i:${index}`}>
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-item"
                        >
                            <span class="link-icon" aria-hidden="true">
                                {link.icon ? (
                                    <img
                                        class="link-favicon"
                                        src={link.icon}
                                        alt=""
                                        width="48"
                                        height="48"
                                        decoding="async"
                                        loading="lazy"
                                    />
                                ) : (
                                    <span class="link-initial">
                                        {link.name.trim().charAt(0)}
                                    </span>
                                )}
                            </span>

                            <span class="link-body">
                                <span class="link-heading">
                                    <span class="link-name">{link.name}</span>
                                    <ExternalLink
                                        class="link-arrow"
                                        size={15}
                                        aria-hidden="true"
                                    />
                                </span>
                                <span class="link-domain" title={link.domain}>
                                    {link.domain}
                                </span>
                                <span class="link-description">
                                    {link.description}
                                </span>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ol>
    </section>

    <Fragment slot="body-end">
        <script>
            const initializeLinksPage = () => {
                const reduceMotion = window.matchMedia(
                    "(prefers-reduced-motion: reduce)",
                ).matches;
                const intro = document.querySelector(".links-intro");
                const grid = document.querySelector<HTMLElement>(
                    "[data-links-grid]",
                );

                if (!intro || !grid) return;
                if (grid.dataset.linksInitialized === "true") return;
                grid.dataset.linksInitialized = "true";

                if (reduceMotion) {
                    intro.classList.add("is-visible");
                    grid.classList.add("is-visible");
                    return;
                }

                const observer = new IntersectionObserver(
                    (entries, currentObserver) => {
                        entries.forEach((entry) => {
                            if (!entry.isIntersecting) return;
                            entry.target.classList.add("is-visible");
                            currentObserver.unobserve(entry.target);
                        });
                    },
                    { threshold: 0.08, rootMargin: "0px 0px -6% 0px" },
                );

                observer.observe(intro);
                observer.observe(grid);
            };

            // ClientRouter での遷移と、イベント発火後にこのモジュールが
            // 評価される初回直アクセスの両方を初期化する。
            document.addEventListener("astro:page-load", initializeLinksPage);
            initializeLinksPage();
        </script>
    </Fragment>
</Layout>

<style>
    .links-page {
        color: var(--text-main);
    }

    .links-intro {
        padding: 0 0 1.5rem;
        border-bottom: 1px solid var(--border-color);
        opacity: 0;
        transform: translateY(12px);
        transition:
            opacity 0.45s ease,
            transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
            border-color 0.3s ease;
    }

    .links-intro.is-visible {
        opacity: 1;
        transform: none;
    }

    .links-command {
        margin: 0 0 0.6rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.82rem;
    }

    .prompt {
        color: var(--accent-blue);
        font-weight: 700;
    }

    .title-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
    }

    h1 {
        display: block;
        margin: 0 0 0.35rem;
        color: var(--text-main);
        font-family: var(--font-mono);
        font-size: 2rem;
        letter-spacing: -0.02em;
    }

    .links-description {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    .links-count {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        flex-shrink: 0;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.78rem;
    }

    .links-count :global(svg) {
        color: var(--accent-blue);
    }

    .links-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem;
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 0;
    }

    .link-entry {
        min-width: 0;
        opacity: 0;
    }

    .links-grid.is-visible .link-entry {
        opacity: 1;
        animation: link-pop 0.45s cubic-bezier(0.2, 0, 0.2, 1) backwards;
        animation-delay: calc(var(--i, 0) * 35ms);
    }

    @keyframes link-pop {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    .link-item {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        height: 100%;
        min-width: 0;
        padding: 1rem;
        overflow: hidden;
        color: var(--text-main);
        background: var(--surface);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        text-decoration: none;
        transition:
            border-color 0.18s ease,
            box-shadow 0.35s cubic-bezier(0.2, 0, 0.2, 1);
    }

    .link-item::after {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--accent-blue);
        opacity: 0.08;
        clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
        transition: clip-path 0.42s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
    }

    .link-icon {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        overflow: hidden;
        background: var(--elevated);
        border: 1px solid var(--border-color);
        border-radius: 50%;
        transition:
            border-color 0.25s ease,
            transform 0.25s cubic-bezier(0.2, 0, 0.2, 1);
    }

    .link-favicon {
        display: block;
        width: 100%;
        height: 100%;
        padding: 7px;
        object-fit: contain;
        border-radius: 50%;
        box-shadow: none;
    }

    .link-initial {
        color: var(--accent-blue);
        font-family: var(--font-mono);
        font-size: 1.1rem;
        font-weight: 800;
        line-height: 1;
    }

    .link-body {
        position: relative;
        z-index: 1;
        display: flex;
        flex: 1;
        flex-direction: column;
        min-width: 0;
    }

    .link-heading {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .link-name {
        overflow: hidden;
        color: var(--text-main);
        font-family: var(--font-mono);
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.4;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 0.18s ease;
    }

    .link-arrow {
        margin-left: auto;
        flex-shrink: 0;
        color: var(--text-muted);
        opacity: 0.45;
        transform: translate(-2px, 2px);
        transition:
            color 0.18s ease,
            opacity 0.18s ease,
            transform 0.18s ease;
    }

    .link-domain {
        overflow: hidden;
        margin-top: 0.08rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        opacity: 0.8;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 0.18s ease;
    }

    .link-description {
        margin-top: 0.45rem;
        color: var(--text-muted);
        font-size: 0.78rem;
        line-height: 1.6;
    }

    @media (hover: hover) {
        .link-item:hover {
            border-color: var(--accent-blue);
            box-shadow: 5px 5px 0 var(--accent-blue);
        }

        .link-item:hover::after {
            clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
        }

        .link-item:hover .link-name,
        .link-item:hover .link-domain,
        .link-item:hover .link-arrow {
            color: var(--accent-blue);
        }

        .link-item:hover .link-arrow {
            opacity: 1;
            transform: none;
        }

        .link-item:hover .link-icon {
            border-color: var(--accent-blue);
            transform: scale(1.08);
        }
    }

    .link-item:focus-visible {
        outline: 2px solid var(--accent-blue);
        outline-offset: 3px;
    }

    @media (max-width: 640px) {
        .title-row {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.8rem;
        }

        .links-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .links-intro,
        .link-entry {
            opacity: 1;
            transform: none;
            transition: none;
        }

        .links-grid.is-visible .link-entry {
            animation: none;
        }

        .link-item,
        .link-item::after,
        .link-icon,
        .link-arrow,
        .link-name,
        .link-domain {
            transition: none;
        }
    }
</style>
