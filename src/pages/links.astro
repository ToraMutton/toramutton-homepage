---
export const prerender = true;

import Layout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE_TITLE } from "../consts";
import friendLinks from "../data/links.json";
import faviconMapJson from "../data/favicon-map.json";
import { ExternalLink, Users } from "lucide-astro";

const getDomain = (url: string) => {
    try {
        return new URL(url).hostname.replace(/^www\./, "");
    } catch {
        return url;
    }
};

// icon が null のサイトは `npm run favicons` が生成した対応表を使う。
// ページ描画時にはネットワークへアクセスしない。
const faviconMap: Record<string, string> = faviconMapJson;
const links = friendLinks.map((link) => ({
    ...link,
    domain: getDomain(link.url),
    icon: link.icon ?? faviconMap[link.url] ?? null,
}));
---

<Layout
    title={`${SITE_TITLE} | Links`}
    description="トラマトの相互リンク一覧"
    width="narrow"
>
    <section class="links-page">
        <PageHeader
            command="ls ~/links"
            title="Links"
            description="友人や知り合いのウェブサイトを集めた相互リンク集です。"
        >
            <span class="links-count" slot="aside">
                <Users size={16} aria-hidden="true" />
                {links.length} sites
            </span>
        </PageHeader>

        <ol class="links-grid">
            {
                links.map((link, index) => (
                    <li class="link-entry" style={`--i:${index}`} data-reveal>
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-item ui-card ui-card-link"
                        >
                            <span class="link-icon" aria-hidden="true">
                                {link.icon ? (
                                    <img
                                        class="link-favicon"
                                        src={link.icon}
                                        alt=""
                                        width="48"
                                        height="48"
                                        decoding="async"
                                        loading="lazy"
                                    />
                                ) : (
                                    <span class="link-initial">
                                        {link.name.trim().charAt(0)}
                                    </span>
                                )}
                            </span>

                            <span class="link-body">
                                <span class="link-heading">
                                    <span class="link-name">{link.name}</span>
                                    <ExternalLink
                                        class="link-arrow"
                                        size={15}
                                        aria-hidden="true"
                                    />
                                </span>
                                <span class="link-domain" title={link.domain}>
                                    {link.domain}
                                </span>
                                <span class="link-description">
                                    {link.description}
                                </span>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ol>
    </section>

</Layout>

<style>
    .links-page {
        color: var(--text-main);
    }

    .links-count {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        flex-shrink: 0;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.78rem;
    }

    .links-count :global(svg) {
        color: var(--accent-blue);
    }

    .links-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .link-entry {
        min-width: 0;
    }

    /* 枠・背景・hover(枠がシアン + オフセット影)は global.css の .ui-card 系 */
    .link-item {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        height: 100%;
        min-width: 0;
        padding: 1rem;
        color: var(--text-main);
        text-decoration: none;
    }

    .link-icon {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        overflow: hidden;
        background: var(--elevated);
        border: 1px solid var(--border-color);
        border-radius: 50%;
        transition:
            border-color 0.25s ease,
            transform 0.25s cubic-bezier(0.2, 0, 0.2, 1);
    }

    .link-favicon {
        display: block;
        width: 100%;
        height: 100%;
        padding: 7px;
        object-fit: contain;
        border-radius: 50%;
        box-shadow: none;
    }

    .link-initial {
        color: var(--accent-blue);
        font-family: var(--font-mono);
        font-size: 1.1rem;
        font-weight: 800;
        line-height: 1;
    }

    .link-body {
        position: relative;
        z-index: 1;
        display: flex;
        flex: 1;
        flex-direction: column;
        min-width: 0;
    }

    .link-heading {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .link-name {
        overflow: hidden;
        color: var(--text-main);
        font-family: var(--font-mono);
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.4;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 0.18s ease;
    }

    .link-arrow {
        margin-left: auto;
        flex-shrink: 0;
        color: var(--text-muted);
        opacity: 0.45;
        transform: translate(-2px, 2px);
        transition:
            color 0.18s ease,
            opacity 0.18s ease,
            transform 0.18s ease;
    }

    .link-domain {
        overflow: hidden;
        margin-top: 0.08rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        opacity: 0.8;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 0.18s ease;
    }

    .link-description {
        margin-top: 0.45rem;
        color: var(--text-muted);
        font-size: 0.78rem;
        line-height: 1.6;
    }

    @media (hover: hover) {
        .link-item:hover .link-name,
        .link-item:hover .link-domain,
        .link-item:hover .link-arrow {
            color: var(--accent-blue);
        }

        .link-item:hover .link-arrow {
            opacity: 1;
            transform: none;
        }

        .link-item:hover .link-icon {
            border-color: var(--accent-blue);
            transform: scale(1.08);
        }
    }

    @media (max-width: 640px) {
        .links-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .link-icon,
        .link-arrow,
        .link-name,
        .link-domain {
            transition: none;
        }
    }
</style>
