---
// 相互リンクのページ。
// 上が相手サイトの索引(PeerDirectory)、下がこのサイトにリンクを張る人向けの情報(ConnectPanel)。
// サイトを追加するときは src/data/links.json に書いて `npm run favicons`。
export const prerender = true;

import Layout from "../layouts/BaseLayout.astro";
import ConnectPanel from "../components/links/ConnectPanel.astro";
import PeerDirectory from "../components/links/PeerDirectory.astro";
import { SITE_TITLE } from "../consts";
---

<Layout title={`${SITE_TITLE} | Links`} description="トラマトの相互リンク一覧" width="bare">
    <div class="links-page">
        <div class="inner">
            <PeerDirectory />
            <ConnectPanel />
        </div>
    </div>
</Layout>

<style>
    /* 背景と余白は /blog とそろえる */
    .links-page {
        min-height: 100dvh;
        background: var(--bg-deep);
        /* 固定ヘッダー(72px)に隠れないぶんの上余白 */
        padding: calc(72px + clamp(2.5rem, 6vh, 4.5rem)) 0 clamp(4rem, 10vh, 7rem);
    }

    .inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.5rem;
    }
</style>
