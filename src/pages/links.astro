---
export const prerender = true;

import Layout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE_TITLE } from "../consts";
import friendLinks from "../data/links.json";
import faviconMapJson from "../data/favicon-map.json";
import { BookOpen, Dices, ExternalLink, Users } from "lucide-astro";

const getDomain = (url: string) => {
    try {
        return new URL(url).hostname.replace(/^www\./, "");
    } catch {
        return url;
    }
};

// icon が null のサイトは `npm run favicons` が生成した対応表を使う。
// ページ描画時にはネットワークへアクセスしない。
const faviconMap: Record<string, string> = faviconMapJson;
const links = friendLinks.map((link) => ({
    ...link,
    domain: getDomain(link.url),
    icon: link.icon ?? faviconMap[link.url] ?? null,
}));
---

<Layout
    title={`${SITE_TITLE} | Links`}
    description="トラマトの相互リンク一覧"
    width="narrow"
>
    <section class="links-page">
        <PageHeader
            command="ls ~/links"
            title="Links"
            description="友人や知り合いのウェブサイトを集めた相互リンク集です。"
        >
            <p class="links-story" slot="meta">
                <BookOpen size={15} aria-hidden="true" />
                <span>
                    Zennで公開している<a
                        href="https://zenn.dev/toramutton/books/homepage-guide"
                        target="_blank"
                        rel="noopener noreferrer">ホームページ制作ガイド</a
                    >を読んで自分のサイトを作ってくれた人達もいます。
                </span>
            </p>

            <div class="links-aside" slot="aside">
                <span class="links-count">
                    <Users size={16} aria-hidden="true" />
                    {links.length} sites
                </span>
                <button type="button" class="random-jump" data-random-jump>
                    <Dices size={16} aria-hidden="true" />
                    <span class="random-jump-label">Random Jump</span>
                </button>
            </div>
        </PageHeader>

        {/* 抽選結果のアナウンス（画面には出さず、読み上げだけに使う） */}
        <p class="sr-only" aria-live="polite" data-random-status></p>

        <ol class="links-grid">
            {
                links.map((link, index) => (
                    <li
                        class="link-entry"
                        style={`--i:${index}`}
                        data-reveal
                        data-link-entry
                        data-link-name={link.name}
                    >
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-item ui-card ui-card-link"
                        >
                            <span class="link-icon" aria-hidden="true">
                                {link.icon ? (
                                    <img
                                        class="link-favicon"
                                        src={link.icon}
                                        alt=""
                                        width="48"
                                        height="48"
                                        decoding="async"
                                        loading="lazy"
                                    />
                                ) : (
                                    <span class="link-initial">
                                        {link.name.trim().charAt(0)}
                                    </span>
                                )}
                            </span>

                            <span class="link-body">
                                <span class="link-heading">
                                    <span class="link-name">{link.name}</span>
                                    <ExternalLink
                                        class="link-arrow"
                                        size={15}
                                        aria-hidden="true"
                                    />
                                </span>
                                <span class="link-domain" title={link.domain}>
                                    {link.domain}
                                </span>
                                <span class="link-description">
                                    {link.description}
                                </span>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ol>
    </section>
</Layout>

<script>
    // Random Jump 🎲
    // 「どれが当たったか」を見せてから飛ばしたいので、
    //   1. サイコロを回す(短い演出)
    //   2. 当たったカードまでスクロールして強調
    //   3. 少し見せてから別タブで開く
    // の3段階にしている。
    //
    // 3 の window.open は click から時間が空くと popup blocker に弾かれうるので、
    // 弾かれた場合はカードにフォーカスを移して、本人の Enter で開けるようにする。
    document.addEventListener("astro:page-load", () => {
        const button =
            document.querySelector<HTMLButtonElement>("[data-random-jump]");
        const status = document.querySelector<HTMLElement>(
            "[data-random-status]",
        );
        const entries = Array.from(
            document.querySelectorAll<HTMLLIElement>("[data-link-entry]"),
        );
        if (!button || entries.length === 0) return;

        const reduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        // 演出の長さ。reduced-motion のときは待たせず即座に飛ばす
        const ROLL_MS = reduced ? 0 : 380;
        const SHOW_MS = reduced ? 0 : 620;

        let timers: number[] = [];
        const clearTimers = () => {
            timers.forEach((id) => window.clearTimeout(id));
            timers = [];
        };

        button.addEventListener("click", () => {
            clearTimers();
            entries.forEach((entry) => entry.removeAttribute("data-picked"));

            const picked = entries[Math.floor(Math.random() * entries.length)];
            const anchor = picked.querySelector<HTMLAnchorElement>("a[href]");
            if (!anchor) return;

            button.dataset.rolling = "";

            timers.push(
                window.setTimeout(() => {
                    delete button.dataset.rolling;
                    picked.dataset.picked = "";
                    // reveal 待ちのカードが当たっても見えるようにしておく
                    picked.classList.add("is-visible");
                    picked.scrollIntoView({
                        behavior: reduced ? "auto" : "smooth",
                        block: "center",
                    });
                    if (status) {
                        status.textContent = `${picked.dataset.linkName ?? "サイト"} に飛びます`;
                    }

                    timers.push(
                        window.setTimeout(() => {
                            const opened = window.open(
                                anchor.href,
                                "_blank",
                                "noopener",
                            );
                            // ブロックされたら本人のアクションで開いてもらう
                            if (!opened) anchor.focus();
                        }, SHOW_MS),
                    );
                }, ROLL_MS),
            );
        });

        document.addEventListener("astro:before-swap", clearTimers, {
            once: true,
        });
    });
</script>

<style>
    .links-page {
        color: var(--text-main);
    }

    .sr-only {
        position: absolute;
        overflow: hidden;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        border: 0;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    /* --- ヘッダー左下のストーリー行 --- */
    .links-story {
        display: flex;
        align-items: flex-start;
        gap: 0.45rem;
        margin: 0.6rem 0 0;
        color: var(--text-muted);
        font-size: 0.82rem;
        line-height: 1.7;
    }

    .links-story :global(svg) {
        flex-shrink: 0;
        margin-top: 0.25rem;
        color: var(--accent-blue);
    }

    .links-story a {
        color: var(--accent-blue);
        font-weight: 600;
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.18s ease;
    }

    .links-story a:hover {
        border-bottom-color: var(--accent-blue);
    }

    /* --- ヘッダー右側（件数 + サイコロ） --- */
    .links-aside {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        flex-shrink: 0;
    }

    .links-count {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        flex-shrink: 0;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.78rem;
    }

    .links-count :global(svg) {
        color: var(--accent-blue);
    }

    .random-jump {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        flex-shrink: 0;
        padding: 0.45rem 0.75rem;
        background: var(--surface);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        color: var(--text-main);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        cursor: pointer;
        transition:
            border-color 0.18s ease,
            color 0.18s ease,
            background 0.18s ease;
    }

    .random-jump :global(svg) {
        color: var(--accent-blue);
        transition: transform 0.18s ease;
    }

    @media (hover: hover) {
        .random-jump:hover {
            border-color: var(--accent-blue);
            color: var(--accent-blue);
        }

        .random-jump:hover :global(svg) {
            transform: rotate(-18deg);
        }
    }

    /* 抽選中はボタンを押せなくして、サイコロだけ回す */
    .random-jump[data-rolling] {
        pointer-events: none;
        border-color: var(--accent-blue);
        color: var(--accent-blue);
    }

    .random-jump[data-rolling] :global(svg) {
        animation: dice-roll 0.4s linear infinite;
    }

    @keyframes dice-roll {
        to {
            transform: rotate(360deg);
        }
    }

    .links-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .link-entry {
        min-width: 0;
    }

    /* 全ページ共通の [data-reveal] は --i(通し番号)がそのまま遅延になるため、
       件数の多いこのページではスクロール追従が悪くなる。段差は数件分だけ残して頭打ちにする。 */
    .link-entry[data-reveal].is-visible {
        animation-duration: 0.4s;
        animation-delay: calc(min(var(--i, 0), 3) * 40ms);
    }

    /* 枠・背景・hover(枠がシアン + オフセット影)は global.css の .ui-card 系 */
    .link-item {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        height: 100%;
        min-width: 0;
        padding: 1rem;
        color: var(--text-main);
        text-decoration: none;
    }

    .link-icon {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        overflow: hidden;
        background: var(--elevated);
        border: 1px solid var(--border-color);
        border-radius: 50%;
        transition:
            border-color 0.25s ease,
            transform 0.25s cubic-bezier(0.2, 0, 0.2, 1);
    }

    .link-favicon {
        display: block;
        width: 100%;
        height: 100%;
        padding: 7px;
        object-fit: contain;
        border-radius: 50%;
        box-shadow: none;
    }

    .link-initial {
        color: var(--accent-blue);
        font-family: var(--font-mono);
        font-size: 1.1rem;
        font-weight: 800;
        line-height: 1;
    }

    .link-body {
        position: relative;
        z-index: 1;
        display: flex;
        flex: 1;
        flex-direction: column;
        min-width: 0;
    }

    .link-heading {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .link-name {
        overflow: hidden;
        color: var(--text-main);
        font-family: var(--font-mono);
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.4;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 0.18s ease;
    }

    .link-arrow {
        margin-left: auto;
        flex-shrink: 0;
        color: var(--text-muted);
        opacity: 0.45;
        transform: translate(-2px, 2px);
        transition:
            color 0.18s ease,
            opacity 0.18s ease,
            transform 0.18s ease;
    }

    .link-domain {
        overflow: hidden;
        margin-top: 0.08rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        opacity: 0.8;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 0.18s ease;
    }

    .link-description {
        margin-top: 0.45rem;
        color: var(--text-muted);
        font-size: 0.78rem;
        line-height: 1.6;
    }

    @media (hover: hover) {
        .link-item:hover .link-name,
        .link-item:hover .link-domain,
        .link-item:hover .link-arrow {
            color: var(--accent-blue);
        }

        .link-item:hover .link-arrow {
            opacity: 1;
            transform: none;
        }

        .link-item:hover .link-icon {
            border-color: var(--accent-blue);
            transform: scale(1.08);
        }
    }

    /* --- サイコロで当たったカード --- */
    /* 飛ぶ前に「どれが当たったか」を必ず見せるための強調表示 */
    .link-entry[data-picked] .link-item {
        border-color: var(--accent-blue);
        box-shadow: var(--shadow-offset);
        transform: translate(-2px, -2px);
    }

    .link-entry[data-picked] .link-name,
    .link-entry[data-picked] .link-domain,
    .link-entry[data-picked] .link-arrow {
        color: var(--accent-blue);
    }

    .link-entry[data-picked] .link-arrow {
        opacity: 1;
        transform: none;
    }

    .link-entry[data-picked] .link-icon {
        border-color: var(--accent-blue);
        animation: picked-pulse 0.5s var(--ease-out) 2;
    }

    @keyframes picked-pulse {
        50% {
            transform: scale(1.14);
        }
    }

    @media (max-width: 720px) {
        .random-jump-label {
            display: none;
        }

        .random-jump {
            padding: 0.45rem 0.55rem;
        }
    }

    @media (max-width: 640px) {
        .links-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .link-icon,
        .link-arrow,
        .link-name,
        .link-domain,
        .random-jump,
        .random-jump :global(svg) {
            transition: none;
        }

        .random-jump[data-rolling] :global(svg),
        .link-entry[data-picked] .link-icon {
            animation: none;
        }
    }
</style>
