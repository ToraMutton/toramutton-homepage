---
// /lab/room/ 専用の骨組み。共有ヘッダーやフッターは触らず、テーマの仕組みだけ BaseHead から借りる。
import BaseHead from "../components/BaseHead.astro";
import "../styles/room-prototype.css";
import {
  SECTION_IDS,
  SECTION_LABELS,
} from "../data/roomPrototype";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<html lang="ja">
  <head>
    <BaseHead {title} {description} />
    <script is:inline>
      // 部屋は夜の照明で作っているので、常にダークで見せる。
      // 保存済みの好み(localStorage)は書き換えないので、他のページは今までどおり。
      // BaseHead は画面遷移のたびにテーマを付け直すため、その後にもう一度上書きする
      (function () {
        var force = function () {
          if (document.getElementById("room-app")) document.documentElement.classList.add("dark");
        };
        document.documentElement.classList.add("dark");
        if (!window.__roomForceDark) {
          window.__roomForceDark = true;
          document.addEventListener("astro:after-swap", force);
        }
      })();
    </script>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="room-body">
    <script is:inline>
      // CSS の切り替えが最初の描画に間に合うよう、JS の有無だけ先に印を付ける
      document.body.dataset.js = "1";
    </script>
    <header class="room-header">
      <a class="room-logo" href="/">toramutton<span>.me</span></a>
      <nav class="room-nav" aria-label="部屋の章">
        {
          SECTION_IDS.map((id) => (
            <a href={`#${id}`} data-room-link={id}>
              {SECTION_LABELS[id]}
            </a>
          ))
        }
      </nav>
    </header>
    <slot />
  </body>
</html>
