---
// ローカル記事のレイアウト。
//   ≥1024px … [操作ボタン] [本文(最大 960px)] [プロフィール + 目次 + おすすめ]
//   それ未満 … 本文 1 列。目次はヘッダーのボタンから開くドロワー、おすすめは本文の後
// 部品は components/post/。本文の中身の装飾はこのファイルの <style>。
import { Image } from "astro:assets";
import { ARTICLE_IMAGE_WIDTHS, ARTICLE_IMAGE_SIZES } from "../utils/rehype-responsive-images.mjs";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";

import Layout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ViewAll from "../components/ui/ViewAll.astro";
import AdventBadge from "../components/post/AdventBadge.astro";
import PostActions from "../components/post/PostActions.astro";
import PostPager from "../components/post/PostPager.astro";
import PostProfile from "../components/post/PostProfile.astro";
import PostRecommend from "../components/post/PostRecommend.astro";
import PostToc from "../components/post/PostToc.astro";
import Snow from "../components/post/Snow.astro";
import { adventLabelOf } from "../utils/advent-post";
import { getVisiblePosts } from "../utils/post";

type Props = CollectionEntry<"blog">["data"] & {
    /** 記事の id(フォルダ名)。前後記事・おすすめの判定に使う */
    id: string;
    /** Markdown 本文。文字数と読了目安の算出に使う */
    body?: string;
    headings?: MarkdownHeading[];
};

const {
    id,
    body = "",
    title,
    description,
    pubDate,
    updatedDate,
    heroImage,
    tags = [],
    headings = [],
} = Astro.props;

// アドベントカレンダーの記事には、ツリーと雪を添える
const advent = adventLabelOf(id);

const shareText = `${title} | トラマト`;
const tweetUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(Astro.url.href)}`;

// --- 文字数と読了目安 ---
// Markdown の記法・コード・画像・import 行を落として本文の文字だけ数える
const plainText = body
    .replace(/```[\s\S]*?```/g, "")
    .replace(/^import\s.*$/gm, "")
    .replace(/<[^>]+>/g, "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/^https?:\/\/\S+$/gm, "")
    .replace(/[#>*|`_~-]/g, "")
    .replace(/\s/g, "");
const charCount = plainText.length;
// 日本語の読書速度はおおよそ 500 字/分
const readMinutes = Math.max(1, Math.round(charCount / 500));

// --- 目次は h2 / h3 まで(h4 は本文内の小見出しに留める) ---
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

// --- 前後の記事とおすすめ ---
const allPosts = (await getVisiblePosts()).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentIndex = allPosts.findIndex((post) => post.id === id);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const olderPost =
    currentIndex >= 0 && currentIndex < allPosts.length - 1
        ? allPosts[currentIndex + 1]
        : undefined;

// 前後の記事は本文の下に出るので、おすすめはそれ以外から 3 本。
// 同じタグを持つ記事を優先し、残りはランダム(ビルドのたび = 毎朝入れ替わる)
const shown = new Set([id, newerPost?.id, olderPost?.id]);
const recommended = allPosts
    .filter((post) => !shown.has(post.id))
    .map((post) => ({
        post,
        score: post.data.tags.filter((tag) => tags.includes(tag)).length + Math.random() * 0.9,
    }))
    .sort((a, b) => b.score - a.score)
    .slice(0, 3)
    .map(({ post }) => post);

// --- Xカードの出し分け ---
// summary_large_image は X 側で 2:1 に中央クロップされる。
// このサイトのヒーロー画像は横長とは限らない(縦長のパーツ写真などもある)ので、
// 十分に横長のときだけ大きいカードにして、それ以外は今まで通り小さい正方形にする。
const heroRatio = heroImage ? heroImage.width / heroImage.height : 0;
const cardType = heroRatio >= 1.4 ? "summary_large_image" : "summary";
// 2:1 に切り抜く際も、元画像の縦横どちらも拡大しない。
const heroMaxWidth = heroImage ? Math.min(heroImage.width, heroImage.height * 2) : 0;
const heroWidth = Math.min(720, heroMaxWidth);
const heroWidths = [
    ...ARTICLE_IMAGE_WIDTHS.filter((width) => width <= heroMaxWidth),
    Math.min(1440, heroMaxWidth),
];

---

<Layout title={title} description={description} image={heroImage} {cardType} width="bare">
    <div class="post-page">
        {advent && <Snow />}
        <div class="post-grid">
            <div class="post-rail">
                <div class="rail-sticky">
                    <PostActions variant="rail" {tweetUrl} slug={id} />
                </div>
            </div>

            <div class="post-main">
                <article data-post-article>
                    {
                        heroImage && (
                            <div class="hero-image">
                                <Image
                                    width={heroWidth}
                                    height={heroWidth / 2}
                                    widths={heroWidths}
                                    sizes={ARTICLE_IMAGE_SIZES}
                                    fit="cover"
                                    priority
                                    src={heroImage}
                                    alt={title}
                                />
                            </div>
                        )
                    }
                    <div class="prose">
                        <header class="post-header">
                            {advent && <AdventBadge label={advent} />}
                            <h1>{title}</h1>
                            <p class="post-meta">
                                <FormattedDate date={pubDate} />
                                {
                                    updatedDate && (
                                        <span class="last-updated-on">
                                            (updated <FormattedDate date={updatedDate} />)
                                        </span>
                                    )
                                }
                                <span>{charCount.toLocaleString("ja-JP")} 字</span>
                                <span>約 {readMinutes} 分</span>
                            </p>
                            {
                                tags.length > 0 && (
                                    <ul class="post-tags" aria-label="タグ">
                                        {tags.map((tag) => (
                                            <li>{tag}</li>
                                        ))}
                                    </ul>
                                )
                            }
                            {description && <p class="post-lead">{description}</p>}
                        </header>

                        <slot />
                    </div>
                </article>

                <PostActions variant="row" {tweetUrl} slug={id} />
                <PostPager older={olderPost} newer={newerPost} />
                <p class="post-back">
                    <ViewAll href="/blog" label="All posts" />
                </p>
            </div>

            <aside class="post-side">
                <div class="side-profile">
                    <PostProfile />
                </div>
                <div class="side-sticky">
                    {tocHeadings.length > 0 && <PostToc headings={tocHeadings} />}
                    <PostRecommend posts={recommended} />
                </div>
            </aside>
        </div>
    </div>

    <style>
        /* ======================================================
           1. レイアウト
           ====================================================== */
        .post-page {
            /* カードの面。ライトは白、ダークは背景より一段明るい灰 */
            --card: var(--surface);
            position: relative;
            min-height: 100dvh;
            padding: calc(72px + 1.5rem) 1rem 4rem;
            background: var(--bg-deep);
        }
        :global(html.dark) .post-page {
            --card: var(--bg);
        }

        .post-grid {
            /* 雪より手前に描く。z-index は付けない(付けると、中の目次ドロワーが背景幕の下に潜る) */
            position: relative;
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 2rem;
            max-width: 760px;
            margin: 0 auto;
        }

        .post-main {
            display: flex;
            flex-direction: column;
            gap: 1.75rem;
            min-width: 0;
        }

        article {
            min-width: 0;
            overflow: clip;
            border: 1px solid var(--border);
            border-radius: 20px;
            background: var(--card);
        }

        .post-back {
            display: flex;
            justify-content: center;
            margin: 0;
        }

        .post-rail,
        .side-profile {
            display: none;
        }

        /* 狭い画面では箱をなくして、中の目次(ドロワー)とおすすめをそのまま並べる */
        .post-side,
        .side-sticky {
            display: contents;
        }

        @media (min-width: 1024px) {
            .post-grid {
                grid-template-columns: 3rem minmax(0, 960px) 17rem;
                justify-content: center;
                column-gap: 1.25rem;
                max-width: none;
            }
            .post-rail,
            .side-profile {
                display: block;
            }
            .rail-sticky {
                position: sticky;
                top: 7rem;
            }
            .post-side {
                display: flex;
                flex-direction: column;
                gap: 1rem;
            }
            .side-sticky {
                position: sticky;
                top: 5.5rem;
                display: flex;
                flex-direction: column;
                gap: 1rem;
            }
        }

        @media (min-width: 1280px) {
            .post-grid {
                grid-template-columns: 3.5rem minmax(0, 960px) 19rem;
                column-gap: 1.75rem;
            }
        }

        /* ヒーロー画像。縦長の画像でも本文を押し下げないよう、横長(2:1)に切り抜く */
        .hero-image img {
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 2 / 1;
            border-radius: 0;
            object-fit: cover;
        }

        /* ======================================================
           2. 記事ヘッダー
           ====================================================== */
        .prose {
            width: 100%;
            padding: 2.25rem clamp(1.1rem, 5vw, 3.5rem) 3rem;
            color: var(--text);
            font-size: 1.0625rem;
            line-height: 1.95;
        }

        .post-header {
            margin: 0 0 2.5rem;
            padding: 0 0 1.5rem;
            border-bottom: 1px solid var(--border);
        }
        .post-header h1 {
            display: block;
            margin: 0 0 0.9rem;
            color: var(--text);
            font-size: clamp(1.6rem, 3.4vw, 2.3rem);
            line-height: 1.4;
            overflow-wrap: anywhere;
        }
        .post-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.3rem 1.1rem;
            margin: 0;
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.8rem;
        }
        .post-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin: 0.9rem 0 0;
            padding: 0;
            list-style: none;
        }
        .post-tags li {
            padding: 0.2rem 0.75rem;
            border: 1px solid var(--border);
            border-radius: 999px;
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.74rem;
            line-height: 1.5;
        }
        .post-lead {
            margin: 1.1rem 0 0;
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.8;
        }

        /* ======================================================
           3. 本文
           ====================================================== */
        .prose :global(p) {
            margin-bottom: 1.5rem;
        }

        /* 見出しの強さ: h2 > h3 > h4 になるように
           h2 … 「青い線が左から伸びる」下線(.visible は下のスクリプトが付ける) */
        .prose :global(h2) {
            position: relative;
            font-size: 1.6rem;
            margin: 3.5rem 0 1.5rem;
            padding-bottom: 0.5rem;
            color: var(--text);
        }
        .prose :global(h2)::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            height: 1px;
            width: 0%;
            background-color: var(--accent);
            transition: width 0.8s ease-out;
        }
        .prose :global(h2.visible)::after {
            width: 100%;
        }
        @media (prefers-reduced-motion: reduce) {
            .prose :global(h2)::after {
                width: 100%;
                transition: none;
            }
        }

        /* h3 … 細い左バーだけ */
        .prose :global(h3) {
            font-size: 1.25rem;
            margin: 2.5rem 0 1rem;
            padding: 0.15rem 0 0.15rem 0.75rem;
            border-left: 3px solid var(--accent);
            color: var(--text);
        }

        /* h4 … mono の小見出し */
        .prose :global(h4) {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-family: var(--font-mono), var(--font-sans);
            font-size: 1rem;
            margin: 2rem 0 0.8rem;
            color: var(--text);
        }
        .prose :global(h4)::before {
            content: "▸";
            color: var(--accent);
        }

        /* 引用 */
        .prose :global(blockquote) {
            margin: 2rem 0;
            padding: 1.2rem 1.5rem;
            background: var(--bg-deep);
            border-left: 3px solid var(--accent);
            border-radius: 0;
            color: var(--text-muted);
        }
        .prose :global(blockquote p:last-child) {
            margin-bottom: 0;
        }

        /* コードブロック */
        .prose :global(pre) {
            padding: 1.5rem;
            border-radius: 10px;
            border: 1px solid var(--border);
            margin: 2rem 0;
            font-family: var(--font-mono);
            font-size: 0.9rem;
            overflow-x: auto;
        }

        /* 画像は影ではなく 1px の枠で区切る */
        .prose :global(.prose-content img) {
            border: 1px solid var(--border);
        }

        /* Markdown の画像直下の _注記_ を ImageCaption と同じ見た目にする */
        .prose :global(.prose-content p > img:first-child + em:last-child),
        .prose :global(.prose-content p:has(> img:only-child) + p > em:only-child) {
            display: block;
            margin-top: 0.6rem;
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.78rem;
            font-style: normal;
            text-align: center;
        }

        /* テーブル: 左寄せ、ヘッダーは mono、狭い画面では横スクロール */
        .prose :global(table) {
            width: 100%;
            border-collapse: collapse;
            margin: 2rem 0;
            font-size: 0.9rem;
            line-height: 1.6;
        }
        .prose :global(th),
        .prose :global(td) {
            border: 1px solid var(--border);
            padding: 0.6rem 0.8rem;
            text-align: left;
            vertical-align: top;
        }
        .prose :global(th) {
            background: var(--elevated);
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }
        .prose :global(tr:nth-child(even) td) {
            background: color-mix(in srgb, var(--text) 3%, transparent);
        }
        @media (max-width: 720px) {
            .prose :global(table) {
                display: block;
                overflow-x: auto;
                /* スクロールバーはコードブロック(global.css)と同じ形。色はテーマに追従 */
                scrollbar-width: thin;
                scrollbar-color: var(--border) transparent;
            }
            .prose :global(table:hover) {
                scrollbar-color: var(--accent) transparent;
            }
            .prose :global(table)::-webkit-scrollbar {
                height: 6px;
            }
            .prose :global(table)::-webkit-scrollbar-thumb {
                background: var(--border);
                border-radius: 10px;
            }
            .prose :global(table:hover)::-webkit-scrollbar-thumb {
                background: var(--accent);
            }
        }

        /* YouTube 埋め込み。狭い画面でもプレイヤーの高さを 200px 以上に保つ。 */
        .prose :global(.youtube-embed) {
            margin: 1.5rem 0;
        }
        .prose :global(.youtube-embed iframe) {
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 16 / 9;
            min-height: 200px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #000;
        }
        .prose :global(.youtube-embed-link) {
            display: block;
            width: fit-content;
            margin: 0.6rem 0 0 auto;
            color: var(--text-muted);
            font-size: 0.78rem;
        }

        /* リンクカード(remark-link-card の出力)の見た目 */
        .prose :global(.rlc-container) {
            display: flex;
            align-items: stretch;
            margin: 1.5rem 0;
            overflow: hidden;
            background: var(--bg-deep);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            text-decoration: none;
            transition:
                border-color 0.18s ease,
                box-shadow 0.35s var(--ease-out);
        }
        .prose :global(.rlc-info) {
            display: flex;
            flex: 1;
            flex-direction: column;
            justify-content: center;
            gap: 0.35rem;
            min-width: 0;
            padding: 0.9rem 1.1rem;
        }
        .prose :global(.rlc-title) {
            font-size: 0.95rem;
            font-weight: 700;
            line-height: 1.5;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            transition: color 0.18s ease;
        }
        .prose :global(.rlc-description) {
            color: var(--text-muted);
            font-size: 0.8rem;
            line-height: 1.5;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }
        .prose :global(.rlc-url-container) {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            min-width: 0;
        }
        .prose :global(.rlc-favicon) {
            width: 14px;
            height: 14px;
            border: none;
            border-radius: 0;
            flex-shrink: 0;
        }
        .prose :global(.rlc-url) {
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.72rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .prose :global(.rlc-image-container) {
            flex-shrink: 0;
            width: 200px;
        }
        .prose :global(.rlc-image) {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            border: none;
            border-radius: 0;
        }
        @media (hover: hover) {
            .prose :global(.rlc-container:hover) {
                border-color: var(--accent);
                box-shadow: var(--shadow-offset);
            }
            .prose :global(.rlc-container:hover .rlc-title) {
                color: var(--accent);
            }
        }
        @media (max-width: 640px) {
            .prose :global(.rlc-image-container) {
                width: 110px;
            }
        }

        /* スマホは本文の枠をなくして横いっぱいに出す。
           背景はページと同じ色で塗っておく(雪が本文の後ろに透けないように) */
        @media (max-width: 720px) {
            .post-page {
                padding: 72px 0 3rem;
            }
            article {
                border: 0;
                border-radius: 0;
                background: var(--bg-deep);
            }
            .prose {
                padding: 1.5rem 1rem 1rem;
            }
            .prose :global(blockquote),
            .prose :global(.rlc-container) {
                background: var(--bg);
            }
            /* 本文以外のカードやボタンには、左右の余白を残す */
            .post-main > :global(:not(article)),
            .post-grid :global(.recommend) {
                margin-inline: 0.75rem;
            }
        }
    </style>

    <Fragment slot="body-end">
        <script>
            // ClientRouter での遷移でも動くよう、astro:page-load ごとに初期化する
            function initBlogPost() {
                const article = document.querySelector<HTMLElement>("[data-post-article]");
                if (!article || article.dataset.initialized) return;
                article.dataset.initialized = "true";

                // === h2: 青い下線を画面に入ったときに伸ばす ===
                const h2Observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("visible");
                                h2Observer.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.5 },
                );
                article
                    .querySelectorAll("h2")
                    .forEach((h2) => h2Observer.observe(h2));

                // === シェア: リンクをコピー / 端末の共有シート ===
                const shareData = {
                    title: document.title,
                    url: location.href,
                };
                document
                    .querySelectorAll<HTMLButtonElement>("[data-share-copy]")
                    .forEach((btn) => {
                        btn.addEventListener("click", async () => {
                            try {
                                await navigator.clipboard.writeText(
                                    shareData.url,
                                );
                                btn.classList.add("is-copied");
                                setTimeout(
                                    () => btn.classList.remove("is-copied"),
                                    1500,
                                );
                            } catch {
                                // クリップボードが使えない環境では何もしない
                            }
                        });
                    });
                if (typeof navigator.share === "function") {
                    document
                        .querySelectorAll<HTMLButtonElement>(
                            "[data-share-native]",
                        )
                        .forEach((btn) => {
                            btn.hidden = false;
                            btn.addEventListener("click", () => {
                                navigator.share(shareData).catch(() => {});
                            });
                        });
                }

                // === 目次 ===
                const toc = document.querySelector<HTMLElement>(".blog-toc");
                const tocLinks = Array.from(
                    document.querySelectorAll<HTMLAnchorElement>(
                        ".blog-toc a[data-toc-slug]",
                    ),
                );
                const headingEls = tocLinks.map((link) =>
                    document.getElementById(link.dataset.tocSlug ?? ""),
                );
                const progressBar = document.getElementById("toc-progress");
                const percentEl = document.getElementById("toc-percent");
                const topLink = document.getElementById("toc-top");

                // ドロワーで開いているとき、項目を押したら閉じる
                const closeDrawer = () => {
                    if (!toc || window.innerWidth >= 1024) return;
                    if (!toc.classList.contains("mobile-open")) return;
                    toc.classList.remove("mobile-open");
                    document
                        .getElementById("toc-toggle")
                        ?.classList.remove("active");
                    document
                        .getElementById("toc-backdrop")
                        ?.classList.remove("visible");
                };
                tocLinks.forEach((link) =>
                    link.addEventListener("click", (e) => {
                        if (
                            e.defaultPrevented ||
                            e.button !== 0 ||
                            e.metaKey ||
                            e.ctrlKey ||
                            e.shiftKey ||
                            e.altKey
                        ) {
                            return;
                        }

                        // アンカー移動だけを滑らかにし、更新時の位置復元には効かせない。
                        // 標準のリンク処理を使うので、URL・履歴もそのまま保つ。
                        const root = document.documentElement;
                        root.style.scrollBehavior = "smooth";
                        // 最初の描画でアンカー移動が始まってから指定を外す。
                        requestAnimationFrame(() =>
                            requestAnimationFrame(() =>
                                root.style.removeProperty("scroll-behavior"),
                            ),
                        );
                        closeDrawer();
                    }),
                );
                topLink?.addEventListener("click", (e) => {
                    e.preventDefault();
                    window.scrollTo({ top: 0, behavior: "smooth" });
                    closeDrawer();
                });

                // === おすすめ: 目次と一緒に画面に入る本数だけ見せる ===
                // 目次はたためるので「一番大きい章を開いたとき」の高さで見積もり、読み進めても本数が変わらないようにする
                const recommend = document.querySelector<HTMLElement>("[data-recommend]");
                const fitRecommend = () => {
                    if (!recommend) return;
                    const items = Array.from(recommend.querySelectorAll<HTMLElement>("[data-recommend-item]"));
                    recommend.hidden = false;
                    items.forEach((item) => (item.hidden = false));
                    if (window.innerWidth < 1024) return;
                    let tocHeight = 0;
                    if (toc) {
                        tocHeight = toc.offsetHeight + 16;
                        if (toc.classList.contains("is-collapsible")) {
                            const subs = Array.from(toc.querySelectorAll<HTMLElement>(".toc-group:not(.orphan) .toc-sub"));
                            const open = subs.reduce((sum, sub) => sum + sub.offsetHeight, 0);
                            const tallest = Math.max(0, ...subs.map((sub) => sub.firstElementChild?.scrollHeight ?? 0));
                            tocHeight += tallest - open;
                        }
                    }
                    // 5.5rem(張り付く位置)と下の余白を引いた残り
                    const room = window.innerHeight - 88 - 16 - tocHeight;
                    for (let i = items.length - 1; i >= 0 && recommend.offsetHeight > room; i--) {
                        items[i].hidden = true;
                    }
                    recommend.hidden = items.every((item) => item.hidden);
                };
                fitRecommend();
                document.fonts?.ready.then(fitRecommend);
                window.addEventListener("resize", fitRecommend, { passive: true });

                // 読み進みの判定は「見出しが画面上端から 120px を越えたか」。
                // 越えた最後の見出しが現在地、それより前は通過済み。
                let ticking = false;
                const update = () => {
                    ticking = false;
                    const line = window.scrollY + 120;
                    let activeIndex = -1;
                    headingEls.forEach((el, i) => {
                        if (!el) return;
                        const top =
                            el.getBoundingClientRect().top + window.scrollY;
                        if (top <= line) activeIndex = i;
                    });
                    tocLinks.forEach((link, i) => {
                        link.classList.toggle("is-passed", i < activeIndex);
                        link.classList.toggle("active", i === activeIndex);
                    });
                    // いま読んでいる章だけを開く
                    const current = tocLinks[activeIndex]?.closest(".toc-group");
                    toc?.querySelectorAll(".toc-group").forEach((group) =>
                        group.classList.toggle("is-open", group === current),
                    );

                    // 読了 %(記事の下端が画面下に来たら 100%)
                    const rect = article.getBoundingClientRect();
                    const total = rect.height - window.innerHeight;
                    const read = Math.min(
                        100,
                        Math.max(
                            0,
                            total > 0 ? (-rect.top / total) * 100 : 100,
                        ),
                    );
                    if (progressBar) progressBar.style.width = `${read}%`;
                    if (percentEl) percentEl.textContent = String(Math.round(read));
                };
                const onScroll = () => {
                    if (ticking) return;
                    ticking = true;
                    requestAnimationFrame(update);
                };
                window.addEventListener("scroll", onScroll, { passive: true });
                window.addEventListener("resize", onScroll, { passive: true });
                document.addEventListener(
                    "astro:before-swap",
                    () => {
                        window.removeEventListener("scroll", onScroll);
                        window.removeEventListener("resize", onScroll);
                        window.removeEventListener("resize", fitRecommend);
                        h2Observer.disconnect();
                    },
                    { once: true },
                );
                update();
            }
            document.addEventListener("astro:page-load", initBlogPost);
            initBlogPost();
        </script>
    </Fragment>
</Layout>
