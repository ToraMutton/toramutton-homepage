---
// 全ページ共通の骨組み。
// <html> / <head> / <body> / ヘッダー / フッターはここ1箇所だけで持つ。
// ページ側は中身（<main> に入る部分）だけを書けばいい。
import type { ImageMetadata } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description: string;
    /** OGP画像。省略するとサイト共通の画像になる */
    image?: ImageMetadata;
    /**
     * 本文エリアの横幅。
     *   default … サイト標準（トップページ・Aboutなど）
     *   narrow  … 読み物向けの900px（Blog一覧 / Works / Advent）
     *   full    … 画面いっぱい（記事ページ。ヒーロー画像を端まで出すため）
     */
    width?: "default" | "narrow" | "full";
}

const { title, description, image, width = "default" } = Astro.props;
---

<html lang="ja">
    <head>
        <BaseHead {title} {description} {image} />
        <slot name="head" />
    </head>
    <body>
        <Header />
        <main class={width}><slot /></main>
        <Footer />
        {/* ページ固有の <script> をここに置くためのスロット */}
        <slot name="body-end" />
    </body>
</html>

<script>
    // 全ページ共通の出現アニメーション。
    // [data-reveal] が画面に入ったら .is-visible を付ける(見た目は global.css)。
    // ClientRouter で遷移しても効くよう astro:page-load ごとに張り直す。
    function initReveal() {
        const targets = document.querySelectorAll<HTMLElement>(
            "[data-reveal]:not(.is-visible)",
        );
        if (targets.length === 0) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            targets.forEach((el) => el.classList.add("is-visible"));
            return;
        }

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    entry.target.classList.add("is-visible");
                    observer.unobserve(entry.target);
                }
            },
            { threshold: 0.08, rootMargin: "0px 0px -6% 0px" },
        );
        targets.forEach((el) => observer.observe(el));
        document.addEventListener(
            "astro:before-swap",
            () => observer.disconnect(),
            { once: true },
        );
    }
    document.addEventListener("astro:page-load", initReveal);
    initReveal();
</script>

<style>
    /* 読み物向け。固定ヘッダーに隠れないよう上に余白を取る */
    main.narrow {
        max-width: var(--max-width-narrow);
        margin: 0 auto;
        padding: 6rem 1.5rem 3rem;
    }

    /* 記事ページ。ヒーロー画像を画面端まで届かせる */
    main.full {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        padding-top: 80px;
    }

    @media (max-width: 720px) {
        main.narrow {
            padding: 5rem 1rem 2rem;
        }
    }
</style>
